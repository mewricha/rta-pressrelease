INSERT INTO "press_release_content" VALUES('PR-2024-0014','๒๗ – ๒๘ มกราคม คัดเลือกทหารออนไลน์รอบสุดท้าย, สมัครใจเป็นทหารพร้อมรับสิทธิประโยชน์จากกองทัพ 
	จากการที่กองทัพบกและเหล่าทัพต่าง ๆ เปิดรับสมัครทหารกองเกินเข้ารับราชการ
กองประจำการโดยวิธีร้องขอ (กรณีพิเศษ) ด้วยระบบออนไลน์ ประจำปี ๒๕๖๗ (ทหารออนไลน์) ตั้งแต่ 
๔ ก.ย.๖๖ ซึ่งในส่วนของกองทัพบกจะปิดรับสมัครใน ๒๘ ม.ค.๖๗ นี้ ปัจจุบันมีชายไทยสมัครแล้วกว่า ๑๘,๘๕๗ คน (ข้อมูล ณ ๒๑ ม.ค.๖๗ เฉพาะในส่วนของ ทบ.) กองทัพบกจึงขอเชิญชวนชายไทยที่เป็นทหารกองเกิน อายุ ๑๘ – ๒๐ ปี หรือ ทหารกองเกิน อายุ ๒๒ – ๒๙ ปี ที่ผ่านการตรวจเลือกแล้วแต่ไม่ถูกเข้า
กองประจำการ ที่มีคุณสมบัติร่างกายสมบูรณ์ดี มีความสูง ๑๔๖ ซม. ขึ้นไป และขนาดรอบอก ๗๖ ซม.ขึ้นไป สมัครเข้ารับราชการเป็นทหารกองประจำการด้วยตนเองได้ง่ายๆ ผ่านทางเว็บไซต์ https://rcm.rta.mi.th หรือแอปพลิเคชัน “ทางรัฐ” ตลอด ๒๔ ชม.
	สำหรับสิทธิประโยชน์ที่จะได้รับจากการเข้ามาเป็นทหารกองประจำการ อาทิเช่น ได้รับเงินเดือน เบี้ยเลี้ยงประจำ เงินเพิ่มการครองชีพชั่วคราว รวมกันไม่เกิน ๑๐,๐๐๐ บาทต่อเดือน, โควตาสอบนักเรียนนายสิบทหารบก, มีสิทธิได้รับการศึกษาต่อในระดับที่สูงขึ้น, รับสวัสดิการในการรักษาพยาบาลได้ที่โรงพยาบาลในสังกัดกองทัพบกโดยไม่มีค่าใช้จ่ายและมีประกันชีวิตในระหว่างประจำการ, ได้รับการฝึกอบรมวิชาชีพในด้านต่าง ๆ รวมถึงการจัดหางานให้ก่อนครบกำหนดปลดออกจากกองประจำการ นอกจากนี้
หากทหารกองประจำการท่านใดประสงค์จะรับราชการต่อภายหลังปลดประจำการเป็นทหารกองหนุนแล้ว
ก็จะได้รับสิทธิและคะแนนเพิ่มพิเศษในการสอบบรรจุเข้ารับราชการต่าง ๆ ที่กองทัพบกเปิดรับ
	สำหรับผู้ที่สมัครแล้วสามารถเข้ารับการคัดเลือกในวันเสาร์และวันอาทิตย์ที่ ๒๗ – ๒๘ ม.ค.๖๗ นี้ ที่มณฑลทหารบกและพื้นที่ที่กำหนด จำนวน ๘๙ แห่งทั่วประเทศ สามารถดูรายละเอียดเพิ่มเติมได้ที่เว็บไซต์ https://rcm.rta.mi.th หรือติดต่อสอบถามได้ที่ กองการสัสดี หน่วยบัญชาการรักษาดินแดน ๐ – ๒๒๒๓ – ๓๒๕๙ (ในวันจันทร์ – ศุกร์ เวลา ๐๘๓๐ น. – ๑๖๓๐ น.)
……………………………………
