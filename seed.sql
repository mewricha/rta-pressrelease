INSERT INTO "press_releases_fts" VALUES('PR-2023-0043','ผบ.ทบ. ต้อนรับเอกอัครราชทูตสหรัฐฯ หารือความร่วมมือทางทหาร COBRA GOLD, STAFFEX และ IMET','ผบ.ทบ. ต้อนรับทูตสหรัฐฯ หารือแผนฝึก COBRA GOLD, STAFFEX และโครงการ IMET ปี 2567','ทบ.ไทย-สหรัฐฯ ดำรงความร่วมมือทางทหาร เสริมสร้างขีดความสามารถกำลังพล 
ผ่านการฝึกศึกษา 
วันนี้ ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ให้การต้อนรับ นายโรเบิร์ต แฟรงค์ โกเด็ก (Robert Frank Godec) เอกอัครราชทูตสหรัฐอเมริกาประจำประเทศไทย
ที่เข้าเยี่ยมคารวะผู้บัญชาการทหารบก เพื่อแนะนำตัว พร้อมแสดงความยินดีกับผู้บัญชาการทหารบก
ในโอกาสเข้ารับตำแหน่งเมื่อตุลาคม ๒๕๖๖ ที่ผ่านมา และได้หารือข้อราชการเกี่ยวกับความร่วมมือ
ในหลายด้าน ณ อาคารพิพิธภัณฑ์กองทัพบกเฉลิมพระเกียรติ ในโอกาสนี้ผู้บัญชาการทหารบกได้กล่าวถึงความร่วมมือในการแลกเปลี่ยนการฝึกศึกษาระหว่างกองทัพบกไทย-สหรัฐฯ อาทิ การฝึกร่วม/ผสม Cobra Gold, การฝึกฝ่ายเสนาธิการ Staff Exercise (STAFFEX), การฝึกผสมรหัส Hanuman Guardian อีกทั้งความร่วมมือในการพัฒนากำลังพลในการศึกษาตามโครงการศึกษาและฝึกอบรมทางการทหารระหว่างประเทศ (International Military Education and Training : IMET) รวมทั้ง
การแลกเปลี่ยนที่นั่งในการศึกษาหลักสูตรวิทยาลัยการทัพบกและเสนาธิการทหารบก ซึ่งเป็นการพัฒนาทักษะความรู้ ขีดความสามารถกำลังพล และแลกเปลี่ยนประสบการณ์ในปฏิบัติการทางทหารร่วมกัน
ทั้งนี้ กองทัพบกไทย-สหรัฐฯ มีความสัมพันธ์อย่างแน่นแฟ้นและต่อเนื่อง ดำรงความร่วมมือ
ผ่านกลไกในทุกระดับ ซึ่งที่ผ่านมาทั้งสองกองทัพได้ให้การสนับสนุนและอำนวยความสะดวกในด้าน
การฝึกศึกษาทางทหารผ่านทางสถานเอกอัคราชทูตสหรัฐอเมริกาประจำประเทศไทยและคณะที่ปรึกษาทางการทหารสหรัฐฯ (JUSMAGTHAI) ซึ่่งส่งผลให้เกิดความร่วมมือในโครงการต่างๆอย่างราบรื่น
อันจะนำไปสู่การพัฒนากองทัพบกไทยและเสริมสร้างความมั่นคงในภูมิภาคต่อไป
.........................................................................
