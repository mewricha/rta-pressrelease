INSERT INTO "press_release_content" VALUES('PR-2023-0044','กองทัพบกโดยกองกำลังผาเมือง บูรณาการร่วมหน่วยงานที่เกี่ยวข้อง รับตัวคนไทยในเมียนมากลับประเทศอีก ๑๑๑ คน
     	วันนี้ (๑๕ ธ.ค. ๖๖) พ.อ. ณฑี ทิมเสน ผู้บังคับหน่วยเฉพาะกิจทัพเจ้าตาก กองกำลัง            ผาเมือง/ประธานคณะกรรมการชายแดนส่วนท้องถิ่นไทย-เมียนมา (TBC) ฝ่ายไทย อ.แม่สาย จ.เชียงราย พร้อมด้วยตรวจคนเข้าเมือง, เจ้าหน้าที่กงสุลประจำจังหวัด และ เจ้าหน้าที่หน่วยประสานงานชายแดนประจำพื้นที่ ๑ เดินทางไปพบปะกับ พันเอก ตู๋ล่า ส่อ วิน โซ ผู้บังคับการกองบังคับการยุทธศาสตร์ท่าขี้เหล็ก และคณะกรรมการชายแดน ส่วนท้องถิ่นเมียนมา-ไทย (TBC) ฝ่ายเมียนมา และตรวจคนเข้าเมืองจังหวัดท่าขี้เหล็ก ณ บริเวณสะพานมิตรภาพข้ามแม่น้ำสาย แห่งที่ ๒  ฝั่งเมียนมา เพื่อประสานรายละเอียดการรับตัวคนไทยที่ได้รับผลกระทบจากการสู้รบกลับภูมิลำเนา จำนวน ๑๑๑ คน (ชาย ๗๕ คน, หญิง ๓๖ คน) พร้อมทำการตรวจสอบอัตลักษณ์ตัวบุคคล และลงนามเอกสารรับตัวคนไทย ระหว่างตรวจคนเข้าเมืองจังหวัดเชียงราย และ ตรวจคนเข้าเมืองจังหวัดท่าขี้เหล็ก หลังจากนั้นจะดำเนินกรรมวิธีรับตัว คนไทย จำนวน ๑๑๑ คน ขึ้นยานพาหนะ ณ บริเวณกลางสะพานข้ามแม่น้ำสายแห่งที่ ๒     
สำหรับการช่วยเหลือคนไทยกลับประเทศในครั้งนี้ นับเป็นครั้งที่ ๔ รวมจำนวนทั้งสิ้น ๑๗๘ คน ซึ่งการดำเนินการดังกล่าวที่ผ่านมา ถือว่าเกิดจากความสัมพันธ์อันดีของกองทัพทั้งสองประเทศ ที่มีความแน่นแฟ้น และให้การช่วยเหลือซึ่งกันและกันตลอดมา โดยเมื่อนำคนไทยทั้ง ๑๑๑ คน เดินทางข้ามมายังฝั่งไทยแล้ว จะเป็นการดำเนินการคัดกรองโรค และคัดแยกบุคคลที่มีหมายจับ ณ อาคารศุลกากร จุดผ่านแดนถาวรสะพานมิตรภาพข้ามแม่น้ำสาย แห่งที่ ๒ อำเภอแม่สาย ก่อนเดินทางไปพื้นที่พักพิงชั่วคราวต่อไป 
.........................................................................
