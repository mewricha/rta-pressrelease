INSERT INTO "press_release_content" VALUES('PR-2023-0041','ระดมทรัพยากร ร่วมแก้ปัญหา PM 2.5 สร้างสภาพแวดล้อมทางอากาศที่ดีให้ประชาชน
      	จากสถานการณ์ฝุ่นละอองขนาดเล็ก PM 2.5 ในขณะนี้ที่มีปริมาณเพิ่มสูงขึ้น และเริ่มส่งผลกระทบต่อสุขภาพประชาชน โดยเฉพาะในพื้นที่กรุงเทพมหานคร ปริมณฑล และ ๑๗ จังหวัดภาคเหนือ เนื่องจากไฟป่า การเผาในพื้นที่เกษตร หมอกควันข้ามแดน การจราจร การขนส่งและโรงงานอุตสาหกรรม รวมถึงสภาพอากาศที่เข้าสู่ฤดูหนาวทําให้อากาศปิด ลมสงบ ฝุ่นละอองไม่ฟุ้งกระจายและสะสมในพื้นที่
จนเกินระดับมาตรฐาน พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ในฐานะคณะกรรมการจัดการปัญหามลพิษทางอากาศเพื่อความยั่งยืนของรัฐบาล ได้มีความห่วงใยในสถานการณ์ดังกล่าว พร้อมขานรับนโยบายในการแก้ไขปัญหาของรัฐบาล ซึ่งกองทัพบกได้ดำเนินการร่วมกับส่วนราชการในพื้นที่มาอย่างต่อเนื่อง สำหรับในปี ๒๕๖๗ รัฐบาลได้มอบหมายให้กระทรวงทรัพยากรธรรมชาติและสิ่งแวดล้อมเป็นหน่วยงานขับเคลื่อนหลัก โดยมีกองทัพบกร่วมบูรณาการการแก้ไขปัญหาผ่านกลไกทุกระดับตั้งแต่ระดับอำนวยการจนถึงระดับปฏิบัติงาน ดังนี้
	คณะอนุกรรมการอำนวยการเพื่อการจัดการปัญหามลพิษทางอากาศ มีผู้ช่วยผู้บัญชาการทหารบก/ผู้ช่วยผู้อำนวยการรักษาความมั่นคงภายในราชอาณาจักร และ ผู้อำนวยการศูนย์ประสานการปฏิบัติที่ ๔ กองอำนวยการรักษาความมั่นคงภายในราชอาณาจักร เป็นอนุกรรมการ มีหน้าที่อำนวยการ และประสานกับส่วนราชการต่างๆ ในการแก้ไขปัญหา
	ศูนย์ปฏิบัติการระดับจังหวัดเพื่อแก้ไขปัญหามลพิษทางอากาศ ในพื้นที่ ๑๗ จังหวัดภาคเหนือมี ผู้บัญชาการมณฑลทหารบก และ รองผู้อำนวยการรักษาความมั่นคงภายในจังหวัด 
(ฝ่ายทหาร) และ ในพื้นที่ ๕ จังหวัดปริมณฑล มี ผู้บัญชาการมณฑลทหารบก และ กองอำนวยการรักษาความมั่นคงภายในราชอาณาจักร จังหวัด เป็นเจ้าหน้าที่ปฏิบัติงานในศูนย์ มีหน้าที่อำนวยการและ
บูรณาการการแก้ไขปัญหา การบริหารจัดการเชื้อเพลิง และการดับไฟ ตลอดจนติดตามรวบรวมข้อมูล เฝ้าระวังและแจ้งเตือนสถานการณ์ในพื้นที่รับผิดชอบ
	ศูนย์ปฏิบัติการดับไฟป่า ในพื้นที่ ๑๗ จังหวัดภาคเหนือ มี แม่ทัพภาคที่ ๓/ผู้อำนวยการรักษาความมั่นคงภายในราชอาณาจักร ภาค ๓ เป็นผู้อำนวยการศูนย์ และเลขาธิการกองอำนวยการรักษาความมั่นคงภายในภาค ๓ เป็นเลขานุการ มีหน้าที่ในการบูรณาการในการควบคุมและดับไฟที่เกิดขึ้นในระดับที่มีความรุนแรง โดยประสานความร่วมมือทั้งกำลังทหาร เจ้าหน้าที่อาสาสมัคร และเครื่องมือของทุกภาคส่วน รวมถึงวางแผนการใช้อากาศยานในการแก้ไขปัญหาที่เกิดขึ้นอีกด้วย
	ล่าสุดเมื่อ  ๖ ธ.ค. ๖๖ ที่ผ่านมา  ผู้ช่วยผู้บัญชาการทหารบก/ ผู้อำนวยการรักษาความมั่นคงภายในราชอาณาจักร และ ผู้อำนวยการศูนย์ประสานการปฏิบัติที่ ๔ กองอำนวยการรักษาความมั่นคงภายในราชอาณาจักร ร่วมประชุมคณะอนุกรรมการอำนวยการ โดยมี ปลัดกระทรวงทรัพยากรธรรมชาติและสิ่งแวดล้อม เป็นประธาน เพื่อติดตามสถานการณ์การแก้ไขปัญหาและรับทราบผลการปฏิบัติของส่วนต่างๆ ตามกรอบการดำเนินการที่ได้กำหนดไว้
	พร้อมกันนี้ผู้บัญชาการทหารบกได้สั่งการให้หน่วยทหารกองทัพบก นำศักยภาพของหน่วยทั้งกำลังพล สิ่งอุปกรณ์และยานพาหนะ สนับสนุนทุกภาคส่วนในการแก้ไขปัญหาอย่างเต็มขีดความสามารถ ซึ่งตลอดระยะเวลาที่ผ่านมา กองทัพบกได้มีการดำเนินการช่วยเหลือประชาชน 
ลดผลกระทบที่เกิดขึ้นจากไฟป่า หมอกควันและฝุ่นละอองในพื้นที่ต่างๆ อย่างต่อเนื่อง ตั้งแต่
การประชาสัมพันธ์สร้างการรับรู้ในการดูแลป้องกันตนเอง ลดการเผาและควบคุมงานด้านการก่อสร้าง, การแจกจ่ายหน้ากากอนามัย, การฉีดพ่นล้างทำความสะอาดพื้นที่สาธารณะ, การสนับสนุนกำลังพลและอากาศยานทางทหารในภารกิจดับไฟป่า ตลอดจนการตรวจสอบและปรนนิบัติบำรุงยานพาหนะของหน่วย เพื่อลดมลภาวะที่เกิดจากเครื่องยนต์ และในปัจจุบันถือเป็นการเตรียมการในระยะเริ่มต้น ขอให้ทุกหน่วยติดตามเฝ้าระวังสถานการณ์อย่างใกล้ชิด
............................................................................
