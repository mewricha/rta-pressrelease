INSERT INTO "press_releases_fts" VALUES('PR-2023-0054','กองทัพบก จัดพิธีประดับยศ ร.ต. นักเรียนนายร้อย รร.จปร. รุ่นใหม่','ทบ. จัดพิธีประดับเครื่องหมายยศ ร.ต. ให้นักเรียนนายร้อย จปร. รุ่นที่สำเร็จการศึกษา','ผบ.ทบ. ประดับยศนักเรียนนายร้อย จปร. ย้ำอุดมการณ์ปกป้องชาติ ศาสน์ กษัตริย์ 
และประชาชน 
	วันนี้ (๒๖ ธ.ค.๖๖) ที่โรงเรียนนายร้อยพระจุลจอมเกล้า ผู้บัญชาการทหารบกพร้อมคณะผู้บังคับบัญชา เข้าร่วมพิธีประดับเครื่องหมายยศร้อยตรีแก่นักเรียนนายร้อยชั้นปีที่ ๕ ที่สำเร็จการศึกษา โดยมี พลโท ไกรภพ  ไชยพันธุ์ ผู้บัญชาการโรงเรียนนายร้อยพระจุลจอมเกล้า และคณะ ให้การต้อนรับ ในโอกาสนี้ ผู้บัญชาการทหารบกได้มอบโอวาทแก่นายทหารใหม่ว่า ขอแสดงความยินดีและชื่นชมเป็นอย่างยิ่งกับความสำเร็จอันน่าภาคภูมิใจของนายทหารสัญญาบัตรใหม่ทุกท่าน ที่ได้มุ่งมั่นตั้งใจศึกษา ฝึกอบรม สั่งสมประสบการณ์ด้วยความพากเพียร เพื่อเตรียมความพร้อมปฏิบัติหน้าที่เพื่อประโยชน์ส่วนรวมด้วยความเสียสละ ขอให้เชื่อมั่นว่าทุกท่านที่ได้รับการหล่อหลอมจากโรงเรียนนายร้อย
พระจุลจอมเกล้านั้น มีคุณสมบัติทางทหารทั้งด้านร่างกายและจิตใจ รวมถึงอุดมการณ์ทางทหารอันแน่วแน่ ตลอดจนมีความเป็นสุภาพบุรุษ เป็นนักรบ นักพัฒนา ที่พร้อมอุทิศเสียสละตนในการพิทักษ์รักษาสถาบันชาติ ศาสนา พระมหากษัตริย์ และปกป้องคุ้มครองช่วยเหลือประชาชน ดังพระราชดำรัสของล้นเกล้าล้นกระหม่อมพระบาทสมเด็จพระจุลจอมเกล้าเจ้าอยู่หัวที่ว่า “ก็นายทหารนั้น จะได้มาจากที่ไหนเล่า ก็ต้องได้มาจากโรงเรียนนายร้อย คือจากพวกเจ้านี้เอง เพราะฉะนั้นเจ้าทั้งหลาย จงอุตสาหะพยายามในการเล่าเรียนวิชาของตนให้ดีเถิด เตรียมการที่จะทำหน้าที่ซึ่งสำคัญที่สุด คือหน้าที่ป้องกันอิสรภาพของบ้านเกิดเมืองนอนของเราเอาไว้ให้จนสุดความสามารถ” นับจากวันนี้ทุกท่านคือกำลังหลักของกองทัพบกที่จะทำหน้าที่ปกป้องคุ้มครองประเทศชาติ ให้มีความสงบสุข และสร้างความรู้สึกมั่นคงปลอดภัย ขอให้ทุกท่านภูมิใจ ดำรงรักษาเกียรติและศักดิ์ศรีอันเกิดจากความสำเร็จในครั้งนี้ พร้อมนำความรู้และประสบการณ์ที่ได้รับจากการศึกษามาเป็นพื้นฐานในการปฏิบัติหน้าที่ ตามแนวทางของการเป็นทหารอาชีพ                ให้ความสำคัญกับการปฏิบัติทุกภารกิจให้เกิดผลสัมฤทธิ์อย่างเป็นรูปธรรม โดยยึดถือกฎ ระเบียบ ความถูกต้อง และความซื่อสัตย์สุจริตเป็นที่ตั้ง หมั่นเพิ่มพูนความรู้และความมีวิสัยทัศน์อย่างต่อเนื่อง สร้างเสริมตนเองให้มีความทันสมัย ก้าวทันวิทยาการ และสถานการณ์ที่เปลี่ยนแปลง ตลอดจนร่วมมือกันพัฒนากองทัพให้มีความเข้มแข็ง มีเอกภาพเป็นที่ยอมรับในการเป็นเสาหลักที่ปกป้องค้ำจุนประเทศชาติ และราชบัลลังก์ ให้มีความมั่นคงตลอดจนเป็นที่พึ่งของประชาชนตลอดไป ก่อนจะร่วมถ่ายภาพกับนายทหารใหม่เป็นที่ระลึก
	ทั้งนี้ กองทัพบกให้ความสำคัญกับการพัฒนาบุคลากรในทุกระดับให้เป็นทหารอาชีพที่มีประสิทธิภาพ เสียสละ ยึดมั่นอุดมการณ์พร้อมที่จะปฏิบัติภารกิจปกป้องประเทศ จากภัยคุกคาม         ทุกรูปแบบและเป็นที่พึ่งของประชาชนในทุกโอกาส 
