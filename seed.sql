INSERT INTO "press_releases_fts" VALUES('PR-2024-0010','ทบ. ร่วมกับ ป.ป.ส. จัดตั้ง ''ศูนย์รักษ์ใจ'' นำร่อง 4 จังหวัด รองรับผู้ป่วยจิตเวชจากยาเสพติด','ทบ. อนุมัติจัดตั้ง ''ศูนย์รักษ์ใจ'' นำร่อง 4 จังหวัด (ค่ายจักรพงษ์ สรรพสิทธิ์ สุรนารี สุรสีห์) รับผู้ป่วยจิตเวชจากยาเสพติด','ทบ. เดินหน้าสนับสนุนรัฐบาลแก้ปัญหายาเสพติด ล่าสุดร่วมกับ ป.ป.ส. เตรียมจัดตั้ง 
“ศูนย์รักษ์ใจ” ในค่ายทหาร นำร่อง ๔ จังหวัด มุ่งบำบัดฟื้นฟูผู้ติดยาเสพติด 
	กองทัพบกได้ดำเนินการสนับสนุนนโยบายของรัฐบาลในการแก้ไขปัญหายาเสพติดมาอย่างต่อเนื่อง ตั้งแต่การสกัดกั้นการลักลอบลำเลียงข้ามผ่านแนวชายแดน โดยกองกำลังป้องกันชายแดน รวมทั้งการประสานงานกับกองอำนวยการรักษาความมั่นคงภายในราชอาณาจักร และหน่วยงานความมั่นคงต่างๆ ในการสกัดกั้นการลำเลียงยาเสพติดพื้นที่ตอนใน พร้อมขยายผลติดตามไปถึงต้นตอของกลุ่มเครือข่าย 
	ขณะเดียวกันด้านการดูแลบำบัดรักษาผู้ติดยาเสพติด กองทัพบกได้จัดตั้งสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติด ในพื้นที่หน่วยทหารทั่วประเทศรวม ๓๓ แห่ง (ศูนย์วิวัฒน์พลเมืองกองทัพบกเดิม) เพื่อดูแลบำบัดรักษา
ในรูปแบบสมัครใจ โดยจะต้องผ่านการคัดกรองจากศูนย์คัดกรองและสถานพยาบาลของกระทรวงสาธารณสุข 
ว่าเห็นสมควรให้เข้ารับการบำบัดต่อยังสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติดฯ ซึ่งตั้งแต่ปี ๒๕๔๖ มีผู้เข้ารับการบำบัดแล้วรวมกว่า ๑๘๒,๐๐๐ ราย
	และตามที่นายกรัฐมนตรี นายเศรษฐา ทวีสิน ได้หารือร่วมกับ นายสุทิน คลังแสง รัฐมนตรี
ว่าการกระทรวงกลาโหม, พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก และคณะกรรมการป้องกันและปราบปรามยาเสพติด เมื่อ ๕ มกราคม ๒๕๖๗ ที่ผ่านมา นายกรัฐมนตรีได้มอบหมายให้เหล่าทัพสนับสนุน ป.ป.ส. และกระทรวงสาธารณสุขโดยการจัดพื้นที่รองรับผู้ป่วยที่มีอาการทางจิตเวชจากยาเสพติดก่อนส่งต่อเข้ารักษาในโรงพยาบาลสังกัด สธ. ตามนโยบายเร่งด่วนของรัฐบาล (Quick Win) 
	เพื่อเป็นการสนับสนุนการแก้ปัญหายาเสพติดของรัฐบาลดังกล่าว ผู้บัญชาการทหารบกได้อนุมัติให้จัดตั้ง “ศูนย์รักษ์ใจ” นำร่องในพื้นที่ค่ายทหาร ๔ จังหวัด ได้แก่ ค่ายจักรพงษ์ จ.ปราจีนบุรี, ค่ายสรรพสิทธิ์ประสงค์ 
จ.อุบลราชธานี, ค่ายสุรนารี จ.นครราชสีมา และค่ายสุรสีห์ จ.กาญจนบุรี รวมทั้งสนับสนุนกำลังพลในการดูแลผู้ป่วยและรักษาความปลอดภัย ซึ่งปัจจุบันกองทัพบกได้สำรวจความพร้อมของพื้นที่ร่วมกับกระทรวงสาธารณสุขแล้ว ๓ แห่ง คือ 
ค่ายจักรพงษ์, ค่ายสุรนารี และค่ายสรรพสิทธิ์ประสงค์ อยู่ระหว่างการดำเนินการ ๑ แห่ง คือ ค่ายสุรสีห์ โดยเมื่อสำรวจพื้นที่เสร็จสิ้นแล้วจึงจะดำเนินการปรับปรุงสถานที่โดยได้รับงบประมาณในการดำเนินงานจาก สำนักงาน ป.ป.ส. 
พร้อมกันนี้กองทัพบกยังได้จัดการอบรมกำลังพลที่เกี่ยวข้อง เพื่อให้การปฏิบัติเป็นไปด้วยความเรียบร้อยปลอดภัย 
ตามมาตรการที่สำนักงาน ป.ป.ส. และ สธ. กำหนด 
	ทั้งนี้ กองทัพบกพร้อมสนับสนุนรัฐบาล เดินหน้าขับเคลื่อนขจัดปัญหายาเสพติดที่ถือเป็น
วาระแห่งชาติในทุกมิติ เพื่อรักษาความสงบเรียบร้อยในสังคม ดูแลพี่น้องประชาชนให้มีความสุขและปลอดภัย
