INSERT INTO "press_releases_fts" VALUES('PR-2024-0008','ทบ. ชี้แจงกรณีคลิปทหารเล่นกับแมว ในทวิตเตอร์ Red Skull ลงทัณฑ์แล้ว','ทบ. ชี้แจงคลิปทหารเล่นกับแมว ''งัว'' ยืนยันแมวไม่ได้รับอันตราย ลงทัณฑ์ทำทัณฑกรรม 7 วัน งดลา 1 เดือน','ทบ. ชี้แจงกรณีคลิปทหารเล่นกับแมวที่ปรากฏบนทวิตเตอร์ X ของ Red Skull
	จากกรณีปรากฎข่าวในทวิตเตอร์ X ของ Red Skull ที่มีภาพทหารเล่นกับแมวในลักษณะอาจก่อให้เกิดอันตราย ทางกองทัพบก ได้มีการตรวจสอบข้อเท็จจริงในเหตุการณ์ดังกล่าว พบว่าเหตุเกิดเมื่อวันที่ ๘ ม.ค. ๖๗ บริเวณพื้นที่หน่วยทหารแห่งหนึ่ง โดยในภาพเป็นทหารกองประจำการกำลังเล่นกับแมว ชื่อ "งัว" ซึ่งเป็นแมวที่อาศัยอยู่ในบริเวณกองร้อยทหาร กำลังพลดังกล่าวให้การว่าด้วยความเอ็นดู และคึกคะนอง จึงหยอกล้อเล่นกับแมว ตามที่ปรากฎในภาพข่าว หลังจากนั้นจึงได้ปล่อยแมวไป โดยไม่ได้รับอันตรายหรือบาดเจ็บแต่อย่างใด 
	ทั้งนี้หน่วยได้ตั้งคณะกรรมการสอบสวนข้อเท็จจริง และได้ลงทัณฑ์ทางวินัยกับกำลังพลดังกล่าว โดยให้ทำทัณฑกรรม ๗ วัน เเละงดการลาพัก เป็นเวลา ๑ เดือน พร้อมทั้งตักเตือนและอบรมกำลังพลในหน่วยทุกนายให้มีความเข้าใจและต้องไม่มีการกระทำเช่นนี้อีก 
