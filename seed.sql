INSERT INTO "press_releases" VALUES('PR-2023-0024','2023-11-07','ทบ. ชี้แจง ยืนยันไม่มีการผลักดัน ผภสม. กลับประเทศ ดูแลตามหลักมนุษยธรรมอย่างต่อเนื่อง',5,'ปกติ','ทบ. ชี้แจงว่าไม่มีการผลักดัน ผู้หนีภัยความไม่สงบชาวเมียนมา (ผภสม.) กลับประเทศ การเดินทางกลับเป็นความสมัครใจ ตั้งแต่ มิ.ย. 66 กลับแล้ว 5,748 คน คงเหลือ 4,187 คน ใน 5 พื้นที่ปลอดภัย','ชี้แจงกรณีถูกกล่าวหาผลักดัน ผภสม. ชาวเมียนมากลับประเทศโดยไม่สมัครใจ','7 พ.ย. 66','661107 จนท.ไทยถูกกดดัน.docx',NULL,'ต้องตรวจ','title ในเอกสาร (''ทบ. พร้อมช่วยเหลือคนไทยในรัฐฉาน...'') ไม่ตรงกับเนื้อหาจริง (ชี้แจงกรณี ผภสม.) — อาจเป็นการ copy header ผิด ตรวจสอบก่อนเผยแพร่ | ชี้แจง-ตอบโต้ข่าว','11533a2e15318419','3-Content/PR-2023-0024.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0025','2023-11-08','ผบ.ทบ. มอบนโยบายด้านการฝึกและศึกษา สอดคล้อง ทันสมัย ปฏิบัติได้จริง',3,'ปกติ','ผบ.ทบ. ประชุมมอบนโยบายการฝึกและศึกษา ปี 2567 ที่ รร.สธ.ทบ. กว่า 300 นาย ครอบคลุมการพัฒนาหลักนิยม, ปรับหลักสูตร, ฝึกผสมเหล่า, ดูแลทหารใหม่ผลัดที่ 2/66 และตั้งศูนย์ติดตามสถานการณ์การฝึก','ประธานประชุมมอบนโยบายการฝึกและศึกษา ประจำปี 2567 แก่ ผบ.หน่วยและฝ่ายเสนาธิการ','8 พ.ย. 66','661108  ผบ.ทบ. มอบนโยบายฝึก รร.สธ.docx',NULL,'ปกติ',NULL,'d1e512e79b6eefd9','3-Content/PR-2023-0025.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
