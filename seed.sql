INSERT INTO "press_releases_fts" VALUES('PR-2024-0006','กองทัพบก เปิดรับสมัครหลักสูตรการบริหารความมั่นคงกองทัพบก ปิดรับ 26 ม.ค.67','ทบ. เปิดรับสมัครข้าราชการ/พนักงานรัฐวิสาหกิจ/นักธุรกิจ อายุ 41-55 ปี จบ ป.ตรี เรียนหลักสูตรบริหารความมั่นคง โรงเรียนเสนาธิการ ทบ. ปิดรับ 26 ม.ค.67','กองทัพบกขอเชิญชวนผู้สนใจเรียนหลักสูตรการบริหารความมั่นคงกองทัพบก
	กองทัพบกขอเชิญชวนผู้ที่สนใจและมีคุณสมบัติดังนี้ ข้าราชการพลเรือนระดับ ๘ หรือเทียบเท่าพนักงานรัฐวิสาหกิจ หรือ นักธุรกิจภาคเอกชนที่ประสบความสำเร็จในการประกอบกิจการ และมีสถานภาพมั่นคง ที่มีอายุระหว่าง ๔๑ – ๕๕ ปี นับถึงปีที่เปิดการฝึกอบรม และสำเร็จการศึกษาปริญญาตรีหรือเทียบเท่าขึ้นไป สมัครเข้ารับการการฝึกอบรมหลักสูตรการบริหารความมั่นคงกองทัพบก ซึ่งเป็นหลักสูตรที่เน้นการปฏิบัติการทางทหาร เพื่อความมั่นคงในทุกๆด้าน มีโอกาสพัฒนาสัมพันธ์ แลกเปลี่ยนประสบการณ์ระดับผู้นำที่สามารถกำหนดนโยบาย การปฏิบัติการทางทหาร
	รับสมัครตั้งแต่วันนี้จนถึงวันที่ ๒๖ ม.ค. ๖๗ สอบถามรายละเอียดเพิ่มเติม 
โทร. ๐๙๘-๘๒๖๖๕๗๔ พ.อ.ณัฐวุฒิ วิเชียรวรรณ โรงเรียนเสนาธิการทหารบก ถนนพระรามที่ ๕ เขตดุสิต กทม.
