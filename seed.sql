INSERT INTO "press_release_content" VALUES('PR-2024-0019','ทบ. มอบรางวัลกำลังพลช่วยประชาชนประสบเหตุ เตรียมจัดกิจกรรมวันทหารผ่านศึก เชิดชู
วีรชนผู้เสียสละ เชิญชวนร่วมงาน “มหัศจรรย์ วันมวยไทย ดังไกลสู่ชาวโลก ประจำปี ๒๕๖๗”  
		วันนี้ (๒๙ ม.ค.๖๗) เวลา ๐๙.๐๐ น. ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก เป็นประธานการประชุมชี้แจงและสั่งการต่อผู้บังคับหน่วยขึ้นตรงกองทัพบก ครั้งที่ 
๔/๒๕๖๗ โดยวาระก่อนการประชุม ผู้บัญชาทหารบกได้มอบใบประกาศชมเชยให้กำลังพลที่ช่วยเหลือประชาชนที่ประสบอุบัติเหตุและเหตุฉุกเฉินต่างๆ ในห้วงเดือนที่ผ่านมา รวม ๒๕ นาย และมอบเงินสวัสดิการค่านมบุตรแรกเกิดให้แก่ทหารใหม่ผลัดที่ ๒/๖๖ ที่มีภรรยาคลอดบุตรในห้วงการฝึก รวม ๑๒๕ นาย ซึ่งผู้บัญชาการทหารบกได้กล่าว
ชื่นชมกำลังพลที่เข้าช่วยเหลือประชาชนที่ประสบเหตุอย่างไม่ลังเล นับเป็นตัวอย่างในการสร้างสรรค์สังคมแห่งความ
มีน้ำใจไมตรี ขณะเดียวกันได้มอบนโยบายให้ผู้บังคับหน่วยทุกระดับได้เชิดชูกำลังพลที่ทำความดีในทุกโอกาสที่รับทราบ เพื่อเป็นขวัญและกำลังใจในการปฏิบัติงาน พร้อมเน้นย้ำเรื่องความปลอดภัยของทั้งผู้ช่วยเหลือและผู้ประสบเหตุเป็นสำคัญ เพื่อป้องกันและลดการสูญเสียที่อาจจะเกิดขึ้น ในส่วนของการมอบเงินค่านมบุตรแรกเกิดทหารใหม่ 
ถือเป็นสวัสดิการทหารกองประจำการ ที่กองทัพบกมีการดูแลมาอย่างต่อเนื่อง โดยใช้เงินจากกองทุนสวัสดิการทหารบก ที่ได้มาจากกิจการสวัสดิการต่างๆ ของกองทัพบก 
		การประชุมในครั้งนี้ หน่วยขึ้นตรงกองทัพบกได้รายงานผลการปฏิบัติงานตามนโยบายของกองทัพบกและรัฐบาลที่สำคัญในห้วงเดือนที่ผ่านมา ได้แก่ การปฏิบัติของกองกำลังป้องกันชายแดนกองทัพบกในการสกัดกั้น
การลักลอบลำเลียงสิ่งผิดกฎหมายทุกรูปแบบ โดยเฉพาะในพื้นที่กองทัพภาคที่ ๒ และกองทัพภาคที่ ๓ ที่มีผลการจับกุมยาเสพติดได้เป็นจำนวนมาก ซึ่งเกิดจากการบูรณาการร่วมกันระหว่าง ป.ป.ส. และ กอ.รมน. ตลอดจนความร่วมมือของประชาชนในพื้นที่, ในส่วนของกองทัพภาคที่ ๑ และกองทัพภาคที่ ๔ ยังได้รายงานผลการจับกุมยางพาราเถื่อนตามแนวชายแดนเป็นจำนวนมาก ซึ่งถือเป็นหนึ่งในการดำเนินงานตามนโยบายสำคัญของรัฐบาล ส่งผลให้ราคายางพาราในปัจจุบันกลับมามีราคาที่ดีขึ้น ซึ่งผู้บัญชาการทหารบกยังได้เน้นย้ำให้กองกำลังป้องกันชายแดน เข้มงวดในการสกัดกั้นการลักลอบนำเข้าสินค้าผิดกฎหมายทุกประเภทร่วมกับหน่วยความมั่นคงในพื้นที่, ในด้านสถานการณ์ไฟป่า หมอกควันและฝุ่นละออง PM 2.5 โดยศูนย์ควบคุมไฟป่า กองทัพภาคที่ ๓ ได้รายงานการปฏิบัติในการติดตามจุดความร้อน รวมถึงการจัดกำลังพลเข้าทำแนวกันไฟ และเข้าดับไฟในพื้นที่ที่เกิดไฟป่าลุกลาม โดยบูรณาการร่วมกับส่วนราชการและภาคประชาชนในพื้นที่ ซึ่งนายกรัฐมนตรีได้ลงพื้นที่ไปตรวจเยี่ยมการดำเนินงานและติดตามสถานการณ์ต่างๆ อย่างใกล้ชิด และในด้านการช่วยเหลือประชาชนที่ประสบอุทกภัยในพื้นที่จังหวัดชายแดนภาคใต้ ซึ่งปัจจุบัน
อยู่ในระยะฟื้นฟูหลังน้ำลด กองทัพภาคที่ ๔ ได้รายงานความคืบหน้าในการเข้าซ่อมแซมบ้านเรือนที่ได้รับความเสียหาย จากการสำรวจ จำนวน ๓,๘๑๑ หลัง ซ่อมเสร็จเรียบร้อยแล้วจำนวน ๒๖๙ หลัง รวมทั้งได้ดูแลมอบ
ถุงยังชีพ เพื่อบรรเทาความเดือดร้อนให้ประชาชนกลับมาดำเนินชีวิตตามปกติโดยเร็ว
	สำหรับการพัฒนาความรู้และทักษะของกำลังพล ผู้บัญชาการทหารบกได้กล่าวถึงโอกาสดี
ที่กองทัพบกได้ลงนามในบันทึกความเข้าใจความร่วมมือทางวิชาการด้านการส่งเสริมการเรียนรู้ตลอดชีวิต เพื่อพัฒนาศักยภาพกำลังพล ร่วมกับกระทรวงการอุดมศึกษา วิทยาศาสตร์ วิจัยและนวัตกรรม (อว.) ตามแพลตฟอร์ม 
Thai MOOC ที่ดำเนินการไปเมื่อ ๒๕ ม.ค. ๖๗ ที่ผ่านมา เพื่อให้กำลังพลทุกระดับได้เข้าไปศึกษาเรียนรู้ พัฒนา
ขีดความสามารถในการปฏิบัติงานผ่านการเรียนการสอนด้วยระบบออนไลน์ได้ทุกที่ทุกเวลา 
	นอกจากนี้ ผู้บัญชาการทหารบกยังได้ให้มีการสนับสนุนยุทโธปกรณ์เพิ่มเติมที่มีความทันสมัยให้กับกองกำลังป้องกันชายแดน อาทิ กล้องบันทึกภาพประจำตัวบุคคล, กล้องตรวจจับความเคลื่อนไหว และอากาศยาน
ไร้คนขับขนาดเล็ก เพื่อนำเทคโนโลยีมาช่วยเสริมการปฏิบัติงานตามแนวชายแดนให้เกิดประสิทธิภาพและลดความตรากตรำของเจ้าหน้าที่ ขณะเดียวกันผู้บัญชาการทหารบกได้มอบนโยบายให้กรมยุทธการทหารบก ดำเนินการปรับปรุงยุทธศาสตร์กองทัพบก ประจำปี ๒๕๖๖ - ๒๕๘๐ ให้มีความสอดคล้องกับภัยคุกคามด้านความมั่นคงของประเทศ และเทคโนโลยีสมัยใหม่ที่มีการเปลี่ยนแปลงอยู่เสมอ รวมถึงให้สอดคล้องกับบริบทความมั่นคงในภูมิภาค อันจะนำไปสู่การพัฒนาโครงสร้างการจัดและพัฒนากำลังของกองทัพบก ให้มีความพร้อม มีศักยภาพและทันสมัย สามารถปฏิบัติงานร่วมกับหน่วยงานอื่นได้อย่างมีประสิทธิภาพ
		ในส่วนของวันทหารผ่านศึก (๓ ก.พ. ๖๗) ซึ่งเป็นวันสำคัญในเดือนกุมภาพันธ์ ผู้บัญชาการทหารบกได้มอบแนวทางให้หน่วยทหารทั่วประเทศจัดกิจกรรมเชิดชูทหารผ่านศึก ด้วยการเข้าเยี่ยมเยียนและเชิญมาร่วมงาน
ในฐานะวีรชนทหารกล้าผู้ทรงเกียรติที่ ให้คนรุ่นหลังได้ร่วมภาคภูมิใจในความเสียสละของท่าน ที่ได้ทำคุณประโยชน์เพื่อประเทศชาติ และเป็นแบบอย่างให้กับทหารรุ่นหลังได้ดำเนินรอยตาม
	นอกจากนี้ยังมีกิจกรรมเนื่องในวันมวยไทย (๖ ก.พ. ๖๗) ที่กองทัพบกร่วมกับกระทรวงวัฒนธรรม (วธ.), การท่องเที่ยวแห่งประเทศไทย (ททท.), การกีฬาแห่งประเทศไทย (กกท.) และ จังหวัดประจวบคีรีขันธ์ จัดกิจกรรม “มหัศจรรย์ วันมวยไทย ดังไกลสู่ชาวโลก ประจำปี ๒๕๖๗” ระหว่างวันที่ ๔ – ๖ กุมภาพันธ์ ณ อุทยานราชภักดิ์ 
จ.ประจวบคีรีขันธ์ จึงขอเชิญชวนประชาชนร่วมกิจกรรมในงานที่ได้จัดขึ้น ได้แก่ กิจกรรมไหว้ครูมวยไทย ประกอบ
การแสดงแสงสีเสียง และการแปรอักษรด้วยโดรน, นิทรรศการประวัติศาสตร์มวยไทย, การแข่งขันชกมวย Thai Fight, การจำหน่ายสินค้าและอาหารพื้นเมืองของจังหวัดประจวบคีรีขันธ์ เป็นต้น สำหรับที่ผ่านมากองทัพบกได้มีการบรรจุมวยไทยเป็นหลักสูตรการฝึกศิลปะป้องกันตัวในหน่วยทหาร เพื่อเป็นการอนุรักษ์และส่งเสริมมวยไทย ศิลปะประจำชาติ ให้ดำรงอยู่คู่สังคมไทย 
