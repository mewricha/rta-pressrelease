INSERT INTO "press_release_content" VALUES('PR-2024-0012','ทบ. จัดงานเลี้ยงเนื่องในวันกองทัพบก สืบสานประวัติศาสตร์ และอุดมการณ์ของกองทัพบก เพื่อชาติ ศาสน์ กษัตริย์และประชาชน
	สืบเนื่องจากวันที่ ๑๘ มกราคมของทุกปีเป็นวันกองทัพไทย และวันกองทัพบก หน่วยทหารทุกหน่วย ได้มีการจัดพิธีสวนสนามและกระทำสัตย์ปฏิญาณตนต่อธงชัยเฉลิมพล 
ทั่วประเทศ และในวันนี้ (๑๙ ม.ค. ๖๗) กองทัพบกได้จัดงานเลี้ยงรับรองเนื่องในวันกองทัพบก 
ณ หอประชุมกองทัพบก ถ.พระราม ๙  โดยได้รับเกียรติจาก พลเอก สุรยุทธ์  จุลานนท์ ประธานองคมนตรี มาเป็นประธานในงาน พร้อมแขกผู้มีเกียรติร่วมงาน อาทิ นายเศรษฐา  ทวีสิน นายกรัฐมนตรี/รัฐมนตรีว่าการกระทรวงการคลัง, นายอนุทิน  ชาญวีรกุล รองนายกรัฐมนตรี/รัฐมนตรีว่าการกระทรวงมหาดไทย, พลเอก ประยุทธ์  จันทร์โอชา องคมนตรี, นายสุทิน  คลังแสง รัฐมนตรีว่าการกระทรวงกลาโหม รวมทั้งผู้ช่วยทูตทหารจากประเทศต่างๆ 
	งานเลี้ยงเนื่องในวันกองทัพบกจัดขึ้นเพื่อเป็นการสืบสานประวัติศาสตร์ และอุดมการณ์ของกองทัพบกที่มีมาอย่างยาวนาน ภายในงานมีการนำเสนอวิวัฒนาการของกองทัพบกตั้งแต่อดีตจนถึงปัจจุบันสู่ความทันสมัยสอดรับกับวิสัยทัศน์ของกองทัพบกในปี พ.ศ. ๒๕๘๐ 
ที่มีเป้าหมายให้กองทัพบก “เป็นกองทัพที่มีศักยภาพ ทันสมัยเป็นที่เชื่อมั่นของประชาชน และเป็นหนึ่งในกองทัพบกชั้นนำของภูมิภาค” ให้กับแขกผู้มีเกียรติได้รับชม และมีส่วนร่วมในความภาคภูมิใจของกองทัพบก ที่ได้ทำหน้าที่เป็นกลไกหลักด้านความมั่นคงของรัฐ ในการปฏิบัติภารกิจเพื่อชาติ ศาสน์ กษัตริย์ และประชาชน โดยในงาน ผู้บัญชาการทหารบก พลเอก เจริญชัย หินเธาว์ 
ได้กล่าวกับแขกผู้มีเกีรยติในงานว่า “...กองทัพบกได้รับการสนับสนุน และการบูรณาการความร่วมมืออย่างดียิ่ง จากทุกภาคส่วนทั้งภาครัฐ ภาคเอกชน เหล่าทัพ ตลอดจนมิตรประเทศที่ทำให้
การดำเนินภารกิจบรรลุผลสัมฤทธิ์อย่างดียิ่งตลอดมา...” 
……………………………….................
