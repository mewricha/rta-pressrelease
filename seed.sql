INSERT INTO "press_release_content" VALUES('PR-2023-0053','ผบ.ทบ. สั่งด่วน เร่งช่วยน้ำท่วมภาคใต้ จากสถานการณ์น้ำท่วมฉับพลันในหลายพื้นที่
	ตามประกาศกรมอุตุนิยมวิทยา ฉบับที่ ๑๔ วันที่ ๒๕ ธ.ค. ๖๖ เกิดฝนตกหนักถึงหนักมากในพื้นที่ ๖ จังหวัดภาคใต้ตอนล่าง ได้แก่ นครศรีธรรมราช, พัทลุง, สงขลา, ปัตตานี, ยะลา และนราธิวาส จนทำให้เกิดน้ำท่วมฉับพลัน และน้ำป่าไหลหลาก รวมทั้งดินโคลนถล่ม ปิดเส้นทางสัญจรในหลายพื้นที่ 
พลเอก เจริญชัย  หินเธาว์ ผู้บัญชาการทหารบกได้รับทราบสถานการณ์และสั่งการเร่งด่วนให้
ศูนย์บรรเทาสาธารณภัยกองทัพภาคที่ ๔ ร่วมกับส่วนราชการในพื้นที่เข้าช่วยเหลือประชาชนโดยใช้ศักยภาพที่มีของหน่วยอย่างเต็มขีดความสามารถ ให้หน่วยทหารในพื้นที่พร้อมรถยนต์บรรทุก (FTS) และเรือท้องแบน ลงพื้นที่อพยพประชาชนผู้สูงอายุ และกลุ่มเปราะบางตลอดจนสิ่งของไปยังพื้นที่ปลอดภัย, มอบสิ่งของเครื่องอุปโภคบริโภค, จัดรถครัวสนามประกอบอาหารแจกจ่ายให้กับประชาชน, อำนวยความสะดวกด้านการเดินทางในพื้นที่ที่ถูกกระแสน้ำตัดขาด, เปิดเส้นทางการจราจรเพื่อระบายทางน้ำ, 
จัดหน่วยแพทย์เคลื่อนที่ตรวจให้บริการสุขภาพพร้อมมอบยาเวชภัณฑ์ ตลอดจนติดตามสถานการณ์น้ำในพื้นที่ตลอด ๒๔ ชั่วโมง พร้อมกำชับกำลังพลทุกนายสวมใส่อุปกรณ์ป้องกันตน ปฏิบัติหน้าที่ด้วยความระมัดระวัง เพื่อความปลอดภัยในการปฏิบัติหน้าที่
	ทั้งนี้ประชาชนที่ประสบเหตุหรือได้รับความเดือนร้อนสามารถติดต่อขอรับการช่วยเหลือผ่านศูนย์บรรเทาสาธารณภัย กองทัพภาคที่ ๔ โทรศัพท์ ๐๗๕-๓๘๓๔๐๕, พื้นที่ ๔ อำเภอของ จ.สงขลา ติดต่อได้ที่ศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๒ โทรศัพท์ ๐๗๔-๖๘๖๖๘๕ และในพื้นที่ 
๓ จังหวัดชายแดนภาคใต้ ติดต่อศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๖ โทรศัพท์ 
๐๗๓-๓๔๐๑๔๑-๕ ต่อ ๔๓๐๑๑ หรือติดต่อหน่วยทหารในพื้นที่ ได้ตลอด ๒๔ ชั่วโมง
.............................................................
