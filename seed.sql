INSERT INTO "press_releases_fts_content" VALUES(60,'PR-2023-0057','กกล.ป้องกันชายแดน ทบ. สรุปผลปราบปรามยาเสพติดปี 2566 จับยาบ้า 351 ล้านเม็ด 1,416 ครั้ง','สรุปผล 1 ปี (2566) กกล.ป้องกันชายแดน ทบ. จับยาบ้า 351.5 ล้านเม็ด ผู้กระทำผิด 1,955 คน สกัดกั้นผิดกม.เข้าเมือง 14,362 คน','กองกำลังป้องกันชายแดนกองทัพบกแถลง ๑ ปี จับยาบ้ากว่า ๓๕๐ ล้านเม็ด, สกัดลักลอบเข้าเมืองกว่า ๑๔,๐๐๐ คน พร้อมมุ่งมั่นสกัดกั้นสิ่งผิดกฎหมายทุกรูปแบบ
	การสกัดกั้นสิ่งผิดกฎหมายในทุกรูปแบบเป็นหนึ่งในนโยบายที่กองทัพบกให้ความสำคัญซึ่ง 
พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ได้กำชับให้กองกำลังป้องกันชายแดนกองทัพบก 
กองกำลังมุ่งมั่นปฏิบัติภารกิจเพื่อรักษาอธิปไตยของชาติและสกัดกั้นสิ่งผิดกฎหมายทุกรูปแบบตามแนวชายแดนทั่วประเทศ
	โดยในปี ๒๕๖๖ ที่ผ่านมา กองกำลังป้องกันชายแดนกองทัพบกมีผลการสกัดกั้นและปราบปรามยาเสพติด ตรวจพบผู้กระทำความผิด รวม ๑,๔๑๖ ครั้ง พบผู้กระทำผิด ๑,๙๕๕ คน ยึดยาบ้า ๓๕๑,๕๖๑,๓๖๙ เม็ด, ไอซ์ ๑๒,๖๗๘ กิโลกรัม, เฮโรอีน ๔๔ กิโลกรัม คีตามีน ๒,๐๙๔ กิโลกรัม 
โดยตรวจยึดได้เป็นจำนวนมากในพื้นที่ภาคเหนือและภาคตะวันออกเฉียงเหนือของประเทศไทย สกัดกั้นผู้ลักลอบเข้าเมืองโดยผิดกฎหมาย รวม ๒,๙๒๔ ครั้ง รวม ๑๔,๓๖๒ คน เป็นชาวกัมพูชา ๕,๓๙๕ คน, เมียนมา ๗,๘๑๓ คน, ลาว ๓๐๓ คน, จีน ๒๓๑ คน, ไทย ๒๒๓ และสัญชาติอื่นๆ ๓๕๘ คน การสกัดกั้นการบุกรุกพื้นที่ป่าไม้และลักลอบตัดไม้ทําลายป่า จับกุมผู้กระทําผิด ๘๓ คน รวม ๑๓๑ ครั้ง ยึดของกลางได้ไม้พะยูง ๑,๒๙๖ ท่อน/แผ่น, ไม้สัก ๗๖๑ ท่อน/แผ่น, ไม้ประดู่ ๖,๑๕๘ ท่อน/แผ่น นอกจากนี้กองทัพบกให้ความสำคัญกับการสกัดกั้นการกระทำผิดพระราชบัญญัติศุลกากร โดยตลอดปี ๒๕๖๖ 
ได้ตรวจพบการกระทําผิด ๒๐๕ ครั้ง กระทำผิด ๑๕๔ ราย พบการลักลอบนำเข้า-ส่งออก กระเทียม ๒,๐๒๘ กิโลกรัม, ยาพารา ๓๑,๘๕๐ กิโลกรัม, บุหรี่ ๑๐๑,๔๙๙ ซอง รวมทั้งผลผลิตทางการเกษตรหลายประเภท, เนื้อสัตว์แช่แข็ง, น้ำมันปรุงอาหาร และน้ำมันเชื้อเพลิงจำนวนมาก (ข้อมูล ณ วันที่ ๒๕ ธันวาคม ๒๕๖๖)
	ทั้งนี้ กองทัพบกยังคงมุ่งมั่นในการปกป้องอธิปไตย พร้อมร่วมมือกับส่วนราชการต่างๆ เพื่อความสงบสุขและปลอดภัยของประชาชนในพื้นที่ชายแดนอย่างยั่งยืน
