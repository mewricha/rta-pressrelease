INSERT INTO "press_releases_fts" VALUES('PR-2024-0015','ทบ. ชี้แจงเกณฑ์ส่วนสูง 146 ซม. สมัครทหารกองประจำการ เป็นไปตามกฎกระทรวง พ.ศ.2516','ทบ. ชี้แจงเกณฑ์ส่วนสูง 146 ซม. และรอบอก 76 ซม. ตามกฎกระทรวงฉบับที่ 37 (2516) สมัครได้ถึง 28 ม.ค.67','กองทัพบกชี้แจงเกณฑ์ส่วนสูงในการสมัครเข้ารับราชการทหารกองประจำการ
	จากกรณีปรากฏข่าวสารในสื่อสังคมออนไลน์เกี่ยวกับคุณสมบัติของชายไทยที่สามารถสมัคร  เข้ารับการคัดเลือกทหารกองเกินเข้ารับราชการทหารกองประจำการ โดยวิธีร้องขอ (กรณีพิเศษ) ด้วยระบบออนไลน์ประจำปี ๒๕๖๗ ของกองทัพบกนั้น ว่าต้องมีความสูงอย่างน้อย ๑๔๖ ซม. ขึ้นไป จนเกิดเป็นประเด็นข้อสงสัยว่าส่วนสูงขนาดดังกล่าวน้อยไปสำหรับการเป็นทหารกองประจำการหรือไม่
	กองทัพบกขอชี้แจงว่า ความสูงดังกล่าวเป็นไปตามกฎกระทรวง ฉบับที่ ๓๗ (พ.ศ.๒๕๑๖) ข้อ ๔       ออกตามความในพระราชบัญญัติรับราชการทหาร พ.ศ.๒๔๙๗ ซึ่งกำหนดว่า บุคคลซึ่งจะเข้ารับราชการทหารกองประจำการนั้น ต้องมีขนาดรอบตัวตั้งแต่ ๗๖ ซม. ขึ้นไป ในเวลาหายใจออก และสูงตั้งแต่ ๑๔๖ ซม. ขึ้นไป 
	อย่างไรก็ตาม กองทัพบกให้ความสำคัญในการเปิดโอกาสให้ชายไทยที่สมัครใจเข้าเป็นทหารกองประจำการ ซึ่งถือเป็นกำลังสำคัญของกองทัพ ด้วยการพัฒนาระบบการฝึกให้เหมาะสม ทันสมัย และสอดคล้องกับสภาพร่างกายของกำลังพลแต่ละคน เสริมสร้างศักยภาพเพื่อให้พร้อมปฏิบัติภารกิจตามสภาพแวดล้อมและบริบทของสังคมต่อไป ทั้งนี้ ผู้ที่สนใจยังคงสามารถสมัครเป็นทหารกองประจำการด้วยระบบออนไลน์ได้จนถึง ๒๘ ม.ค.๖๗ ผ่านทางเว็บไซต์ https://rcm.rta.mi.th ตลอด ๒๔ ชั่วโมง 
