INSERT INTO "press_releases_fts_content" VALUES(63,'PR-2024-0003','ทบ. ชี้แจงกรณี ทภ.3 เสนอเลื่อนฐานะนายทหารประทวนเป็นสัญญาบัตรกรณีพิเศษ','ทบ. ชี้แจงระเบียบเลื่อนยศนายทหารประทวนเป็นสัญญาบัตร 2 แบบ ยืนยันกรณี ทภ.3 ยังไม่อนุมัติ ต้องตรวจสอบคุณสมบัติก่อน','ทบ. ชี้แจงกรณี ทภ.๓ มีหนังสือขอให้ ทบ.พิจารณาเลื่อนฐานะนายทหารประทวนเป็นนายทหารสัญญาบัตร
	จากกรณีประเด็นข่าวสารที่ปรากฏในเพจเฟซบุ๊ค “Survive – สายไหมต้องรอด” ว่ามีหนังสือราชการจากกองทัพภาคที่ ๓ เสนอเรื่อง ขออนุมัติเลื่อนฐานะนายทหารประทวนเป็นนายทหารสัญญาบัตรเป็นกรณีพิเศษนั้น 
	กองทัพบกขอชี้แจงเกี่ยวกับระเบียบการเลื่อนฐานะของนายทหารประทวนเป็นนายทหารสัญญาบัตรว่า โดยปกติสามารถทำได้ใน ๒ กรณี กล่าวคือ กรณีแรก แบบไม่ใช้คุณวุฒิ เป็นการที่นายทหารประทวนครองยศถึงระยะเวลาและมีคุณสมบัติตามระเบียบและหลักเกณฑ์ที่จะสามารถเลื่อนฐานะเป็นนายทหารสัญญาบัตรได้ และกรณีที่สอง แบบใช้คุณวุฒิ นายทหารประทวนจะต้องมีคุณวุฒิการศึกษาในระดับปริญญาตรีและมีคุณสมบัติที่สามารถจะสมัครเข้าสอบเป็นนายทหารสัญญาบัตรได้ ซึ่งดำเนินการจัดสอบโดยกรมยุทธศึกษาทหารบก อย่างไรก็ตาม สำหรับกำลังพลที่เป็นนายทหารประทวนซึ่งมีความสามารถพิเศษ มีผลงานเชิงประจักษ์เป็นที่ยอมรับ หรือมีเกียรติคุณ ประกอบคุณงามความดี มีความรู้ความสามารถ สร้างชื่อเสียงให้กับประเทศชาติ กองทัพบกก็อาจจะพิจารณาให้เลื่อนฐานะเป็นนายทหารสัญญาบัตรได้เป็นกรณีพิเศษเฉพาะราย ซึ่งในส่วนของกรณีกองทัพภาคที่ ๓ ตามที่ปรากฏเป็นข่าวนั้น กองทัพบกต้องมีการตรวจสอบหลักฐานและคุณสมบัติของกำลังพลดังกล่าวก่อนว่าเป็นไปตามหลักเกณฑ์หรือไม่ ซึ่งปัจจุบันยังไม่ได้มีการอนุมัติให้เลื่อนยศแต่อย่างใด   
