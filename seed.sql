INSERT INTO "press_releases_fts" VALUES('PR-2024-0009','ผบ.ทบ. ลงพื้นที่ จชต. เยี่ยมค่ายสิรินธร ปัตตานี และค่ายกรมหลวงนราธิวาส มอบของขวัญปีใหม่และติดตามช่วยน้ำท่วม','ผบ.ทบ. ลงพื้นที่ จชต. มอบของขวัญปีใหม่กำลังพล เยี่ยมค่ายสิรินธร ปัตตานี-ค่ายกรมหลวงนราธิวาส และติดตามช่วยซ่อมบ้าน 3,250 หลัง','ผบ.ทบ. ลงพื้นที่ จชต. เยี่ยมกำลังพลมอบของขวัญปีใหม่ เร่งฟื้นฟูพื้นที่ ช่วยเหลือประชาชน
หลังน้ำท่วมคลี่คลาย
วันนี้ (๑๐ ม.ค. ๖๗) เวลา ๑๐.๐๐ น. พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก/
รองผู้อำนวยการรักษาความมั่นคงภายในราชอาณาจักร นำคณะผู้บังคับบัญชา เดินทางลงพื้นที่ค่ายสิรินธร จ.ปัตตานี เพื่อตรวจเยี่ยมให้กำลังใจ มอบของขวัญอวยพรปีใหม่ ซึ่งเป็นเสื้อคอมแบตเชิ้ตแบบมาตรฐาน ให้กำลังพลได้สวมใส่เพื่อความคล่องตัวในการปฏิบัติภารกิจ และประชุมติดตามการปฏิบัติงานของหน่วยในพื้นที่ที่มีการบูรณาการร่วมกันหลายภาคส่วน ได้แก่ กองอำนวยการรักษาความมั่นคงภายในภาค ๔, กองอำนวยการรักษาความมั่นคงภายในภาค ๔ ส่วนหน้า, กองกำลังตำรวจ และกองบังคับการควบคุมกองอาสารักษาดินแดน ซึ่งตลอดระยะเวลา ๑ ปีที่ผ่านมา หน่วยในพื้นที่ได้มุ่งมั่นตั้งใจปฏิบัติทุกภารกิจที่ได้รับมอบ โดยเฉพาะเหตุอุทกภัยที่เกิดขึ้นเมื่อปลายปี ๒๕๖๖ ส่งผลให้ประชาชนในพื้นที่ได้รับความเดือดร้อน ซึ่งผู้บัญชาการทหารบกได้มีความห่วงใยและติดตามสถานการณ์มาอย่างต่อเนื่อง จึงได้ถือโอกาสในครั้งนี้ รับฟังบรรยายสรุปความคืบหน้าการดำเนินการช่วยเหลือประชาชน ซึ่งปัจจุบันอยู่ในระยะฟื้นฟู หน่วยทหารได้ร่วมทำความสะอาดแหล่งชุมชน ศาสนสถานที่สำคัญต่างๆ รวมทั้งได้สำรวจบ้านเรือนที่ได้รับความเสียหาย เพื่อดำเนินการแก้ไขตามนโยบายรัฐบาล โดยปัจจุบันในพื้นที่จังหวัดชายแดนใต้ (ยอด ณ ๙ ม.ค. ๖๗) มีทั้งสิ้น ๓,๒๕๐ หลังคาเรือน ดำเนินการไปแล้ว ๒๓๒ หลังคาเรือน และระหว่างดำเนินการ ๓๓ หลังคาเรือน ซึ่งจะเร่งดำเนินการให้แล้วเสร็จ เพื่อให้ประชาชนกลับมาดำเนินชีวิตตามปกติสุขได้โดยเร็ว
	จากนั้นผู้บัญชาการทหารบกและคณะได้เดินทางไปยังค่ายกรมหลวงนราธิวาสราชนครินทร์ 
ต.มะรือโบออก อ.เจาะไอร้อง จ.นราธิวาส เพื่อเยี่ยมพบปะกำลังพล หน่วยเฉพาะกิจกรมทหารพรานที่ ๔๘ และ
กองพันทหารราบที่ ๓ กรมทหารราบที่ ๑๕๑ ซึ่งเป็นหน่วยรับผิดชอบดูแลในพื้นที่ พร้อมทั้งได้มอบถุงยังชีพให้กำลังพลและครอบครัวที่ได้รับผลกระทบจากอุทกภัย ตลอดจนลงพื้นที่วัดปิเหล็ง ต.มะรือโบออก อ.เจาะไอร้อง จ.นราธิวาส เพื่อเยี่ยมเยียนให้กำลังใจและส่งมอบปัจจัยขั้นพื้นฐานในการดำรงชีพ ร่วมดูแลบรรเทาความเดือดร้อนให้ประชาชน
ในเบื้องต้น รวม ๑๐๐ ครัวเรือน และได้ยืนยันในฐานะผู้บัญชาการทหารบก ว่ากองทัพบกพร้อมอยู่เคียงข้าง 
และเดินหน้าช่วยเหลืออย่างสุดกำลังความสามารถ เพื่อก้าวข้ามผ่านวิกฤตครั้งนี้ไปด้วยกัน จากนั้นคณะได้เดินทางกลับมายังพื้นที่ จ.ปัตตานี เพื่อตรวจเยี่ยมติดตามการปฏิบัติงานของหน่วยเฉพาะกิจกรมทหารพรานที่ ๔๔ ต.ปะเสยะวอ อ.สายบุรี พร้อมมอบของขวัญอวยพรปีใหม่และให้กำลังใจกำลังพล ก่อนเสร็จสิ้นการปฏิบัติภารกิจในวันนี้
	สำหรับการตรวจเยี่ยมในครั้งนี้ มีกำหนดการในพื้นที่ ๒ วัน เนื่องจากผู้บัญชาการทหารบกมีความตั้งใจ
ที่จะได้พบปะมอบนโยบาย เน้นย้ำมาตรการด้านความมั่นคง และรับฟังปัญหาข้อขัดข้องต่างๆ จากผู้ใต้บังคับบัญชา
ทุกหน่วยในการเดินทางลงพื้นที่อย่างใกล้ชิด ตลอดจนได้นำนโยบายของรัฐบาล โดยเฉพาะแผนงานเร่งด่วนต่างๆ ขับเคลื่อนสู่ระดับปฏิบัติในพื้นที่ เพื่อดูแลพัฒนาคุณภาพชีวิตพี่น้องประชาชนภายใต้สังคมพหุวัฒนธรรม
