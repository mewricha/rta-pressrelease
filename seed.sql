INSERT INTO "press_releases_fts_content" VALUES(19,'PR-2023-0016','ทบ. ร่วมมือ กทม. บูรณาการช่วยประชาชน พร้อมจัดกิจกรรมเฉลิมพระเกียรติ 72 พรรษา ตลอดปี 2567','ผู้แทน ทบ. ประชุมกับ ผว.กทม. บูรณาการช่วยเหลือประชาชน รับมืออุทกภัยและ PM2.5 พร้อมร่วมจัดกิจกรรมเฉลิมพระเกียรติ 72 พรรษา ตลอดปี 2567','ทบ. ร่วมมือ กทม. บูรณาการช่วยประชาชน พร้อมจัดกิจกรรมเฉลิมพระเกียรติ ๗๒ พรรษา ตลอดปี ๒๕๖๗
วันนี้ (๒๔ ต.ค.๖๖) เวลา ๑๕.๐๐ น. ผู้บัญชาการทหารบก มอบหมายให้ พลโท อานุภาพ 
ศิริมณฑล เจ้ากรมกิจการพลเรือนทหารบก เป็นผู้แทนกองทัพบก พร้อมด้วย พลตรี ณัฐเดช จันทรางศุ รองแม่ทัพน้อยที่ ๑ ผู้แทนกองทัพภาคที่ ๑ และ พลตรี นรินทรักษ์ เชษฐศิริ รองผู้อำนวยการรักษา
ความมั่นคงภายในกรุงเทพมหานคร (ฝ่ายทหาร) ร่วมประชุมหารือกับ นายชัชชาติ สิทธิพันธุ์ ผู้ว่าราชการกรุงเทพมหานคร และคณะทำงาน เพื่อบูรณาการร่วมกันในการช่วยเหลือและพัฒนาคุณภาพชีวิต
ของประชาชน ในพื้นที่กรุงเทพมหานคร ณ ห้องอัมรินทร์ ศาลาว่าการกรุงเทพมหานคร
สำหรับการประชุมในครั้งนี้ กองทัพบกได้นำข้อห่วงใยและนโยบายในการช่วยเหลือประชาชนของผู้บัญชาการทหารบก รวมถึงช่องทางในการติดต่อประสานงานทั้งระดับผู้บริหาร และหน่วยปฏิบัติงาน ที่กองทัพบกได้แบ่งมอบพื้นที่ในการช่วยเหลือประชาชนทั้ง ๕๐ เขต ชี้แจงให้กับ
ผู้ว่าราชการกรุงเทพมหานคร และคณะทำงานได้รับทราบ อีกทั้งยังได้หารือในการบูรณาการ เตรียมรับมือกับปัญหาอุทกภัยและปัญหาฝุ่นละอองขนาดเล็ก PM 2.5 พร้อมร่วมจัดกิจกรรมเฉลิมพระเกียรติพระบาทสมเด็จพระเจ้าอยู่หัว เนื่องในโอกาสมหามงคลเฉลิมพระชนมพรรษา ๖ รอบ ๗๒ พรรษา ตลอดปี ๒๕๖๗ อย่างสมพระเกียรติ
ซึ่งที่ผ่านมา กองทัพบก ได้สนับสนุนกรุงเทพมหานครในหลายรูปแบบ อาทิ การมอบหมายให้ศูนย์บรรเทาสาธารณภัยติดตามสถานการณ์และเตรียมการช่วยเหลือประชาชนตลอด ๒๔ ชั่วโมง, การใช้ยุทโธปกรณ์ของทหารช่างขุดลอกคูคลอง กำจัดขยะและสิ่งปฏิกูลเพื่อเปิดทางระบายน้ำ, การกรอกกระสอบทราย ทำแนวกันน้ำ ตลอดจนร่วมจัดกิจกรรมจิตอาสาพัฒนาพื้นที่ เพื่อสร้างสภาพแวดล้อมที่ดีลดปัญหามลพิษต่างๆ
ทั้งนี้การบูรณาการความร่วมมือระหว่างสองหน่วยงานจะช่วยเพิ่มประสิทธิภาพในการช่วยเหลือและพัฒนาคุณภาพชีวิตของประชาชน ซึ่งเป็นสิ่งที่กองทัพบกให้ความสำคัญอย่างเสมอมา
