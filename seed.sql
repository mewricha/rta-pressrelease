INSERT INTO "press_releases_fts" VALUES('PR-2024-0013','ทบ. ให้ความร่วมมือตำรวจ คดีเด็กปั้มถูกยิง จ.นครพนม ผู้ต้องสงสัยเป็นนายทหารประทวน','ทภ.2 ให้ความร่วมมือตำรวจ คดีเด็กปั้ม 2 รายถูกยิง อ.เมือง นครพนม 29 ธ.ค.66 ผู้ต้องสงสัยเป็นนายทหารประทวน ตั้ง กก.สอบสวนวินัยแล้ว','ทบ. พร้อมให้ความร่วมมือตำรวจ กรณีเด็กปั้มถูกยิงในปั้มน้ำมัน จ.นครพนม
	จากเหตุการณ์ที่เจ้าหน้าที่ตำรวจติดตามสืบสวนกรณี เด็กปั้ม ๒ รายถูกยิงในปั้มน้ำมัน อ.เมือง จ.นครพนม เมื่อ ๒๙ ธันวาคม ๒๕๖๖ ซึ่งต่อมาเมื่อ ๑๗ มกราคม ๒๕๖๗ เจ้าหน้าที่ตำรวจได้ตรวจสอบกล้องวงจรปิดพบรถยนต์ที่เข้าข่ายอาจเกี่ยวข้องการกระทำผิด อยู่ในบ้านพักในค่ายทหารจึงได้ขอออกหมายค้น และเข้าตรวจค้นบ้านพักของผู้ต้องสงสัยเป็นนายทหารประทวนสังกัดกองทัพบก โดยพบรถยนต์ต้องสงสัย และอาวุธปืนเล็กยาวไม่มีทะเบียนพร้อมเครื่องกระสุนเจ้าหน้าที่ตำรวจ
จึงได้แจ้งข้อกล่าวหาและควบคุมตัวเพื่อทำการสอบสวนเพิ่มเติม 
	จากผลการสอบสวนขั้นต้นผู้ต้องสงสัยปฏิเสธในทุกข้อกล่าวหา โดยปัจจุบัน
ผู้ต้องสงสัยถูกฝากขังในความผิดฐานครอบครองอาวุธสงคราม ทั้งนี้กองทัพภาคที่ ๒ ได้มอบให้หน่วยต้นสังกัดดำเนินการตั้งคณะกรรมการสอบสวนเพื่อลงทัณฑ์​ตามวินัยทหาร และให้การสนับสนุน
การปฏิบัติของ จนท.ตร.สภ.เมืองนครพนม ในการสืบสวนสอบสวนตามกระบวนยุติธรรมต่อไป
………………………………….................
