INSERT INTO "press_releases_fts_content" VALUES(28,'PR-2023-0025','ผบ.ทบ. มอบนโยบายด้านการฝึกและศึกษา สอดคล้อง ทันสมัย ปฏิบัติได้จริง','ผบ.ทบ. ประชุมมอบนโยบายการฝึกและศึกษา ปี 2567 ที่ รร.สธ.ทบ. กว่า 300 นาย ครอบคลุมการพัฒนาหลักนิยม, ปรับหลักสูตร, ฝึกผสมเหล่า, ดูแลทหารใหม่ผลัดที่ 2/66 และตั้งศูนย์ติดตามสถานการณ์การฝึก','ผบ.ทบ. มอบนโยบายด้านการฝึกและศึกษา “สอดคล้อง ทันสมัย ปฏิบัติได้จริง”
วันนี้ (๘ พ.ย. ๖๖) เวลา ๐๙.๐๐ น. ที่โรงเรียนเสนาธิการทหารบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก เป็นประธานการประชุมชี้แจงและมอบนโยบายการฝึกและศึกษาแก่ผู้บังคับหน่วยและ
ฝ่ายเสนาธิการของกองทัพบก ประจำปี ๒๕๖๗ โดยมี พลโท ณรงค์ สวนแก้ว เจ้ากรมยุทธศึกษาทหารบก พร้อมด้วยผู้บังคับบัญชาของกรมยุทธศึกษาทหารบก ฝ่ายเสนาธิการ และผู้บังคับหน่วยที่เกี่ยวข้องกับการฝึกและศึกษาถึงระดับผู้บังคับการกรม รวมกว่า ๓๐๐ นาย ร่วมรับฟังนโยบาย
โดยเจ้ากรมยุทธศึกษาทหารบก พร้อมผู้อำนวยการสำนักกรมยุทธศึกษาทหารบก ได้ชี้แจงนโยบาย ซึ่งได้ยึดถือตามแผนงานนโยบายการฝึกของกองทัพบก ปี ๒๕๖๖ - ๒๕๗๐ โดยในปีงบประมาณ ๒๕๖๗  ผู้บัญชาการทหารบกได้มอบแนวทางในการพัฒนาในหลากหลายด้านประกอบด้วย การพัฒนาหลักนิยมและยุทธศาสตร์ ในด้านการยุทธ์ผสมเหล่า และการปรับเปลี่ยนกระบวนการแสวงข้อตกลงใจทางทหารให้มีความทันสมัยตามหลักสากล, ส่วนด้านการศึกษา มีการปรับปรุงพัฒนาหลักสูตรของวิทยาลัยการทัพบก, โรงเรียนเสนาธิการทหารบก และโรงเรียนเหล่า
สายวิทยาการ ให้สอดคล้องกันในทุกระดับ และในส่วนด้านการฝึก เน้นการฝึกรบผสมเหล่าในระดับกองพัน โดยต้องจัดเจ้าหน้าที่สังเกตุการณ์ในการให้คำแนะนำและประเมินผลในทุกการฝึก และในด้านการฝึกทหารใหม่ ให้มีมาตรการการฝึกที่รอบคอบ รัดกุม เน้นความปลอดภัยและมีประสิทธิภาพ โดยกรมยุทธศึกษาทหารบกได้จัดตั้งศูนย์ติดตามสถานการณ์การฝึกทหารใหม่ ผลัดที่ ๒/๖๖ ขึ้น เพื่อกำกับดูแลการฝึกทหารใหม่ในภาพรวมทั้งกองทัพบก ให้เป็นไปตามนโยบาย
โอกาสนี้ ผู้บัญชาการทหารบกได้ขอบคุณทุกหน่วยที่เห็นถึงความสำคัญในงานด้านการฝึกและศึกษาของกองทัพบก พร้อมมอบแนวทางให้ทุกหน่วยทำงานอย่างสอดคล้องกันทั้ง ๓ ด้าน ได้แก่ การพัฒนาหลักนิยม การศึกษา และการฝึก โดยให้มีการพัฒนาปรับเปลี่ยนให้ทันสมัย สอดคล้องกับสภาพปัจจุบัน ทั้งนี้ต้องสามารถนำมาปฏิบัติได้จริง ในการปฏิบัติภารกิจของกองทัพบก ผู้บัญชาการทหารบกยังได้เน้นย้ำในเรื่องของการฝึกทหารใหม่ ให้ทุกหน่วยกำกับดูแลให้เป็นไปอย่างปลอดภัยตามมาตรการที่กองทัพบกกำหนด
ทั้งนี้หลังการมอบนโยบาย ผู้บัญชาการทหารบกได้ชมนิทรรศการด้านหลักนิยม การฝึกและการศึกษาของกองทัพบก พร้อมจัดให้มีการบรรยายให้ความรู้เพิ่มเติมกับผู้บังคับหน่วย ในเรื่องที่สำคัญต่างๆ ประกอบด้วย การดูแลและควบคุมสิ่งอุปกรณ์ทางทหาร โดยกรมสรรพาวุธทหารบก, การป้องกันและลดการสูญเสียจากการฝึก โดยกรมแพทย์ทหารบก และข้อกฎหมายที่สำคัญเกี่ยวกับการปฏิบัติตามหลักสิทธิมนุษยชน 
โดยสำนักงานพระธรรมนูญทหารบก เพื่อให้ผู้บังคับหน่วยมีความเข้าใจและสามารถปฏิบัติตามนโยบายต่างๆ ของกองทัพบกได้อย่างถูกต้อง
………………………………….................
