INSERT INTO "press_releases_fts" VALUES('PR-2024-0001','ทบ. ระดมซ่อมบ้านเรือนผู้ประสบอุทกภัยภาคใต้อย่างต่อเนื่อง รับนโยบายนายกรัฐมนตรี','หน่วยทหาร ทภ.4 เร่งซ่อมบ้านเรือนผู้ประสบน้ำท่วมภาคใต้ ยะลา ปัตตานี นราธิวาส ตามนโยบายนายกฯ เศรษฐา','ทบ.ระดมช่วยน้ำท่วมภาคใต้อย่างต่อเนื่อง เร่งซ่อมบ้านหลังน้ำลด รับนโยบายนายกรัฐมนตรี
		จากสถานการณ์อุทกภัยที่เกิดขึ้นในพื้นที่ภาคใต้ โดยเฉพาะ ๓ จังหวัดชายแดนภาคใต้ จนทำให้ประชาชนได้รับความเดือดร้อน เส้นทางสัญจรถูกตัดขาด และบ้านเรือนพังเสียหาย ตั้งแต่ ธ.ค.๖๖ ที่ผ่านมา พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก/ผู้อำนวยการศูนย์บรรเทาสาธารณภัยกองทัพบก ได้มีความห่วงใยประชาชนและมอบหมายให้ศูนย์บรรเทาสาธารณภัยกองทัพภาคที่ ๔ พร้อม กอ.รมน.ภาค ๔ ส่วนหน้า นำศักยภาพหน่วยทหารเข้าช่วยเหลือประชาชนอย่างต่อเนื่อง 
	ล่าสุด ผู้บัญชาการทหารบก รับนโยบายเร่งด่วนจากนายกรัฐมนตรี นายเศรษฐา ทวีสิน ที่สั่งการให้ทหารทุกเหล่าทัพ เข้าซ่อมแซมบ้านเรือนให้กับประชาชนผู้ประสบอุทกภัยในพื้นที่ที่สถานการณ์เริ่มคลี่คลาย ซึ่งขณะนี้หน่วยทหารในพื้นที่กองทัพภาคที่ ๔  โดยศูนย์บรรเทาสาธารณภัย กองพลทหารราบที่ ๑๕ ที่รับผิดชอบพื้นที่จังหวัดต่างๆ ได้แก่ กรมทหารราบที่ ๑๕๓ จ.ยะลา, กรมทหารราบที่ ๑๕๒ จ.ปัตตานี และ กรมทหารราบที่ ๑๕๑ จ.นราธิวาส รวมทั้งหน่วยเฉพาะกิจทหารพรานในพื้นที่ อยู่ระหว่างร่วมกับส่วนราชการในการเข้าสำรวจความเสียหายและฟื้นฟูหลังน้ำลด ด้วยการทำความสะอาด, ขนย้ายสิ่งของกลับเข้าที่พัก, มอบถุงยังชีพ ตลอดจนซ่อมแซมบ้านเรือนที่ได้รับความเสียหาย เพื่อให้ประชาชนในพื้นที่ได้กลับมาใช้ชีวิตอย่างปกติได้โดยเร็วที่สุด โดยบูรณาการร่วมกับส่วนราชการในพื้นที่ อาทิ หน่วยทหารพัฒนา,                     หน่วยเฉพาะกิจตำรวจตระเวนชายแดน, สำนักงานป้องกันและบรรเทาสาธารณภัยจังหวัด และส่วนท้องถิ่น ทั้งนี้กองทัพบกพร้อมนำกำลังทหารช่างและยุทโธปกรณ์ของหน่วย เข้าทำการสนับสนุน เร่งซ่อมสร้างคลายความเดือดร้อนให้ประชาชนในทันที
	สำหรับประชาชนที่บ้านเรือนได้รับความเสียหายจากอุทกภัย สามารถติดต่อหน่วยทหารใกล้เคียง หรือโทรศัพท์ผ่านศูนย์บรรเทาสาธารณภัย กองทัพภาคที่ ๔ โทรศัพท์ ๐๗๕-๓๘๓๔๐๕, พื้นที่                 ๔ อำเภอของ จ.สงขลา ติดต่อได้ที่ศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๒ โทรศัพท์ ๐๗๔-๖๘๖๖๘๕ และในพื้นที่ ๓ จังหวัดชายแดนภาคใต้ ติดต่อศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๖ โทรศัพท์ ๐๗๓-๓๔๐๑๔๑-๕ ต่อ ๔๓๐๑๑ ได้ตลอด ๒๔ ชั่วโมง
........................................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๓ มกราคม ๒๕๖๗');
INSERT INTO "press_releases_fts" VALUES('PR-2024-0002','ทบ. เผยผลจุดบริการประชาชน 7 วันปีใหม่ 2567 ผู้ใช้บริการ 7,531 ราย อุบัติเหตุลดลง 6.23%','สรุปผลจุดบริการ ทบ. 83 จุด ช่วงปีใหม่ 2567 ผู้ใช้บริการ 7,531 ราย อุบัติเหตุลดลง 6.23% บาดเจ็บลด 5.33% เสียชีวิตลด 10.41%','ทบ. เผยจุดบริการประชาชนช่วงปีใหม่ได้ผลน่าพอใจ เจ้าหน้าที่ทุกส่วนร่วมดูแลตลอด ๗ วัน พบยอดอุบัติเหตุลดลง ๖.๒๓% บาดเจ็บลดลง ๕.๓๓% และเสียชีวิตลดลง ๑๐.๔๑%		ตามที่ พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก มอบนโยบายให้หน่วยทหารกองทัพบกส่งความสุขให้ประชาชนช่วงเทศกาลส่งท้ายปีเก่าต้อนรับปีใหม่ ๒๕๖๗ ผ่านการดูแลรักษาความปลอดภัยทุกรูปแบบ ตั้งแต่พื้นที่ชั้นนอกที่มีกำลังพล ๗ กองกำลังป้องกันชายแดน จัดผลัดกำลังพลลาดตระเวนป้องปรามสิ่งผิดกฎหมายตลอด ๒๔ ชม. รวมทั้งพื้นที่ชั้นใน ที่ผู้บัญชาการทหารบกได้มีความห่วงใยประชาชนในเรื่องของการเดินทางกลับภูมิลำเนาหรือท่องเที่ยวในสถานที่ต่างๆ ผ่านการมอบหมายให้หน่วยทหารแต่ละพื้นที่ โดยเฉพาะเส้นทางสายหลักหรือที่มีการจราจรคับคั่ง สนับสนุนกำลังพลและยานพาหนะ ร่วมกับส่วนราชการและภาคประชาชนในพื้นที่ จัดตั้งจุดบริการประชาชนทั่วประเทศรวม ๘๓ จุด ตั้งแต่ ๒๙ ธ.ค.๖๖ - ๔ ม.ค.๖๗
	ซึ่งผลการปฏิบัติของจุดบริการกองทัพบกห้วง ๗ วันที่ผ่านมา มีประชาชนเข้าใช้บริการ ๗,๕๓๑ ราย มากที่สุดคือพื้นที่ภาคเหนือ รับผิดชอบโดยกองทัพภาคที่ ๓ และส่วนใหญ่เป็นการแวะพักผ่อน รับประทานเครื่องดื่ม ใช้บริการห้องสุขา รวมถึงการสอบถามเส้นทางในพื้นที่ โดยภาพรวมเป็นที่น่าพอใจ ประชาชนสามารถเข้าถึงจุดบริการได้อย่างสะดวก และกองทัพบกสามารถสนับสนุนศูนย์อำนวยการป้องกันและลดอุบัติเหตุทางถนน กระทรวงมหาดไทย ลดอุบัติเหตุจากปี ๒๕๖๖ ได้ ๖.๒๓%  ผู้บาดเจ็บลดลง ๕.๓๓% และอัตราการเสียชีวิตลดลง ๑๐.๔๑% 
	ทั้งนี้ กองทัพบกขอขอบคุณกำลังพลทุกนาย ตลอดจนครอบครัว รวมถึงภาคีต่างๆ ส่วนราชการในพื้นที่ ที่ได้ร่วมเสียสละช่วงเวลาห้วงวันหยุดยาว ปฏิบัติภารกิจที่ได้รับมอบ ดูแลความปลอดภัยให้ประชาชน ส่งความสุขรับปีใหม่ ๒๕๖๗ พร้อมกันนี้ ผู้บัญชาการทหารบกได้มอบนโยบายให้ผู้บังคับหน่วย บริหารจัดการดูแลสิทธิและสวัสดิการกำลังพลผู้ปฏิบัติงานในห้วงดังกล่าว โดยให้มีการชดเชยห้วงวันลาพักตามเหมาะสม เพื่อสร้างขวัญและกำลังใจให้กับกำลังพลและครอบครัวต่อไป
