INSERT INTO "press_releases_fts_content" VALUES(21,'PR-2023-0018','ผบ.ทบ. เยี่ยมกองกำลังสุรศักดิ์มนตรี ย้ำทหารคือรั้วของชาติ กำชับทุกหน่วยสกัดยาเสพติดให้หยุดที่ชายแดน','ผบ.ทบ. ตรวจเยี่ยม กกล.สุรศักดิ์มนตรี ใน 3 จังหวัด (อุดรธานี บึงกาฬ หนองคาย) ร่วมลาดตระเวนแม่น้ำโขง กำชับสกัดยาเสพติดชายแดน และมอบอุปกรณ์การเรียนให้ศูนย์เด็กเล็ก','ผบ.ทบ. เยี่ยมกองกำลังสุรศักดิ์มนตรี ย้ำทหารคือรั้วของชาติ กำชับทุกหน่วยสกัดยาเสพติดให้หยุดที่ชายแดน
วันนี้ (๒๗ ต.ค.๖๖) พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ลงพื้นที่ตรวจเยี่ยมกองกำลังสุรศักดิ์มนตรี ในพื้นที่ จ.อุดรธานี, บึงกาฬ และหนองคาย โดยมีพลโท อดุลย์ บุญธรรมเจริญ แม่ทัพภาคที่ ๒ และ พลตรี นรธิป โพยนอก ผู้บัญชาการกองกำลังสุรศักดิ์มนตรี พร้อมผู้บังคับหน่วย
ในพื้นที่ให้การต้อนรับ ซึ่งหลังจากได้รับฟังบรรยายสรุปผลการปฏิบัติงานของกองกำลังสุรศักดิ์มนตรีแล้ว ผู้บัญชาการทหารบกได้เยี่ยมชมโครงการทหารพันธุ์ดี กองพลทหารราบที่ ๓ และพิพิธภัณฑ์ประวัติศาสตร์
ค่ายรามสูร จ.อุดรธานี  ซึ่งในอดีตเป็นสถานีเรดาร์ที่ใหญ่ที่สุด ๑ ใน ๗ แห่งของโลก และปัจจุบันยังเป็นแหล่งท่องเที่ยวทางทหาร ให้ประชาชนผู้สนใจได้เข้ามาเรียนรู้เรื่องราวในอดีต
จากนั้น ผู้บัญชาการทหารบกและคณะ ได้เดินทางไปเยี่ยมให้กำลังใจและมอบสิ่งของ
บำรุงขวัญให้กับกำลังพล ณ สถานีเรือสังคม อ.สังคม จ.หนองคาย ซึ่งเป็นหน่วยในสังกัดหน่วยเรือรักษา
ความสงบเรียบร้อยตามลำแม่น้ำโขง ที่มาขึ้นควบคุมทางยุทธการกับกองกำลังสุรศักดิ์มนตรี โดยได้รับฟัง
การบรรยายสรุปและร่วมลาดตระเวนทางน้ำตามลำแม่น้ำโขง เพื่อตรวจความเรียบร้อยในพื้นที่ตามแนวชายแดน
นอกจากนี้คณะผู้บัญชาการทหารบก ยังได้เดินทางไปยังจุดตรวจการณ์ดอนโคลาด อ.ปากคาด จ.บึงกาฬ เพื่อรับฟังบรรยายสรุปผลการปฏิบัติที่สำคัญทั้งการสกัดกั้นยาเสพติดตามแนวชายแดน และปัญหาการขาดแคลนน้ำของเกษตรกรในพื้นที่ โดยผู้บัญชาการทหารบกได้กล่าวว่าทหารกองกำลังป้องกันชายแดนเปรียบเสมือนรั้วของชาติ ซึ่งการปฏิบัติงานในพื้นที่ แม้จะมีข้อจำกัดในเรื่องของภูมิประเทศและความยากลำบากต่อการเข้าถึง แต่ขอให้กำลังพลทุกหน่วยนำศักยภาพของยุทโธปกรณ์ของทหารชายแดนที่มีอยู่ เพื่อป้องปรามการกระทำผิดกฎหมายทุกรูปแบบ โดยเฉพาะปัญหายาเสพติดที่ยังพบการลักลอบเข้ามาทางช่องทางธรรมชาติ ซึ่งจะต้องสกัดกั้นยาเสพติดไว้ที่แนวชายแดนไม่ให้มีผลกระทบต่อสังคมไทย จากนั้นผู้บัญชาการทหารบกได้ลงพื้นที่เยี่ยมให้กำลังใจเจ้าหน้าที่ พร้อมมอบอุปกรณ์การเรียน และ
ถุงยังชีพเพื่อการศึกษา ให้กับศูนย์พัฒนาเด็กเล็ก บ้านท่ากลิ้ง อ.ปากคาด จ.บึงกาฬ เพื่อเป็นการช่วยเหลือประชาชนในพื้นที่ตามแนวชายแดนอีกด้วย
นอกจากการตรวจเยี่ยมกองกำลังสุรศักดิ์มนตรีแล้ว ในวันที่ ๒๘ ต.ค. ๖๖ ผู้บัญชาการทหารบกมีกำหนดการร่วมคณะรัฐมนตรีว่าการกระทรวงกลาโหม เพื่อติดตามความคืบหน้าโครงการ หนองวัวซอโมเดล ซึ่งเป็นโครงการที่กองทัพบกดำเนินการตามนโยบายของรัฐบาล ในการส่งมอบพื้นที่ราชพัสดุให้กรมธนารักษ์เพื่อจัดสรรให้ประชาชนได้ใช้ประโยชน์ต่อไป
.............................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๒๗ ตุลาคม ๒๕๖๖');
INSERT INTO "press_releases_fts_content" VALUES(22,'PR-2023-0019','ผบ.ทบ. พร้อมคณะรัฐมนตรีว่าการกระทรวงกลาโหม ตรวจโครงการ "หนองวัวซอโมเดล" เดินหน้าจัดสรรที่ดินให้ประชาชนใช้ประโยชน์','ผบ.ทบ. ร่วมกับ รมว.กห. ตรวจโครงการนำร่องหนองวัวซอโมเดล จ.อุดรธานี เนื้อที่ 9,276 ไร่ ประชาชนรับประโยชน์ 1,599 แปลง ผู้ยื่นคำร้อง 703 ราย (ที่อยู่อาศัย 196, เกษตร 885 แปลง)','ผบ.ทบ. พร้อมคณะรัฐมนตรีว่าการกระทรวงกลาโหม ตรวจโครงการ “หนองวัวซอโมเดล” เดินหน้าจัดสรรที่ดินให้ประชาชนใช้ประโยชน์
สำหรับภารกิจการตรวจเยี่ยมหน่วยทหารในพื้นที่กองกำลังสุรศักดิ์มนตรีของ                  พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก และคณะในวันนี้ (๒๘ ต.ค. ๖๖) ผู้บัญชาการทหารบกได้ให้การต้อนรับ นายสุทิน คลังแสง รัฐมนตรีว่าการกระทรวงกลาโหม ในโอกาสเดินทางมาตรวจเยี่ยมหน่วยทหารในพื้นที่จังหวัดอุดรธานี และติดตามความคืบหน้าในการบริหารจัดการที่ราชพัสดุในความครอบครองของกองทัพบกเพื่อให้ประชาชนใช้ประโยชน์ตามนโยบายของรัฐบาล โดยกองทัพบกได้มีโครงการนำร่อง “หนองวัวซอโมเดล” ซึ่งโครงการดังกล่าวเป็นการนำพื้นที่ของกองทัพภาคที่ ๒                              (มณฑลทหารบกที่ ๒๔) ที่ไม่ได้ใช้ประโยชน์ ส่งมอบให้กับกรมธนารักษ์ เพื่อจัดสรรให้ประชาชนได้ใช้ประโยชน์ในด้านต่างๆ โดยเฉพาะเพื่อการเกษตร การพัฒนาโครงสร้างพื้นฐานและระบบสาธารณูปโภค การเพิ่มพูนของระบบนิเวศ และการใช้เป็นแหล่งเรียนรู้เพื่อสนับสนุนการสร้างรายได้  เป็นการสร้างโอกาสทางเศรษฐกิจและสร้างความเข้มแข็งด้านสังคมของประเทศ
โดยผู้บัญชาการทหารบกได้ร่วมคณะของรัฐมนตรีว่าการกระทรวงกลาโหม รับฟังการบรรยายสรุปเรื่องการบริหารจัดการที่ดินจากมณฑลทหารบกที่ ๒๔, กองกำลังสุรศักดิ์มนตรี, สำนักงาน ธนารักษ์ และหน่วยงานที่เกี่ยวข้อง จากนั้นได้เดินทางไปยังศาลาประชาคมเพื่อตรวจเยี่ยมการปฏิบัติงานของเจ้าหน้าที่กรมธนารักษ์ พร้อมพบปะพูดคุย รับฟังปัญหาต่างๆ เพื่อมอบหมายส่วนที่เกี่ยวข้องดำเนินการต่อไป
สำหรับโครงการ “หนองวัวซอโมเดล” มีเนื้อที่ ๙,๒๗๖ ไร่เศษ ประชาชนได้รับประโยชน์ ๑,๕๙๙ แปลง ทั้งนี้กรมธนารักษ์ และกองทัพบก ได้บูรณาการร่วมกับส่วนราชการในพื้นที่ ได้แก่            กอ.รมน.จังหวัดอุดรธานี , ธนารักษ์พื้นที่อุดรธานี และฝ่ายปกครอง เพื่อขับเคลื่อนการดำเนินการตามนโยบายรัฐบาลให้เป็นไปด้วยความเรียบร้อย ในการประชุมทำความเข้าใจกับประชาชน การตรวจสอบแปลงที่ดินและการสอบสวนสิทธิการครอบครอง ทั้งนี้ จากผลดำเนินการในห้วงวันที่ ๑๖ ถึง ๒๗ ตุลาคม ๒๕๖๖ ที่ผ่านมานั้น มีผู้ยื่นคำร้องขอเช่าและสอบสวนสิทธิ์จำนวน ๗๐๓ ราย ๑,๐๘๑ แปลง แบ่งเป็น            ที่อยู่อาศัย ๑๙๖ แปลง เพื่อการเกษตร ๘๘๕ แปลง ซึ่งคาดว่าจะสามารถแจกเอกสารการเช่าที่ราชพัสดุให้กับประชาชนที่ได้ดำเนินการตามขั้นตอนเรียบร้อยไม่น้อยกว่า ๓๐๐ ราย เพื่อเป็นของขวัญปีใหม่ให้กับประชาชนตามนโยบายของรัฐบาล นอกจากนี้กองทัพบกได้มอบหมายให้กรมการทหารช่าง ทำการสำรวจความต้องการระบบสาธารณูปโภคในพื้นที่ตามโครงการ ได้แก่ แหล่งน้ำธรรมชาติ อ่างเก็บน้ำ ถนน และระบบไฟฟ้าประปา เพื่อเสนอรัฐบาลพิจารณาพัฒนาเป็นพื้นที่สาธารณประโยชน์ ให้กับประชาชนต่อไป
