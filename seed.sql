INSERT INTO "press_releases_fts" VALUES('PR-2023-0010','ทบ. ให้ความสำคัญทหารกองประจำการทุกขั้นตอน ระดมช่วยน้ำท่วมทุกพื้นที่ พร้อมบูรณาการทุกหน่วยสกัดกั้นยาเสพติด','ผบ.ทบ. ประชุมติดตามการปฏิบัติทั่วประเทศ มอบนโยบาย 3 ด้าน: ดูแลทหารกองประจำการ (รับสมัครออนไลน์ 5,912 คน), ช่วยเหลืออุทกภัย (ยังเหลือ 20 จังหวัด), สกัดกั้นยาเสพติดชายแดน','ทบ. ให้ความสำคัญทหารกองประจำการทุกขั้นตอน ระดมช่วยน้ำท่วมทุกพื้นที่ 
พร้อมบูรณาการทุกหน่วยสกัดกั้นยาเสพติด
วันนี้ (๑๖ ต.ค. ๖๖) ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก ได้ประชุมติดตามการปฏิบัติงานของหน่วยทหารทั่วประเทศ 
โดยผู้บัญชาการทหารบกได้กล่าวขอบคุณผู้บังคับหน่วยทุกหน่วยที่ได้จัดกิจกรรมเทิดพระเกียรติและกิจกรรมจิตอาสาเพื่อถวายเป็นพระราชกุศล เนื่องใน “วันนวมินทรมหาราช” ๑๓ ตุลาคม ๒๕๖๖ ซึ่งถือเป็นวันสำคัญของชาติที่ปวงชนชาวไทยได้น้อมรำลึกถึงพระมหากรุณาธิคุณของพระบาทสมเด็จพระบรมชนกาธิเบศ มหาภูมิพลอดุลยเดชมหาราชบรมนาถบพิตร พร้อมทั้ง
ให้เตรียมจัดกิจกรรมในวันปิยมหาราชที่ใกล้จะถึงนี้ด้วย เพื่อแสดงออกถึงความจงรักภักดี
ต่อสถาบันพระมหากษัตริย์ที่ได้วางรากฐานและพัฒนาประเทศเพื่อพสกนิกรชาวไทยมาตั้งแต่อดีตจวบจนปัจจุบัน
ในการนี้ผู้บัญชาการทหารบกได้มอบแนวทางการดำเนินงานเกี่ยวกับทหาร
กองประจำการให้เป็นไปด้วยความถูกต้องตามระเบียบราชการ ตั้งแต่กระบวนการของสัสดีจังหวัด กระบวนการตรวจเลือกทหาร ไปจนถึงกระบวนการฝึกทหารใหม่ ให้เน้นการพัฒนาสภาพร่างกายและทักษะทางทหารตามขั้นตอนเพื่อปรับสภาพจากพลเรือนสู่ความเป็นทหาร ทั้งนี้ให้ปฏิบัติตามมาตรการด้านความปลอดภัยในการฝึก รวมถึงให้ความสำคัญในเรื่องสุขอนามัยและสภาพร่างกายของทหารกองประจำการแต่ละนาย เพื่อไม่ให้เกิดการบาดเจ็บและสูญเสียระหว่างการฝึก พร้อมกำชับให้ผู้บังคับหน่วยทุกระดับลงมากำกับดูแลอย่างใกล้ชิด
พร้อมกันนี้ผู้บัญชาการทหารบกยังกล่าวถึงเรื่องการรับสมัครทหารกองเกินเข้ารับราชการทหารกองประจำการ โดยวิธีร้องขอ (กรณีพิเศษ) ด้วยระบบออนไลน์ ประจำปี ๒๕๖๗ ซึ่งกองทัพบกได้เริ่มเปิดรับสมัครแล้วในปีนี้จนถึง ๒๘ มกราคม ๒๕๖๗ ปัจจุบันมียอดผู้สมัคร ๕,๙๑๒ คน (๑๖ ต.ค. ๖๖) โดยผู้บัญชาการทหารบกได้เน้นย้ำให้ทุกหน่วยทหารประชาสัมพันธ์ สร้างการรับรู้ถึงสิทธิและสวัสดิการที่ทหารกองประจำการจะได้รับ รวมถึงช่องทางการรับสมัครผ่านเว็บไซต์ https://rcm.rta.mi.th/ อย่างต่อเนื่อง
สำหรับสถานการณ์อุทกภัยที่เกิดขึ้นในหลายพื้นที่ ผู้บัญชาการทหารบก
