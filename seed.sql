INSERT INTO "press_releases_fts" VALUES('PR-2023-0003','ทบ. จับมือกระทรวงการคลัง ขับเคลื่อนนโยบายรัฐบาล ร่วมหารือบริหารจัดการที่ดินเพื่อให้ประชาชนเข้าใช้ประโยชน์','รอง ผบ.ทบ. ให้การต้อนรับ รมช.คลัง หารือเรื่องที่ราชพัสดุในความครอบครอง ทบ. กำหนดพื้นที่นำร่อง อ.หนองวัวซอ จ.อุดรธานี 10,000 ไร่เศษ ให้แล้วเสร็จ ธ.ค. 66','ทบ. จับมือกระทรวงการคลัง ขับเคลื่อนนโยบายรัฐบาล ร่วมหารือบริหารจัดการที่ดิน 
เพื่อให้ประชาชนเข้าใช้ประโยชน์
วานนี้ (๕ ต.ค. ๖๖) ที่กองบัญชาการกองทัพบก ผู้บัญชาการทหารบก มอบให้ 
พลเอก สุขสรรค์ หนองบัวล่าง รองผู้บัญชาการทหารบก ให้การต้อนรับ นายจุลพันธ์ อมรวิวัฒน์ รัฐมนตรีช่วยว่าการกระทรวงการคลัง และคณะ ในโอกาสเข้าร่วมหารือเรื่องการบริหารจัดการที่ราชพัสดุ
ในความครอบครองของกองทัพบก เพื่ออนุญาตให้ประชาชนใช้ประโยชน์ตามนโยบายรัฐบาล โดยมีส่วนราชการต่างๆ เข้าร่วมหารือ ได้แก่ กรมธนารักษ์, กรมส่งกำลังบำรุงทหารบก และศูนย์ประสานการปฏิบัติที่ ๔ กอ.รมน.
การหารือดังกล่าวเป็นการขับเคลื่อนนโยบายของรัฐบาลที่มุ่งสร้างและขยายโอกาส
ให้กับประชาชน โดยนำพื้นที่ของส่วนราชการต่างๆ ที่ไม่ได้ใช้ประโยชน์ ส่งมอบให้กรมธนารักษ์
เพื่อพิจารณาให้ประชาชนได้ใช้ประโยชน์ต่อไป ในส่วนของกองทัพบก ได้มีการดำเนินการสำรวจพื้นที่ และส่งมอบที่ราชพัสดุ ตั้งแต่ปี พ.ศ. ๒๕๕๒ ตามโครงการ “๑ ล้านไร่ มิติใหม่ที่ราชพัสดุ” ซึ่งมีแผนในการส่งมอบพื้นที่
กว่า ๕๐๐,๐๐๐ ไร่ ซึ่งกองทัพบกจะได้นำแนวความคิดจากโครงการดังกล่าวมาพิจารณาที่ราชพัสดุ
ในความครอบครองที่สามารถให้ประชาชนเข้าใช้ประโยชน์ได้
ในการประชุมนอกจากจะมีการชี้แจงผลการดำเนินงานของหน่วยต่างๆ แล้ว กองทัพบกยังได้มีการกำหนดพื้นที่นำร่องที่สามารถดำเนินการได้ทันที ในพื้นที่ อ.หนองวัวซอ จ.อุดรธานี เนื้อที่ ๑๐,๐๐๐ ไร่เศษ ซึ่งในที่ประชุมได้มีมติเห็นชอบตามที่กองทัพบกเสนอ โดยให้บูรณาการร่วมกับ กอ.รมน., กรมธนารักษ์และหน่วยงานที่เกี่ยวข้องดำเนินการให้แล้วเสร็จภายในเดือน ธ.ค. ๖๖ เพื่อมอบเป็นของขวัญปีใหม่
ให้กับประชาชน โดยรัฐมนตรีช่วยว่าการกระทรวงการคลัง ได้ให้แนวทางเพิ่มเติมในประเด็นพื้นที่โครงการ
นำร่อง ว่าไม่จำเป็นต้องเป็นพื้นที่ขนาดใหญ่แต่ให้มีความพร้อม และไม่ส่งผลกระทบกับหน่วยงาน 
และขอให้จัดเตรียมพื้นที่ว่างเปล่าประมาณ ๑๐๐ - ๓๐๐ ไร่ เพื่อนำมาพัฒนาก่อนจะมอบให้ประชาชน
