INSERT INTO "press_release_content" VALUES('PR-2023-0034','ทบ. บูรณาการทุกส่วน ช่วยน้ำท่วมภาคใต้ส่งกำลังพล และยุทโธปกรณ์ลงพื้นที่บรรเทาทุกข์ประชาชน
จากสถานการณ์ฝนตกหนักในพื้นที่ภาคใต้ จากอิทธิพลของลมมรสุม ประกอบกับหย่อมความกดอากาศต่ำกำลังแรงที่ปกคลุมภาคใต้ตอนล่าง ทำให้หลายจังหวัดในพื้นที่ภาคใต้เผชิญกับอุทกภัย ได้แก่ จ.ชุมพร, นครศรีธรรมราช, สงขลา, พัทลุง, ปัตตานี และ จ.นราธิวาส พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ได้มีความห่วงใยประชาชนในพื้นที่ประสบภัย จึงมอบหมายให้ศูนย์บรรเทาสาธารณภัยกองทัพภาคที่ ๔ บูรณาการร่วมกับส่วนราชการในพื้นที่ ติดตามสถานการณ์ ประเมินระดับน้ำอย่างใกล้ชิดตลอด ๒๔ ชม. พร้อมนำกำลังพลและยุทโธปกรณ์ลงพื้นที่ให้ความช่วยเหลือในทันทีที่เกิดเหตุ เพื่อบรรเทาความเดือดร้อน และคลี่คลายสถานการณ์จนกว่าจะกลับเข้าสู่สภาวะปกติ อาทิ พื้นที่ จ.นครศรีธรรมราช โดยศูนย์บรรเทาสาธารณภัย มณฑลทหารบกที่ ๔๑ ได้นำกำลังลงพื้นที่เคลื่อนย้ายผู้สูงอายุและกลุ่มเปราะบาง พร้อมขนย้ายสิ่งของไปยังศูนย์พักพิงชั่วคราว รวมทั้งได้จัดกำลังพลจากกองร้อยฝึกรบพิเศษที่ ๔ ลงพื้นที่ช่วยเหลือซ่อมบ้านประชาชนที่ได้รับความเสียหายจากเหตุลมกระโชกแรง, พื้นที่ จ.สงขลา ศูนย์บรรเทาสาธารณภัย มณฑลทหารบกที่ ๔๒ ได้จัดกำลังพลร่วมกับฝ่ายปกครองส่วนท้องถิ่นเยี่ยมเยียนมอบสิ่งของอุปโภคบริโภคให้กับประชาชนที่ประสบอุทกภัย ตลอดจนอำนวยความสะดวกในการสัญจร ณ อ.หาดใหญ่, คลองหอยโข่ง และ อ.สะเดา, พื้นที่ จ.สุราษฎร์ธานี ศูนย์บรรเทาสาธารณภัย มณฑลทหารบกที่ ๔๕ จัดกำลังพลกรมทหารราบที่ ๒๕ พร้อมยุทโธปกรณ์ช่วยอพยพเคลื่อนย้ายนักท่องเที่ยวไปยังตัวเมืองเพื่อเดินทางกลับ เนื่องจากระดับน้ำเพิ่มสูงขึ้นตัดผ่านเส้นทางหลักในการเข้าออกรีสอร์ทใน อ.บ้านนาสาร, พื้นที่ จ.พัทลุง โดยศูนย์บรรเทาสาธารณภัย กองพลพัฒนาที่ ๔ จัดกำลังพลช่วยขนย้ายสิ่งของขึ้นที่สูง และบรรจุกระสอบทรายทำแนวกั้นน้ำ ใน อ.ควนขนุน และ อ.ศรีนครินทร์, พื้นที่ จ.ปัตตานี หน่วยเฉพาะกิจกรมทหารพรานที่ ๒๒ นำกำลังพลบรรจุกระสอบทรายป้องกันน้ำท่วมสถานศึกษา และศาสนสถาน, พื้นที่ จ.นราธิวาส หน่วยเฉพาะกิจกรมทหารพรานที่ ๔๕ จัดตั้งศูนย์บรรเทาสาธารณภัยร่วม เฝ้าระวังระดับน้ำ ขนย้ายสิ่งของไปยังที่ปลอดภัยและช่วยเหลือประชาชนที่ประสบอุบัติเหตุในเส้นทางสัญจรที่ถูกกระแสน้ำตัดขาด 
พร้อมกันนี้ผู้บัญชาการทหารบกยังได้มีข้อห่วงใยพิเศษฝากไปถึงผู้บังคับหน่วยและกำลังพล
ทุกนาย ให้มีมาตรการในการดูแลป้องกันตนเอง สวมใส่อุปกรณ์อย่างเหมาะสม เพื่อให้มีความปลอดภัยจากการปฏิบัติหน้าที่ และสามารถดูแลคลี่คลายสถานการณ์อุทกภัยได้โดยเร็ว ซึ่งหากประชาชนหรือส่วนราชการที่ประสบภัยต้องการความช่วยเหลือ สามารถติดต่อได้ที่ศูนย์บรรเทาสาธารณภัยกองทัพภาคที่ ๔ โทรศัพท์ ๐๗๕-๓๘๓๔๐๕, พื้นที่ ๓ จังหวัดชายแดนภาคใต้ ติดต่อศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๖ โทรศัพท์ ๐๗๓-๓๔๐๑๔๑-๕ ต่อ ๔๓๐๑๑ และในพื้นที่ ๔ อำเภอของ จ.สงขลา ติดต่อได้ที่ศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๒ โทรศัพท์ ๐๗๔-๖๘๖๖๘๕ หรือติดต่อหน่วยทหาร
