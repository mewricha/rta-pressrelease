INSERT INTO "press_release_content" VALUES('PR-2023-0042','ทบ. เสียใจเกิดเหตุกำลังพลยิงปืนในที่สาธารณะ 
วันนี้ (๑๑ ธันวาคม ๒๕๖๖) เวลาประมาณ ๑๖.๐๐ น. จากเหตุมีผู้ใช้อาวุธปืนยิงขู่ผู้รับเหมาก่อสร้าง ภายในหมู่บ้านกลางเมือง ถนนศรีนครินทร์ ตำบลสำโรงเหนือ อำเภอเมือง จังหวัดสมุทรปราการ โดยทราบชื่อผู้ก่อเหตุภายหลังคือ พันเอก ศุภกิจ สงวนดีกุล นายแพทย์โรงพยาบาลพระมงกุฎเกล้า อายุ ๕๖ ปี  ล่าสุดเจ้าหน้าที่ตำรวจได้เข้าระงับสถานการณ์ และเชิญตัวผู้ก่อเหตุเข้ารับการสอบสวนตามกระบวนการทางกฎหมายแล้ว 
     สำหรับสาเหตุและแรงจูงใจในการก่อเหตุอยู่ในระหว่างการตรวจสอบข้อเท็จจริง  เบื้องต้นภายหลังสอบถามภริยาผู้ก่อเหตุ ทราบว่าที่ผ่านมา ได้รักษาป่วยทางจิต ที่สถาบันกัลยาณ์ ราชนครินทร์ กรมสุขภาพจิต และจากการสอบถามทราบว่าพักราชการมาหลายปี
   เมื่อสอบถามผู้เสียหาย ทราบว่ามีการใช้อาวุธปืน 3นัด ยิงมาบริเวณที่ ผู้เสียหายและลูกน้องกำลังทำงานก่อสร้างภายในหมู่บ้าน สามารถหลบในพื้นที่บ้านจนปลอดภัยทุกคน
     (ทั้งนี้ทางหน่วยต้นสังกัดทราบถึงปัญหาสภาพจิตใจและได้สั่งให้มีการพักงานตลอดจนรักษาตนให้หายเป็นปกติ )
….(โดยจากเหตุการณ์ดังกล่าว ผบช.กรมแพทย์ทหารบก ที่ตรวจสอบเหตุการณ์ และ นายทหารพระธรรมนูญ ของ กรมแพทย์ทหารบก ได้ติดตามอย่างใกล้ชิด หากการกระทำผิดเกิดจาการบันดาลโทสะ หรือสภาพจิตใจ หน่วยต้นสังกัดพร้อมให้ความร่วมมือ จนท.ตร. )
    กองทัพบกขอแสดงความเสียใจในเหตุการณ์ที่เกิดขึ้น และพร้อมอำนวยความสะดวกทางคดีกับเจ้าหน้าที่ตำรวจ ให้เป็นไปตามกระบวนการทางกฎหมายต่อไป
....................................................................
