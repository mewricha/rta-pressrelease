INSERT INTO "press_releases_fts" VALUES('PR-2023-0051','ทบ. ชี้แจงกรณีทหารพรานหญิงถูกนายสิบบุกรุก','ทบ. ชี้แจงกรณีทหารพรานหญิงถูกนายสิบบุกรุก ยืนยันได้ดำเนินการทางวินัยแล้ว','ทบ. ลงโทษผู้กระทำผิดพร้อมสอบสวนข้อเท็จจริงให้เกิดความเป็นธรรม กรณีอาสาสมัครทหารพรานหญิงถูกบุกรุกในบ้านพัก 
    จากการที่เมื่อ ๒๒ ธ.ค.๖๖ ที่ผ่านมา อาสาสมัครทหารพรานหญิงได้มายื่นหนังสือเอกสารร้องเรียนที่ ศูนย์รับเรื่องร้องเรียนกองทัพบก  ณ กองบัญชาการกองทัพบก กรณีถูกนายสิบทหารบุกรุกเข้าบ้านพักในค่ายทหาร พยายามลวนลามในผู้เสียหาย แต่ผู้เสียหายป้องกันตนและสามารถหลบหนีออกมาได้ และกรณีหน่วยต้นสังกัดของผู้เสียหายให้ลาออกจากการเป็นอาสาสมัครทหารพราน
หลังจากเกิดเหตุ ผู้เสียหายได้ร้องเรียนผ่านช่องทางต่างๆ ของหน่วย รวมทั้งผ่านแอพลิเคชัน S.M.A.R.T ของกองทัพบก เมื่อวันที่ ๑๒ ธ.ค.๖๖ ที่ผ่านมา ซึ่งเป็นกองทัพบกได้ดำเนินการตามขั้นตอนการรับเรื่องร้องเรียน  โดยผู้บัญชาการทหารบกได้สั่งการไปยังแม่ทัพภาคที่ ๓ ให้สอบสวนข้อเท็จจริง และดำเนินการช่วยเหลือผู้เสียหายในทันที โดยปัจจุบันได้ดำเนินการตั้งคณะกรรมการสอบสวนลงโทษผู้กระทำผิดที่ทำการบุกรุก โดยงดบำเหน็จ และจำขังในเรือนจำทหารตามวินัยทหารแล้ว ทั้งยังให้ย้ายออกจากบ้านพักข้าราชการทหาร และทำบันทึกข้อตกลงในการมอบเงินเยียวยาให้กับผู้เสียหาย รวมถึงตั้งคณะกรรมการสอบข้อเท็จจริงผู้บังคับหน่วยที่เกี่ยวข้องในประเด็นความล่าช้าของกระบวนการช่วยเหลืออีกด้วย
     กองทัพบกพร้อมให้ความเป็นธรรม และดูแลความปลอดภัยของผู้เสียหายตลอดจนบุคคลที่เกี่ยวข้องกับเหตุการณ์ดังกล่าว ขอยืนยันว่ากระบวนการรับเรื่องร้องเรียนของกองทัพบกทุกช่องทางมีประสิทธิภาพ ในส่วนของการดำเนินคดีตามกฎหมายกองทัพบกยินดีให้ความร่วมมือตามกระบวนการสอบสวนของเจ้าหน้าที่ต่อไป
