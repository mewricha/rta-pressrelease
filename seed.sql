INSERT INTO "press_releases_fts" VALUES('PR-2023-0033','ผบ.ทบ. ลงพื้นที่ จ.ประจวบคีรีขันธ์ ตรวจจุดตรวจห้วยยาง และด่านสิงขร หลังเป็นเจ้าภาพ AARM','ผบ.ทบ. ลงพื้นที่ประจวบฯ ตรวจด่านห้วยยาง-สิงขร ภายหลังเสร็จสิ้นภารกิจเป็นเจ้าภาพ AARM','ผบ.ทบ. เยี่ยมหน่วยทหาร จ.ประจวบคีรีขันธ์ ลงพื้นที่ให้กำลังใจทั้งด่านตรวจ และชายแดน หลังเสร็จภารกิจปิด AARM 2023
	ช่วงบ่ายวานนี้ (๒๔ พ.ย. ๖๖) หลังจากที่ พล.อ. เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก 
เป็นประธานในพิธีปิดการทดสอบยิงปืนทางยุทธวิธีกองทัพบกกลุ่มประเทศอาเซียน ครั้งที่ ๓๑ (AARM 2023) ณ ศูนย์การทหารราบ จ.ประจวบคีรีขันธ์ ได้เดินทางลงพื้นที่ตรวจเยี่ยมให้กำลังใจหน่วยทหารใน                          จ.ประจวบคีรีขันธ์ และติดตามสถานการณ์ด้านความมั่นคง โดยเฉพาะเรื่อง การสกัดกั้นยาเสพติด, ผู้หลบหนีเข้าเมือง ตลอดจนการลักลอบขนย้ายสิ่งกฎหมายในพื้นที่ชายแดน 
	โดยผู้บัญชาการทหารบกได้ตรวจเยี่ยมจุดตรวจร่วมห้วยยาง อ.ทับสะแก ซึ่งเป็นจุดตรวจสำคัญบนทางหลวงหมายเลข ๔ (เพชรเกษม)  ที่จัดตั้งตั้งแต่ ๑๖ พฤศจิกายน ๒๕๖๔ เพื่อป้องกันและสกัดกั้นสิ่งผิดกฎหมาย โดยมีมาตรการเฝ้าระวังอย่างเป็นระบบร่วมกันทั้งฝ่ายทหาร(กรมทหารราบที่ ๒๙)  เจ้าหน้าที่ตำรวจ และจังหวัดประจวบคีรีขันธ์ และตั้งแต่มีการตั้งจุดตรวจนี้มีผลการปฏิบัติมาอย่างต่อเนื่อง ได้แก่ การจับกุมผู้ต้องหาที่กระทำผิด พรบ.ยาเสพติด ๓๙ ราย ยาบ้ารวม ๔,๙๘๒ เม็ด, ไอช์ ๑๗.๓ กิโลกรัม และ กัญชา ๒๕ กรัม,การกระทำผิด พรบ. คนเข้าเมือง โดยจับกุมผู้ลักลอบเข้าเมืองโดยผิดกฎหมาย ๕๘ คน,การกระทำผิด พรบ.โรคระบาดสัตว์ ๘ ครั้ง จับกุมผู้ต้องหา ๑๐ ราย ได้แก่ ซากสุกร ๑๒,๕๐๐ กก.,ซากไก่ ๑๐,๐๐๐ กก. แพะ ๓๐๐ ตัว และวัว ๓๑๓ ตัว ,การกระทำผิด พรบ. อาวุธปืน เครื่องกระสุน ๕ ครั้ง จับกุมผู้ต้องหา ๕ ราย อาวุธปืน ๕ กระบอก และเครื่องกระสุน ๔๖ นัด 
	จากนั้นผู้บัญชาการทหารบกเดินทางไปตรวจเยี่ยมให้กำลังใจกำลังพลหน่วยเฉพาะกิจจงอางศึก กรมทหารราบที่ ๑๙ ที่มีหน้าที่คัดกรองบุคคล และควบคุมจัดระเบียบการขนถ่ายสินค้า ณ            จุดตรวจสิงขร ซึ่งเป็นจุดผ่อนปรนพิเศษ ตามประกาศกระทรวงมหาดไทย อนุญาตให้สามารถดำเนินการนำเข้า และ ส่งออกสินค้า โดยสินค้านำเข้า ที่มีมูลค่าสูงจากฝั่งเมียนมา คือจำพวกอาหารทะเล และ              ในส่วนสินค้าส่งออกของฝั่งไทยที่มีมูลค่าสูง เป็นสินค้าจำพวกลูกกุ้งมีชีวิต,อาหารสัตว์ และ บรรจุภัณฑ์ ซึ่งรวมมูลค่าการค้าในปี ๒๕๖๖ มากกว่า ๗ ร้อยล้านบาท 
	ทั้งนี้ผู้บัญชาการทหารบกยังได้เดินทางไปยังโรงเรียนด่านสิงขร มอบจักรยานและถุงยังชีพ
เพื่อการศึกษาให้กับเด็กนักเรียนในพื้นที่ห่างไกล และเดินทางต่อไปยังกองร้อยตำรวจตระเวนชายแดนที่ ๑๔๖ เพื่อพบปะให้กำลังใจกำลังพลที่ปฏิบัติหน้าที่ในฐานปฏิบัติการ สำหรับการตรวจเยี่ยมในครั้งนี้                      ผู้บัญชาการทหารบกได้นำความห่วงใยของนายกรัฐมนตรี และ รมว.กลาโหม มาให้กำลังใจกับผู้ปฏิบัติหน้าที่ทุกคน ให้ช่วยดูแลประชาชนและป้องปรามการกระทำผิดกฎหมายทุกประเภทในพื้นที่ชายแดน โดยเฉพาะการสกัดกั้นยาเสพติด,การหลบหนีเข้าเมืองผิดกฎหมาย และการช่วยกันดูแลพื้นที่ชายแดนตลอดจนประชาชนโดยรอบให้มีความสงบสุข
