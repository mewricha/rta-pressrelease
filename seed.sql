INSERT INTO "press_releases_fts" VALUES('PR-2023-0050','ผบ.ทบ. เยี่ยม รร.จปร. นครนายก บรรยายพิเศษ และเปิด CADET BARBER','ผบ.ทบ. เยี่ยมโรงเรียนนายร้อยจปร. นครนายก บรรยายพิเศษให้นักเรียนนายร้อย และเปิดร้านตัดผม CADET BARBER','ผบ.ทบ.เยี่ยมนักเรียนนายร้อย บรรยายพิเศษแก่ว่าที่นายทหารใหม่ เปิดห้องตัดผม “CADET BARBER ” และร่วมรับประทานอาหารเย็นอย่างเป็นกันเอง
วานนี้ (๒๑ ธ.ค.๖๖) พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก และคณะผู้บังคับบัญชาเดินทางไปยังโรงเรียนนายร้อยพระจุลจอมเกล้า จ.นครนายก เยี่ยมการฝึกการปฏิบัติการร่วมพลเรือนตำรวจทหารปี ๒๕๖๗  พร้อมบรรยายพิเศษประสบการณ์ทำงานและแนวทางรับราชการ แก่นักเรียนนายร้อยชั้นปีที่ ๕ ที่กำลังจะจบการศึกษาเป็นว่าที่นายทหารใหม่ ณ หอประชุมโรงเรียนนายร้อย               พระจุลจอมเกล้า โดยผู้บัญชาการทหารบกได้ให้ความสำคัญกับการเป็นทหารอาชีพที่จะต้องรู้หลักในการนำหน่วยทหาร และการเตรียมความพร้อมในปฏิบัติภารกิจทั้งร่างกายและจิตใจ ยึดมั่นอุดมการณ์ในการทำงาน เพื่อประโยชน์ของประเทศชาติ และประชาชนเป็นสำคัญ 
จากนั้นผู้บัญชาการทหารบกได้เดินทางไปเปิดห้องตัดผมนักเรียนนายร้อย “CADET BARBER ” และร่วมรับประทานอาหารเย็นกับนักเรียนนายร้อยอย่างเป็นกันเอง สร้างขวัญกำลังใจ และเป็นแบบอย่างในการรับราชการของรุ่นน้องนักเรียนนายร้อย ซึ่งจะเจริญเติบโตเป็นกำลังหลักของกองทัพบกและประเทศชาติต่อไป
