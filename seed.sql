INSERT INTO "press_release_content" VALUES('PR-2024-0020','สรุปยอดการรับสมัครทหารออนไลน์ในส่วนของกองทัพบก ปี ๒๕๖๗ ผ่านการคัดเลือก ๑๔,๑๘๕ คน เพิ่มขึ้น ๕๗ เปอร์เซ็นต์
	เสร็จสิ้นแล้วสำหรับการรับสมัครและคัดเลือกทหารกองเกินเข้ารับราชการกองประจำการโดยวิธีร้องขอ (กรณีพิเศษ) ด้วยระบบออนไลน์ ประจำปี ๒๕๖๗ เมื่อ ๒๘ ม.ค.๖๗ ที่ผ่านมา ในส่วนของกองทัพบก เปิดรับสมัคร ๒๗,๗๒๑ คน มีผู้สมัคร ๒๐,๐๖๕ คน มาคัดเลือก ๑๔,๙๓๕ คน ผ่านการคัดเลือก ๑๔,๑๘๕ คน โดยเมื่อพิจารณาเปรียบเทียบกับข้อมูลสถิติย้อนหลังตั้งแต่เริ่มโครงการครั้งแรกในปี ๒๕๖๔ เปิดรับสมัคร ๑๐,๗๘๙ คน ยอดรายงานตัวเข้าหน่วย ๒,๙๔๕ คน, ปี ๒๕๖๕ เปิดรับสมัคร ๑๔,๓๒๑ คน ยอดรายงานตัวเข้าหน่วย ๖,๐๔๓ คน และ ปี ๒๕๖๖ เปิดรับสมัคร ๒๘,๖๔๒ คน ยอดรายงานตัวเข้าหน่วย ๘,๙๘๗ คน ซึ่งจะเห็นได้ว่ามีแนวโน้มของผู้สมัครเพิ่มขึ้นอย่างต่อเนื่องในทุกปี 
	สำหรับปัจจุบันกองทัพบกยังให้ความสำคัญกับสิทธิและสวัสดิการของทหารกองประจำการเป็นอย่างยิ่ง สอดคล้องกับนโยบายของรัฐบาลและกระทรวงกลาโหมในการเปลี่ยนผ่านสู่ระบบทหารกองประจำการแบบสมัครใจ โดยเฉพาะในส่วนของทหารกองประจำการที่เมื่อครบกำหนดปลดแล้วสมัครใจรับราชการต่อ (เลื่อนปลด) เมื่อสอบเข้ารับราชการในส่วนของกองทัพบก จะได้รับคะแนนเพิ่มพิเศษร้อยละ ๕ ต่อการสมัครใจเลื่อนปลด ๑ ครั้ง อีกทั้งในการสอบเข้าเป็นนักเรียนนายสิบทหารบก จะมีโควตาเข้ารับการศึกษาร้อยละ ๓๐ ในส่วนของทหารกองประจำการที่เลื่อนปลดอีกด้วย ตลอดจนได้รับสิทธิและสวัสดิการอื่น ๆ ตามที่กระทรวงกลาโหมกำหนด ทั้งนี้ ทหารกองประจำการ
ที่ประสงค์ขอเลื่อนปลดสามารถแจ้งความประสงค์ได้ที่หน่วยต้นสังกัด  
