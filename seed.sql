INSERT INTO "press_release_content" VALUES('PR-2023-0026','กระชับสัมพันธ์ กองทัพไทย-จีน ขยายความร่วมมือด้านการฝึกศึกษา
วันนี้ (๙ พฤศจิกายน ๒๕๖๖) ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก ให้การต้อนรับ พลเอก ลี เฉียวหมิง ผู้บัญชาการกองทัพปลดปล่อยประชาชนจีน 
ในโอกาสเดินทางเยือนราชอาณาจักรไทยอย่างเป็นทางการในฐานะแขกของกองทัพบกไทย
โดยกองทัพบกได้จัดพิธีตรวจแถวทหารกองเกียรติยศในการต้อนรับ จากนั้นผู้บัญชาการกองทัพปลดปล่อยประชาชนจีนได้เยี่ยมชมพิพิธภัณฑ์กองทัพบกเฉลิมพระเกียรติ ซึ่งเป็นสถานที่จัดแสดงประวัติศาสตร์ ยุทโธปกรณ์ และวิวัฒนาการด้านต่างๆ ของกองทัพบกไทย ก่อนเข้าพูดคุยกับผู้บัญชาการทหารบกเพื่อหารือประสานความร่วมมือในด้านต่างๆ ของทั้งสองกองทัพ
ในระหว่างการสนทนาผู้บัญชาการทหารบกได้กล่าวถึงนโยบายของกองทัพปลดปล่อยประชาชนจีนที่ได้ส่งเสริมความมั่นคงและผลประโยชน์ร่วมกันในภูมิภาคอาเซียน อีกทั้งได้หารือด้านการแลกเปลี่ยนการศึกษาหลักสูตรทางการทหาร ของกำลังพลในระดับปฏิบัติงานให้มากขึ้น โดยที่ผ่านมาได้มีการแลกเปลี่ยนการศึกษาทางทหารในระดับโรงเรียนนายร้อย โรงเรียนเสนาธิการทหารบก และวิทยาลัยป้องกันราชอาณาจักร ซึ่งกองทัพบกได้สนับสนุนที่นั่งศึกษาหลักสูตรหลักประจำโรงเรียนเสนาธิการทหารบกให้กองทัพปลดปล่อยประชาชนจีนอย่างต่อเนื่อง รวมทั้งความร่วมมือด้านการฝึกร่วม/ผสมระหว่างสองกองทัพ อาทิ การฝึกผสมหน่วยรบพิเศษ ไทย – จีน ภายใต้รหัส STRIKE รวมทั้ง COBRA GOLD ที่กองทัพปลดปล่อยประชาชนจีนได้ส่งกำลังพลเข้าร่วมการฝึกภายใต้โครงการช่วยเหลือประชาชน นอกจากนี้ได้มีการหารือเกี่ยวกับการพัฒนาความรู้ด้าน Cyber Security และด้านเทคโนโลยีป้องกันประเทศร่วมกัน
ทั้งนี้ราชอาณาจักรไทยและสาธารณรัฐประชาชนจีนมีความสัมพันธ์ทางการทูตอย่างแน่นแฟ้น การให้การต้อนรับผู้บัญชาการกองทัพปลดปล่อยประชาชนจีนในครั้งนี้ เป็นการกระชับความสัมพันธ์และแลกเปลี่ยนการเยือนของผู้บังคับบัญชาระดับสูงเพื่อสร้างความเข้าใจในระดับกองทัพระหว่างกัน 
อันจะยกระดับความสัมพันธ์ส่งเสริมความร่วมมือในการพัฒนางานด้านความมั่นคงในทุกมิติทั้งในระดับกองทัพและภูมิภาค
..........................................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๙ พฤศจิกายน ๒๕๖๖',1905,'2026-06-30 01:27:32');
INSERT INTO "press_release_content" VALUES('PR-2023-0027','กองทัพบกเปิดสอบนักเรียนเตรียมทหาร รอบโควตาเฉพาะกลุ่ม เพิ่มโอกาสให้เยาวชนเรียนดีทั่วทุกพื้นที่ 
      	กองทัพบก เปิดรับสมัครสอบคัดเลือกบุคคลพลเรือนเข้าเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบกรอบโควตาเฉพาะกลุ่ม เพื่อเพิ่มโอกาสให้เยาวชนเรียนดีในแต่ละจังหวัด, เยาวชนในถิ่นทุรกันดาร และกลุ่มเยาวชนที่เป็นบุตรของกำลังพลกองทัพบก สามารถเข้าเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบกได้อย่างทั่วถึง ซึ่งกองทัพบกได้ริเริ่มนโยบายการจัดสอบแบบเฉพาะกลุ่มมาตั้งแต่ปี ๒๕๖๔ และได้ดำเนินการมาอย่างต่อเนื่อง โดยเยาวชนที่สนใจต้องมีคุณสมบัติ เป็นนักเรียนชายที่กำลังศึกษา
ชั้นมัธยมศึกษาปีที่ ๔ ขึ้นไป อายุ ๑๖ – ๑๘ ปี สมัครได้ตั้งแต่ ๖ พ.ย.๖๖ – ๒๕ ธ.ค.๖๖ ผ่านทางเว็บไซต์ https://crma-admission.rta.mi.th โดยไม่มีค่าใช้จ่าย แบ่งออกเป็น ๓ กลุ่ม ดังนี้
	กลุ่มที่ ๑ กลุ่มโควตาจังหวัด (๗๗ นาย) : คัดเลือกจากผู้ที่ผ่านเกณฑ์การสอบคัดเลือกฯ และมีคะแนนสูงสุดของแต่ละจังหวัด จังหวัดละ ๑ นาย โดยผู้สมัครต้องมีภูมิลำเนาในจังหวัดนั้นๆ       ไม่ต่ำกว่า ๑ ปี (นับถึง ๒๔ ธ.ค.๖๖)
		กลุ่มที่ ๒ กลุ่มพื้นที่พิเศษ (๑๑ นาย) : คัดเลือกจากผู้ที่กำลังศึกษาหรือเคยศึกษาในกลุ่มโรงเรียนพื้นที่ห่างไกลทุรกันดารระดับมัธยมศึกษาจาก ๔ กลุ่มโรงเรียน ตามหลักเกณฑ์ของสำนักงานคณะกรรมการการศึกษาขั้นพื้นฐาน กระทรวงศึกษาธิการ ได้แก่ กลุ่มโรงเรียนราชประชานุเคราะห์และโรงเรียนที่มูลนิธิราชประชานุเคราะห์ในพระบรมราชูปถัมภ์ให้การสนับสนุน, กลุ่มโรงเรียนในโครงการพัฒนาเด็กและเยาวชนในถิ่นทุรกันดารตามพระราชดำริสมเด็จพระกนิษฐาธิราชเจ้า กรมสมเด็จพระเทพรัตนราชสุดาฯ สยามบรมราชกุมารี, กลุ่มโรงเรียนที่ได้รับประกาศให้เป็นสำนักงานในพื้นที่พิเศษตามประกาศกระทรวงการคลัง และกลุ่มโรงเรียนที่ตั้งในพื้นที่ลักษณะพิเศษ (โรงเรียนพื้นที่ภูเขาสูงและโรงเรียนพื้นที่เกาะ) รวมทั้งหมด ๙๙๖ โรงเรียน
		กลุ่มที่ ๓ กลุ่มบุตรกำลังพลกองทัพบก (๓๓ นาย) : คัดเลือกจากบุตรโดยชอบด้วยกฎหมายของกำลังพลกองทัพบกทุกประเภท (นายทหาร นายสิบ อาสาสมัครทหารพราน ลูกจ้าง พนักงานราชการ พลอาสาสมัคร และทหารอาสา) 
		รายละเอียดเพิ่มเติมสอบถามได้ที่กองสถิติและทะเบียนประวัติ โรงเรียนนายร้อยพระจุลจอมเกล้าในวันเวลาราชการ โทร.๐๖๓ – ๗๕๖๓๐๔๔ 
............................................................................
