INSERT INTO "press_releases" VALUES('PR-2023-0022','2023-11-03','ทบ. พร้อมช่วยเหลือคนไทยในรัฐฉาน เมียนมา กลับประเทศอย่างปลอดภัย',15,'ปกติ','ทบ. ประสานสำนักงานผู้ช่วยทูตทหารเมียนมาและจีน ช่วยคนไทย ~200 คนที่ติดอยู่ในเมืองเล้าก์ก่าย รัฐฉาน เตรียมอากาศยานรับกลับ และสั่ง ทภ.3 เฝ้าระวังชายแดน','ประสานช่วยเหลือคนไทยที่ติดในรัฐฉาน เมียนมา และเตรียมอากาศยานอพยพ','3 พ.ย. 66','661103 ทบ. พร้อมช่วยเหลือคนไทยในรัฐฉาน เมียนมา กลับประเทศอย่างปลอดภัย.docx',NULL,'ปกติ',NULL,'ebafccb916141329','3-Content/PR-2023-0022.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
