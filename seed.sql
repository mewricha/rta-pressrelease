INSERT INTO "press_release_content" VALUES('PR-2023-0014','ทบ. ร่วมกับส่วนราชการจัดกิจกรรมจิตอาสาน้อมรำลึก “พระปิยมหาราช” ณ กรมยุทธศึกษาทหารบก
เนื่องในโอกาสวันคล้ายวันสวรรคตของพระบาทสมเด็จพระจุลจอมเกล้าเจ้าอยู่หัว รัชกาลที่ ๕ “วันปิยมหาราช” ๒๓ ต.ค. ๖๖ กองทัพบกได้จัดกิจกรรมเพื่อน้อมรำลึกในพระมหากรุณาธิคุณและพระปรีชาสามารถของพระองค์ ที่ทรงปฎิบัติพระราชกรณียกิจนานัปการ ตลอดระยะเวลา ๔๒ ของการครองราชย์ 
ทั้งด้านการปกครองประเทศ การทหาร การทูต การสาธารณสุข การคมนาคมและสาธารณูปโภค โดยทรงเป็นพระมหากษัตริย์นักพัฒนาผู้ทรงเป็นที่รักยิ่งของพสกนิกรไทย สมกับพระราชสมัญญา “พระปิยมหาราช”
ซึ่งในวันนี้ (๒๐ ต.ค. ๖๖) ที่ศาลาวงกลมพระบรมราชานุสาวรีย์ ร.๕ ภายในกรมยุทธศึกษาทหารบก พลเอก สุขสรรค์ หนองบัวล่าง รองผู้บัญชาการทหารบก ผู้แทนผู้บัญชาการทหารบก เป็นประธานนำกำลังพลหน่วยขึ้นตรงกองทัพบกในพื้นที่ส่วนกลาง พร้อมจิตอาสาจากการรถไฟแห่งประเทศไทย จิตอาสาสำนักงานเขตดุสิต กทม. และประชาชนจิตอาสาในชุมชนใกล้เคียงกรมยุทธศึกษาทหารบก ร่วมประกอบพิธีถวายราชสักการะ
พระบรมราชานุสาวรีย์ ร.๕ และกล่าวน้อมรำลึกในพระมหากรุณาธิคุณอย่างพร้อมเพรียง ก่อนเริ่มกิจกรรม
จิตอาสาบำเพ็ญสาธารณประโยชน์ พัฒนาปรับปรุงภูมิทัศน์บริเวณภายในและโดยรอบกรมยุทธศึกษาทหารบก ตั้งแต่เส้นทางข้างรางรถไฟสถานีสามเสนจนถึงสี่แยกเทอดดำริ อาทิ การตัดหญ้า กำจัดวัชพืช และตกแต่งกิ่งไม้, การเก็บขยะและทำความสะอาดบริเวณพื้นผิวถนนและฟุตบาท รวมทั้งสถานที่สำคัญในชุมชน ได้แก่ ที่พักคอยและห้องน้ำผู้โดยสารของการรถไฟแห่งประเทศไทย
ทั้งนี้ หน่วยต่างๆ ของกองทัพบกยังจัดกิจกรรมจิตอาสาอย่างต่อเนื่อง โดยเฉพาะในเดือนตุลาคมที่มีวันสำคัญต่อปวงชนชาวไทยในหลายโอกาส กองทัพบกขอเชิญชวนกำลังพล ครอบครัว และประชาชนชาวไทยร่วมน้อมรำลึกในพระมหากรุณาธิคุณ และสืบสานพระราชปณิธานของพระบาทสมเด็จ
พระจุลจอมเกล้าเจ้าอยู่หัว พระปิยมหาราช ด้วยการทำความดีถวายเป็นพระราชกุศล ผ่านกิจกรรมที่หน่วยทหารและส่วนราชการในพื้นที่ได้จัดขึ้น
