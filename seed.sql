INSERT INTO "press_releases" VALUES('PR-2023-0010','2023-10-16','ทบ. ให้ความสำคัญทหารกองประจำการทุกขั้นตอน ระดมช่วยน้ำท่วมทุกพื้นที่ พร้อมบูรณาการทุกหน่วยสกัดกั้นยาเสพติด',3,'ปกติ','ผบ.ทบ. ประชุมติดตามการปฏิบัติทั่วประเทศ มอบนโยบาย 3 ด้าน: ดูแลทหารกองประจำการ (รับสมัครออนไลน์ 5,912 คน), ช่วยเหลืออุทกภัย (ยังเหลือ 20 จังหวัด), สกัดกั้นยาเสพติดชายแดน','ประชุมติดตามการปฏิบัติงานและมอบนโยบาย 3 ด้าน',NULL,'661016 (MB)ทบ. ให้ความสำคัญทหารกองประจำการทุกขั้นตอน.docx',NULL,'ปกติ',NULL,'c510f98d8aa1a2f5','3-Content/PR-2023-0010.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0011','2023-10-16','เปิดจุดเยี่ยมชมสำคัญของ รมว.กห. ในพิพิธภัณฑ์กองทัพบกเฉลิมพระเกียรติ',1,'ปกติ','กองทัพบกแนะนำจุดสำคัญในพิพิธภัณฑ์กองทัพบกเฉลิมพระเกียรติ ที่ รมว.กห. เยี่ยมชมเมื่อ 12 ต.ค. 66 ได้แก่ ห้องโหมรอนราญ ห้องจอมทัพไทย และห้องพระบารมีปกเกล้า พร้อมเชิญประชาชนเยี่ยมชม','เผยแพร่ข้อมูลพิพิธภัณฑ์กองทัพบกเฉลิมพระเกียรติ','12 ตุลาคม 2566','661016 เปิดพิพิธภัณฑ์.docx',NULL,'ปกติ',NULL,'5f89565a91912553','3-Content/PR-2023-0011.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
