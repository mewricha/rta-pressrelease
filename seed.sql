INSERT INTO "press_releases_fts" VALUES('PR-2023-0036','กองทัพบกไทย-สิงคโปร์ ร่วมฝึก Kocha Singa 2023 กำลังพล 120 นาย ที่สิงคโปร์ 27 พ.ย.-10 ธ.ค.66','ทหารไทย 120 นาย ร่วมฝึก Kocha Singa 2023 กับสิงคโปร์ ฝึกที่สิงคโปร์ 27 พ.ย.-10 ธ.ค.66','ทบ. ไทย - สิงคโปร์ ร่วมฝึกคชสีห์ ๒๐๒๓ เสริมสร้างขีดความสามารถกำลังพล พัฒนาปฏิบัติการร่วม 
	กองทัพบกดำรงนโยบายการพัฒนากำลังพลผ่านการฝึก ศึกษาอย่างต่อเนื่อง โดยเฉพาะ
การฝึกร่วม/ผสมกับกองทัพมิตรประเทศ ล่าสุด เมื่อ ๒๖ พฤศจิกายน ๒๕๖๖ กองทัพบกไทยได้ส่งกำลังพล ๑๒๐ นาย เดินทางไปร่วมการฝึกคชสีห์ ๒๐๒๓ (Kocha Singa 23) ณ ค่ายสุไหงจีโดง สาธารณรัฐสิงคโปร์ เพื่อฝึกร่วมกับกองทัพบกสิงคโปร์ ซึ่งพิธีเปิดการฝึกได้จัดขึ้นในวันที่๒๙ พฤศจิกายน ๒๕๖๖ โดยมี พลตรี วุทธยา จันทมาศ ผู้บัญชาการกองพลทหารราบที่ ๙ เป็นประธานในพิธีเปิดร่วมกับ พลจัตวา ไค เต๋อ เซี่ยน ผู้บัญชาการกองพลที่ ๓ กองทัพบกสิงคโปร์ โอกาสนี้ได้ชม นิทรรศการแสดงยุทโธปกรณ์ในการฝึก ชมห้องฝึกทดลองขับขี่ยานพาหนะทางทหาร รวมทั้งให้โอวาทและให้กำลังใจกำลังพลที่เข้ารับการฝึกด้วย
	การฝึกคชสีห์เป็นการฝึกเกี่ยวกับปฎิบัติทางยุทธวิธีในหลากหลายมิติ อาทิ การฝึกในห้องจำลองสถานการณ์, การฝึกปฏิบัติการใช้อาวุธ, การให้คำสั่งยุทธการระดับกองร้อย, การปฏิบัติการรบในสิ่งปลูกสร้าง ซึ่งจะดำเนินการฝึกเป็นระยะเวลา ๒ สัปดาห์ ตั้งแต่ ๒๗ พฤศจิกายน - ๑๐ ธันวาคม ๒๕๖๖ โดยการฝึกผสมรหัสคชสีห์จัดขึ้นเป็นประจำทุกปีตามโครงการความร่วมมือด้านการฝึกระหว่างกองทัพบกไทย - สิงคโปร์ (Counterpart) ที่เริ่มดำเนินการฝึกตั้งแต่ปี ๒๕๔๐ โดยกองทัพบกทั้งสองประเทศสลับกันเป็นเจ้าภาพ มีวัตถุประสงค์ให้กำลังพลทั้งสองประเทศได้แลกเปลี่ยนประสบการณ์และความรู้ เสริมสร้างศักยภาพและขีดความสามารถในปฎิบัติการร่วม เพื่อเป็นกำลังสำคัญในการรองรับภัยคุกคามหลากหลายรูปแบบ
	ทั้งนี้ กองทัพบกไทยและสิงคโปร์มีความสัมพันธ์อย่างแน่นแฟ้นมาอย่างยาวนาน ทั้งในรูปแบบการร่วมปฎิบัติการทางทหาร และด้านการฝึกศึกษาซึ่งที่ผ่านมามีการขยายขอบเขตการฝึกเพิ่มขึ้นอย่างต่อเนื่อง การฝึกคชสีห์ ๒๐๒๓ ในครั้งนี้เป็นโอกาสอันดีในการกระชับสัมพันธ์ของทั้งสองประเทศ 
อันจะนำมาซึ่งเสถียรภาพ และความมั่นคงในภูมิภาค 
………………………………….................
