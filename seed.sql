INSERT INTO "press_release_content" VALUES('PR-2024-0002','ทบ. เผยจุดบริการประชาชนช่วงปีใหม่ได้ผลน่าพอใจ เจ้าหน้าที่ทุกส่วนร่วมดูแลตลอด ๗ วัน พบยอดอุบัติเหตุลดลง ๖.๒๓% บาดเจ็บลดลง ๕.๓๓% และเสียชีวิตลดลง ๑๐.๔๑%		ตามที่ พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก มอบนโยบายให้หน่วยทหารกองทัพบกส่งความสุขให้ประชาชนช่วงเทศกาลส่งท้ายปีเก่าต้อนรับปีใหม่ ๒๕๖๗ ผ่านการดูแลรักษาความปลอดภัยทุกรูปแบบ ตั้งแต่พื้นที่ชั้นนอกที่มีกำลังพล ๗ กองกำลังป้องกันชายแดน จัดผลัดกำลังพลลาดตระเวนป้องปรามสิ่งผิดกฎหมายตลอด ๒๔ ชม. รวมทั้งพื้นที่ชั้นใน ที่ผู้บัญชาการทหารบกได้มีความห่วงใยประชาชนในเรื่องของการเดินทางกลับภูมิลำเนาหรือท่องเที่ยวในสถานที่ต่างๆ ผ่านการมอบหมายให้หน่วยทหารแต่ละพื้นที่ โดยเฉพาะเส้นทางสายหลักหรือที่มีการจราจรคับคั่ง สนับสนุนกำลังพลและยานพาหนะ ร่วมกับส่วนราชการและภาคประชาชนในพื้นที่ จัดตั้งจุดบริการประชาชนทั่วประเทศรวม ๘๓ จุด ตั้งแต่ ๒๙ ธ.ค.๖๖ - ๔ ม.ค.๖๗
	ซึ่งผลการปฏิบัติของจุดบริการกองทัพบกห้วง ๗ วันที่ผ่านมา มีประชาชนเข้าใช้บริการ ๗,๕๓๑ ราย มากที่สุดคือพื้นที่ภาคเหนือ รับผิดชอบโดยกองทัพภาคที่ ๓ และส่วนใหญ่เป็นการแวะพักผ่อน รับประทานเครื่องดื่ม ใช้บริการห้องสุขา รวมถึงการสอบถามเส้นทางในพื้นที่ โดยภาพรวมเป็นที่น่าพอใจ ประชาชนสามารถเข้าถึงจุดบริการได้อย่างสะดวก และกองทัพบกสามารถสนับสนุนศูนย์อำนวยการป้องกันและลดอุบัติเหตุทางถนน กระทรวงมหาดไทย ลดอุบัติเหตุจากปี ๒๕๖๖ ได้ ๖.๒๓%  ผู้บาดเจ็บลดลง ๕.๓๓% และอัตราการเสียชีวิตลดลง ๑๐.๔๑% 
	ทั้งนี้ กองทัพบกขอขอบคุณกำลังพลทุกนาย ตลอดจนครอบครัว รวมถึงภาคีต่างๆ ส่วนราชการในพื้นที่ ที่ได้ร่วมเสียสละช่วงเวลาห้วงวันหยุดยาว ปฏิบัติภารกิจที่ได้รับมอบ ดูแลความปลอดภัยให้ประชาชน ส่งความสุขรับปีใหม่ ๒๕๖๗ พร้อมกันนี้ ผู้บัญชาการทหารบกได้มอบนโยบายให้ผู้บังคับหน่วย บริหารจัดการดูแลสิทธิและสวัสดิการกำลังพลผู้ปฏิบัติงานในห้วงดังกล่าว โดยให้มีการชดเชยห้วงวันลาพักตามเหมาะสม เพื่อสร้างขวัญและกำลังใจให้กับกำลังพลและครอบครัวต่อไป
