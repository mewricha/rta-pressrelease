INSERT INTO "press_releases_fts" VALUES('PR-2023-0039','กองทัพบก เปิดสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติด 33 แห่งทั่วประเทศ ปรับรูปแบบเป็นสมัครใจ','ทบ. เปิดสถานฟื้นฟูยาเสพติด 33 แห่ง ปรับจากบังคับเป็นสมัครใจ คัดกรองจาก สธ. ตั้งแต่ปี 2546 มีผู้เข้ารับกว่า 182,000 ราย','ทบ. เปิดสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติด พร้อมเตรียมจัดตั้งศูนย์พักคอย 
ก่อนส่งต่อผู้ป่วย สนับสนุนรัฐบาล มอบโอกาส สร้างคนดี มีวินัย คืนสู่สังคม
ตามที่รัฐบาลได้กำหนดให้ยาเสพติดเป็นวาระแห่งชาติ และเป็นนโยบายเร่งด่วนที่ให้ทุกภาคส่วนบูรณาการร่วมกันในการแก้ไขปัญหา ทั้งการสกัดกั้นการลักลอบข้ามแดน การนำพาเข้าสู่พื้นที่ตอนใน ตลอดจนการจับกุมผู้ค้า รักษาบำบัดฟื้นฟูผู้เสพ เพื่อมอบโอกาสให้กลับคืนสู่สังคม ซึ่งกองทัพบกได้ตระหนักในเรื่องนี้ และปฏิบัติภารกิจที่เกี่ยวข้องมาอย่างต่อเนื่อง ทั้งการป้องกันและสกัดกั้นตามแนวชายแดนโดยกองกำลังป้องกันชายแดน, การประสานร่วมกับฝ่ายปกครองตั้งจุดตรวจจุดสกัดตามพื้นที่เสี่ยงหรือพื้นที่เพ่งเล็ง รวมทั้งการสนับสนุนกระทรวงสาธารณสุข ในการนำศักยภาพของโรงพยาบาลทหารดูแลรักษาประชาชน ผู้เสพ/ผู้ติดยาเสพติด หรือผู้ป่วย ตลอดจนการนำสถานที่ของหน่วยทหารทั่วประเทศรวม ๓๓ แห่ง จัดตั้งเป็นศูนย์วิวัฒน์พลเมืองกองทัพบก เพื่อดูแลบำบัดรักษาในรูปแบบระบบบังคับบำบัด ซึ่งตั้งแต่ปี ๒๕๔๖ มีผู้เข้ารับการบำบัดแล้วรวมทั้งสิ้น ๑๘๑,๐๐๐ ราย 
ล่าสุดเพื่อให้ตอบสนองตามนโยบายของรัฐบาล และเพิ่มประสิทธิภาพในการรองรับผู้บำบัดในพื้นที่ต่างๆ ทั่วประเทศ พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก สั่งการให้ศูนย์วิวัฒน์พลเมืองกองทัพบกทุกแห่ง พิจารณาผลการดำเนินงานของหน่วยในห้วงที่ผ่านมา ทั้งครูฝึก, ผู้บำบัด, สถานที่ในการจัดกิจกรรม ตลอดจนการประเมินผลจากครอบครัวและชุมชนของผู้บำบัด เพื่อเพิ่มขีดความสามารถของศูนย์ ปรับเป็นสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติด ตามประมวลกฎหมายยาเสพติด พ.ศ. ๒๕๖๔ เปลี่ยนรูปแบบการรับเข้าจากระบบบังคับเป็นสมัครใจ เพื่อสอดคล้องตามกฎหมายและรองรับผู้บำบัดได้อย่างครอบคลุม ทั้งผู้ป่วยที่สมัครใจ (มาตรา ๑๑๓), ผู้ป่วยจากการพบโดยตำรวจหรือฝ่ายปกครอง (มาตรา ๑๑๔), ผู้ป่วยส่งมาตามความคิดเห็นของผู้พิพากษาที่เห็นสมควรให้รับการบำบัด (มาตรา ๑๖๘) และผู้ป่วยที่เข้ารับการบำบัดฟื้นฟูแทนการลงโทษ (มาตรา ๑๖๖) ซึ่งทุกรายจะต้องผ่านการคัดกรองจากศูนย์คัดกรองและสถานพยาบาลของกระทรวงสาธารณสุข ว่าเห็นสมควรให้เข้ารับการบำบัดต่อยังสถานฟื้นฟูสมรรถภาพผู้ติดยาเสพติดฯ โดยจะมีครูฝึกซึ่งเป็นกำลังพลของหน่วยที่ได้รับการอบรมเสริมสร้างความรู้ในการดูแล ตั้งแต่การดำเนินชีวิตประจำวัน, การทำกิจกรรมกลุ่มเพื่อสร้างปฏิสัมพันธ์ร่วมในสังคม รวมทั้งการอบรมเพิ่มทักษะวิชาชีพ ตลอดจนสร้างส่วนร่วมของครอบครัวผู้บำบัด ให้ได้วางแผนการดูแลร่วมกัน เพื่อให้ผู้บำบัดมีสุขภาพร่างกายแข็งแรง มีวินัย และพร้อมกลับคืนสู่สังคม เพื่อดำรงชีวิตอย่างปกติสุขและไม่กลับไปยุ่งเกี่ยวกับยาเสพติดอีกต่อไป
นอกจากนี้ เพื่อเพิ่มการดูแลรักษาผู้ป่วยที่ใช้สารเสพติด โดยให้นำเข้าสู่ระบบได้โดยเร็ว 
ผู้บัญชาการทหารบก ยังได้มอบหมายให้กรมแพทย์ทหารบก พิจารณาโรงพยาบาลในสังกัด จัดตั้งเป็นศูนย์
พักคอยกองทัพบก เพื่อดูแลผู้ที่มีอาการทางจิตเวชจากการใช้สารเสพติดในกลุ่มสีส้ม และรอเข้ารับ
การบำบัดรักษาในสถานพยาบาลยาเสพติดหรือโรงพยาบาลจิตเวชในสังกัดกระทรวงสาธารณสุข โดยจะนำร่องระยะแรก ห้วง ธ.ค.๖๖ - ก.พ.๖๗ ในการใช้โรงพยาบาลทหารในพื้นที่ที่ไม่มีที่ตั้งของสถานพยาบาลหรือโรงพยาบาลจิตเวช เปิดเป็นศูนย์พักคอยรวม ๔๐ เตียง ใน ๔ พื้นที่ ได้แก่ 
รพ.ค่ายจักรพงษ์ จ.ปราจีนบุรี, รพ.ค่ายสุรนารี จ.นครราชสีมา, รพ.ค่ายสรรพสิทธิประสงค์ 
จ.อุบลราชธานี และ รพ.ค่ายสุรสีห์ จ.กาญจนบุรี เพื่อเป็นต้นแบบในการดำเนินงานก่อนจะขยายผลไปยังพื้นที่อื่นๆ ต่อไป ซึ่งหากส่วนราชการ ภาคเอกชนและประชาชน ต้องการประสานขอรับการสนับสนุนในเรื่องดังกล่าว สามารถติดต่อหน่วยทหารในพื้นที่ได้ในทันที 
