INSERT INTO "press_releases_fts_content" VALUES(26,'PR-2023-0023','ผบ.ทบ. เยี่ยมให้กำลังใจทหารใหม่ มอบแนวทางฝึกอย่างปลอดภัย ใส่ใจเหมือนครอบครัว','ผบ.ทบ. เยี่ยมทหารใหม่ผลัดที่ 2/2566 ณ พัน.ปตอ.5 กรม.ปตอ.1 กรุงเทพฯ มอบแนวทางฝึกปลอดภัย พัฒนาระบบฝึกทันสมัย ตรวจความเป็นอยู่','ผบ.ทบ. เยี่ยมให้กำลังใจทหารใหม่ มอบแนวทางฝึกอย่างปลอดภัย ใส่ใจเหมือนครอบครัว
วันนี้ (๔ พ.ย.๖๖) เวลา ๑๑.๐๐ น. พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก พร้อมคณะผู้บังคับบัญชา เดินทางไปเยี่ยมให้กำลังใจการฝึกทหารใหม่ผลัดที่ ๒/๒๕๖๖ ณ กองพันทหารปืนใหญ่ต่อสู้อากาศยานที่ ๕ กรมทหารปืนใหญ่ต่อสู้อากาศยานที่ ๑ ถ.แจ้งวัฒนะ กทม. โดยมี พันโท ธนธัช เลิศธโนทัย ผู้บังคับกองพัน ให้การต้อนรับ ซึ่งทหารใหม่ที่มารายงานตัวเมื่อวันที่ ๑ และ ๓ พ.ย.๖๖ ได้ผ่านกรรมวิธีรับทหารใหม่ อาทิ การทำประวัติ, การตรวจร่างกายและคัดกรองโรค, การประเมินสุขภาพจิต, การแจกจ่ายเครื่องแต่งกายประจำตัว และแนะนำช่องทางการติดต่อกับครอบครัวระหว่างการฝึก ซึ่งขณะนี้ทหารใหม่ผลัดที่ ๒/๒๕๖๖ อยู่ในขั้นตอนการเตรียมการฝึก ก่อนเข้าสู่การฝึกทหารใหม่เบื้องต้น ระยะเวลา ๖ สัปดาห์ เพื่อปรับสภาพจากพลเรือนสู่ทหาร ทั้งด้านร่างกายและระเบียบวินัยทางทหาร
สำหรับการตรวจเยี่ยมในครั้งนี้ เป็นไปตามความตั้งใจของผู้บัญชาการทหารบกที่ต้องการเดินทางมาพบปะให้กำลังใจเจ้าหน้าที่หน่วยฝึกและทหารใหม่อย่างไม่เป็นทางการ เพื่อคลายความกังวลและเพิ่มความเชื่อมั่นให้กับน้องคนเล็กของครอบครัวกองทัพบก รวมทั้งผู้ปกครองทหารใหม่ โดยผู้บัญชาการทหารบกได้มอบแนวทางให้ดูแลใส่ใจทหารใหม่อย่างใกล้ชิด พัฒนาระบบการฝึกให้ทันสมัยเหมาะสมกับสภาพสังคมในปัจจุบัน ดำเนินการฝึกจากเบาไปหาหนัก พิจารณาสภาพความพร้อมของร่างกายทหารใหม่เป็นรายบุคคล รวมทั้งดูแลการแต่งกายให้เหมาะสมกับสภาวะแวดล้อม เพื่อไม่ให้เกิดการสูญเสียในการฝึก และเมื่อฝึกจบแล้ว ต้องมีการประเมินผลการฝึก เพื่อปรับปรุงพัฒนาให้ดียิ่งขึ้น จากนั้นผู้บัญชาการทหารบกได้เยี่ยมชมความเป็นอยู่ของทหารใหม่ ณ โรงนอน, ห้องฝึกอบรม และระบบสุขาภิบาล ก่อนที่จะเดินทางไปยังโรงประกอบเลี้ยง เพื่อรับประทานอาหารกลางวันร่วมกับทหารใหม่และกำลังพลในหน่วยฝึกด้วยความใกล้ชิด
