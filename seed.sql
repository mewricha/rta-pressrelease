INSERT INTO "press_releases_fts_content" VALUES(71,'PR-2024-0011','ทบ. ร่วมกับเซ็นทรัลกรุ๊ป จัดกิจกรรม Million Gifts Million Smiles ปีที่ 14 มอบของขวัญ 20,000 ชิ้น แก่เด็ก จชต.','ผบ.ทบ. ร่วมเซ็นทรัลกรุ๊ป จัดกิจกรรม Million Gifts Million Smiles ปีที่ 14 มอบของขวัญ 20,000 ชิ้น ทุนการศึกษา 217 ทุน (542,000 บาท) แก่เด็ก จชต.','ทบ. ร่วมเซ็นทรัลกรุ๊ป สานต่อโครงการ Million Gifts Million Smiles ปีที่ ๑๔ ของขวัญจากใจมอบให้เด็กๆ ชายแดนใต้
	ภารกิจวันที่ ๒ (๑๑ ม.ค.๖๗) ในพื้นที่จังหวัดชายแดนภาคใต้ ของ พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก นอกจากการเดินทางไปตรวจเยี่ยมให้กำลังใจมอบของขวัญและอวยพรปีใหม่ให้กำลังพล
หน่วยเฉพาะกิจกรมทหารพรานที่ ๔๗ อ.ยะหา จ.ยะลา แล้ว ผู้บัญชาการทหารบกยังได้เดินทางไปพบปะกับคุณบุษบา จิราธิวัฒน์ รองกรรมการผู้จัดการใหญ่ ฝ่ายสื่อสารองค์กร กลุ่มเซ็นทรัล และ คุณสมกมล จิราธิวัฒน์ ผู้อำนวยการอาวุโส 
กลุ่มเซ็นทรัล พร้อมร่วมเปิดกิจกรรม Million Gifts Million Smiles ที่สนามฟุตซอลนาควานิช ค่ายสิรินธร จ.ปัตตานี โดยมี พลโท ศานติ สกุนตนาค แม่ทัพภาคที่ ๔ ให้การต้อนรับ 
	สำหรับ Million Gifts Million Smiles เป็นกิจกรรมที่กองทัพบกได้ร่วมกับเครือเซ็นทรัลกรุ๊ป 
มีวัตถุประสงค์เพื่อส่งมอบความสุขผ่านของขวัญ รวมทั้งสร้างโอกาส ความเสมอภาคและความเท่าเทียมให้กับเด็กๆ ในพื้นที่จังหวัดชายแดนภาคใต้ ผ่านแนวคิด “FROM THE HEARTS TO THE SMILES ของขวัญจากใจเพื่อรอยยิ้มของทุกคน” โดยกองทัพบกและภาคีเครือข่ายได้ร่วมดำเนินการจัดหาและรวบรวมสิ่งของ อาทิ อุปกรณ์การเรียน และกีฬา, รถจักรยาน, สิ่งของเครื่องใช้, ตุ๊กตาและของเล่น จากหน่วยทหาร และประชาชนที่ได้มาร่วมบริจาคผ่านช่องทาง
ที่เครือเซ็นทรัลกรุ๊ปได้จัดขึ้น ตลอดจนสนับสนุนยานพาหนะทางทหารเพื่อนำไปส่งมอบให้กับเยาวชนในพื้นที่จังหวัดชายแดนภาคใต้ ซึ่งปีนี้มีของขวัญกว่า ๒๐,๐๐๐ ชิ้น และทุนการศึกษาเตรียมส่งมอบให้กับเด็กๆ รวม ๒๑๗ ทุน เป็นเงิน ๕๔๒,๐๐๐ บาท
	โอกาสนี้ผู้บัญชาการทหารบกได้มอบของที่ระลึกเพื่อแทนคำขอบคุณจากกองทัพบกให้กับผู้บริหารกลุ่มเซ็นทรัล รวมทั้งร่วมมอบของขวัญและไอศกรีมให้กับตัวแทนเด็กๆ ในพื้นที่จังหวัดชายแดนใต้ที่มาร่วมกิจกรรม พร้อมกล่าวอวยพรให้กำลังใจเด็กๆ ขอให้มีความสุขสนุกสนาน เล่นและเรียนรู้ พัฒนาเติบโตอย่างสมวัย เพื่อเป็นกำลังสำคัญในการร่วมทำประโยชน์เพื่อสังคม ตลอดจนร่วมปล่อยขบวนรถคาราวานของขวัญนำส่งให้หน่วยทหารในแต่ละพื้นที่ เพื่อเตรียมมอบให้เด็กๆ ในกิจกรรมวันเด็กแห่งชาติ และส่งมอบไปยังชุมชนต่างๆ ในจังหวัดชายแดนภาคใต้ 
	กองทัพบกให้ความสำคัญในการพัฒนาเยาวชน ซึ่งเป็นอนาคตของชาติ ผ่านโครงการและกิจกรรมต่างๆ อย่างสม่ำเสมอ โดยเฉพาะในงานวันเด็กแห่งชาติที่จะถึงนี้ ที่กองทัพบกมีการจัดกิจกรรมทั้งในพื้นที่ กทม. และ
ส่วนภูมิภาคทั่วประเทศ จึงขอเชิญชวนเยาวชนมาเที่ยวชมงานวันเด็กของหน่วยทหารกองทัพบก พร้อมน้อมนำ
พระบรมราโชวาท ในพระบาทสมเด็จพระวชิรเกล้าเจ้าอยู่หัว เนื่องในโอกาสวันเด็กแห่งชาติ ๒๕๖๗ เป็นหลักในการดำเนินชีวิต รวมทั้งสร้างสรรค์สิ่งที่ดี เพื่อความสุขและประโยชน์ส่วนรวมต่อไป
……………………………………
