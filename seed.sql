INSERT INTO "press_releases_fts_content" VALUES(9,'PR-2023-0006','หน่วยทหารกองทัพบกจัดกิจกรรม "วันนวมินทรมหาราช" พร้อมกันทั่วประเทศ รวมพลังทำความดี สืบสานพระราชปณิธานในหลวงรัชกาลที่ 9','ผบ.ทบ. ดำริให้หน่วยทหารทั่วประเทศจัดกิจกรรมน้อมรำลึก ร.9 เนื่องในวันนวมินทรมหาราช 13 ต.ค. 66 (ครบ 7 ปีสวรรคต) รวมถึง รด.จิตอาสา 3 แสนนายจัดกิจกรรมพร้อมกันทั่วประเทศ','หน่วยทหารกองทัพบกจัดกิจกรรม “วันนวมินทรมหาราช” พร้อมกันทั่วประเทศ รวมพลังทำความดี สืบสานพระราชปณิธานในหลวงรัชกาลที่ ๙
กองทัพบกจัดกิจกรรมน้อมรำลึกในพระมหากรุณาธิคุณ พระบาทสมเด็จ                           พระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร เนื่องในวันคล้ายวันสวรรคต 
๑๓ ตุลาคม ๒๕๖๖ โดยในปีนี้สำนักงานปลัดสำนักนายกรัฐมนตรีมีหนังสือแจ้งให้ทราบว่า 
พระบาทสมเด็จพระเจ้าอยู่หัว ทรงพระกรุณาโปรดเกล้าโปรดกระหม่อมให้กำหนดชื่อวันคล้ายวันสวรรคตพระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร ๑๓ ตุลาคม ของทุกปีเป็น “วันนวมินทรมหาราช” มีความหมายว่า วันที่ระลึกถึงพระมหาราชรัชกาลที่ ๙ ผู้ยิ่งใหญ่ และปี ๒๕๖๖ นี้เป็นปีแห่งการสวรรคตครบ ๗ ปี หรือ “สัตตมวรรษ”
ทั้งนี้กองทัพบกซึ่งเป็นหน่วยงานด้านความมั่นคงหลักในการปกป้อง ชาติ ศาสน์ กษัตริย์และประชาชน มีความสำนึกในพระมหากรุณาธิคุณของสถาบันพระมหากษัตริย์ ที่ได้ทรงทำนุบำรุงบ้านเมืองให้เจริญก้าวหน้า ร่มเย็นเป็นสุข และเป็นศูนย์รวมจิตใจของปวงชนชาวไทยจวบจนปัจจุบัน โดยในปีนี้ 
พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ดำริให้หน่วยทหารทั่วประเทศ ทั้งส่วนกลางและ                ส่วนภูมิภาคจัดกิจกรรมน้อมรำลึกในพระมหากรุณาธิคุณ ควบคู่กับการจัดกิจกรรมจิตอาสา สืบสาน
พระราชปณิธาน รวมพลังทำความดี ถวายเป็นพระราชกุศลพร้อมเพรียงกันทั่วประเทศ โดยหนึ่งในกิจกรรมที่สำคัญคือ “กิจกรรม รด.จิตอาสา ๓ แสนนาย ทำความดีด้วยหัวใจ ถวายเป็นพระราชกุศล” 
โดยนักศึกษาวิชาทหารกว่า ๓ แสนนาย ทำกิจกรรมจิตอาสาในหลากหลายรูปแบบร่วมกับส่วนราชการพร้อมกันทั่วประเทศ อาทิ บริจาคโลหิต ทำความสะอาด พัฒนาภูมิทัศน์ชุมชน โรงเรียน วัด ศาสนสถาน โรงพยาบาล พร้อมมอบสิ่งของให้ผู้ยากไร้และผู้ด้อยโอกาส พัฒนาแหล่งน้ำ คูคลอง และทางระบายน้ำกำจัดผักตบชวาและวัชพืช กำจัดแหล่งเพาะพันธุ์ยุงลาย ปล่อยพันธุ์ปลาลงในแหล่งน้ำ และ
ปลูกป่าชายเลนร่วมกัน
สำหรับกิจกรรมสำคัญในพื้นที่ส่วนกลาง ณ กองบัญชาการกองทัพบก เตรียมจัดใน
๑๒ ต.ค.๒๕๖๖ นำโดยผู้บัญชาการทหารบก พร้อมด้วยผู้บังคับบัญชา และกำลังพลทุกระดับชั้น 
กระทำพิธีทำบุญตักบาตรพระสงฆ์ ๘๙ รูป พิธีวางพวงมาลา พิธีสวดพระพุทธมนต์ และกิจกรรมบริจาคโลหิตถวายเป็นพระราชกุศล ซึ่งหน่วยทหารทั่วประเทศจะจัดกิจกรรมที่สืบเนื่องและสอดรับกัน โดยมีกิจกรรมที่สำคัญ อาทิ
พื้นที่กองทัพภาคที่ ๑ หน่วยทหารร่วมกับส่วนราชการในพื้นที่จัดพิธีวางพวงมาลาถวายสักการะ ณ พระบรมราชานุสาวรีย์รัชกาลที่ ๙ ค่ายภูมิพล จ.ลพบุรี และจัดกิจกรรมจิตอาสา แจกถุง
ยังชีพในชุมชนเขตป้อมปราบศัตรูพ่าย
พื้นที่กองทัพภาคที่ ๒  จัดพิธีตักบาตรถวายเป็นพระราชกุศล ณ พุทธศาสนสถาน 
ค่ายสุรนารี และพิธีวางพวงมาลาน้อมรำลึกในพระมหากรุณาธิคุณ
พื้นที่กองทัพภาคที่ ๓ จัดกิจกรรมจิตอาสาบำเพ็ญสาธารณประโยชน์ พัฒนาภูมิทัศน์
วัดอรัญญิก อ.เมือง จ.พิษณุโลก และกิจกรรมบริจาคโลหิตถวายเป็นพระราชกุศล
พื้นที่กองทัพภาคที่ ๔ ร่วมกับส่วนราชการจัดกิจกรรม "ปลูกป่าเนื่องในวันนวมินทร
มหาราช" ณ ศูนย์อำนวยการและประสานการพัฒนาพื้นที่ลุ่มน้ำปากพนังอันเนื่องมาจากพระราชดำริ 
อ.ปากพนัง จ.นครศรีธรรมราช
นอกจากนี้ได้มีการจัดแสดงนิทรรศการเผยแพร่พระราชประวัติและพระราชกรณียกิจ
ที่สำคัญ ควบคู่กับกิจกรรมสวดมนต์เจริญจิตตภาวนา กิจกรรมช่วยเหลือประชาชนผู้ยากไร้
และผู้ด้อยโอกาส ซึ่งหน่วยทหารได้มีการปฏิบัติมาอย่างต่อเนื่อง อันเป็นจุดเริ่มต้นในการสร้างการรับรู้ สร้างสังคมน่าอยู่ มีจิตสาธารณะ เสียสละ อุทิศตนเพื่อประโยชน์ส่วนรวมตามพระราชปณิธาน
ทั้งนี้กองทัพบกขอเชิญชวนกำลังพล ครอบครัว และประชาชนทุกหมู่เหล่า ร่วมกิจกรรมเนื่องใน “วันนวมินทรมหาราช” ร่วมกับหน่วยทหารและส่วนราชการในพื้นที่ เพื่อแสดงพลังแห่งความจงรักภักดี ร่วมทำความดี บำเพ็ญสาธารณประโยชน์ ถวายเป็นพระราชกุศลแด่ในหลวงรัชการที่ ๙
น้อมสำนึกในพระมหากรุณาธิคุณอันหาที่สุดมิได้ ตลอดห้วงเดือนตุลาคมนี้
............................................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๙ ตุลาคม ๒๕๖๖');
INSERT INTO "press_releases_fts_content" VALUES(10,'PR-2023-0007','ทบ. เดินหน้าตรวจสอบกรณีน้ำมันเชื้อเพลิง คงมาตรการตรวจสอบในองค์กรอย่างเข้มงวด','ผบ.ทบ. สั่งพักราชการชั่วคราว เจ้ากรมสรรพาวุธ ทบ. และกำลังพลที่เกี่ยวข้องอีก 4 นาย จากกรณีพบความผิดปกติในการเบิกจ่ายน้ำมันเชื้อเพลิง หน่วยทหารพื้นที่ จ.สระบุรี','ทบ. เดินหน้าตรวจสอบกรณีน้ำมันเชื้อเพลิง คงมาตรการตรวจสอบในองค์กรอย่างเข้มงวด
ตามที่ผู้บัญชาการทหารบกได้แต่งตั้งให้คณะกรรมการตรวจสอบ กรณีพบความผิดปกติ
ในการเบิกจ่ายน้ำมันของหน่วยทหารในพื้นที่ จ.สระบุรี นั้น ล่าสุดคณะกรรมการได้มีการรายงานผล
การสอบขั้นต้นให้ผู้บังคับบัญชาตามลำดับชั้นได้รับทราบ โดยพบว่ากระบวนการเบิกจ่ายน้ำมันเชื้อเพลิงในกรมสรรพาวุธทหารบก มีข้อมูลบ่งชี้ว่ามีการดำเนินการที่เกิดความบกพร่อง และไม่เป็นไปตามระเบียบของทางราชการ ซึ่งคณะกรรมการยังต้องมีการตรวจสอบข้อมูลจากพยานบุคคลและพยานหลักฐานเพิ่มเติม
อีกหลายรายการ ทั้งนี้เพื่ออำนวยความยุติธรรมและเอื้อต่อกระบวนการตรวจสอบข้อเท็จจริงเพิ่มเติม 
พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ได้มีคำสั่งให้เจ้ากรมสรรพาวุธทหารบก และกำลังพลที่เกี่ยวข้องอีก ๔ นาย พ้นจากตำแหน่งหน้าที่เป็นการชั่วคราว โดยให้ไปปฏิบัติราชการที่กองบัญชาการกองทัพบก 
และได้ทำหนังสือนำเรียนรัฐมนตรีว่าการกระทรวงกลาโหมขออนุมัติแต่งตั้งรองเจ้ากรมสรรพาวุธทหารบก 
เป็นรักษาราชการแทนเจ้ากรมสรรพาวุธทหารบก เพื่อให้เกิดความต่อเนื่องในการปฏิบัติราชการใน
กรมสรรพาวุธทหารบกต่อไป
ทั้งนี้ขอเรียนว่ากองทัพบกให้ความสำคัญกับการควบคุมยุทโธปกรณ์และสิ่งอุปกรณ์
ทุกประเภท ให้เป็นไปตามระเบียบราชการ รวมถึงยังคงมาตรการการตรวจสอบภายในองค์กรอย่างเข้มงวด เพื่อให้ยุทโธปกรณ์มีความพร้อมในการปฏิบัติงานด้านความมั่นคงและการพัฒนาประเทศต่อไป
............................................................................
