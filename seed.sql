INSERT INTO "press_release_content" VALUES('PR-2024-0005','การฝึกทหารใหม่ผลัดที่ ๒/๖๖ เป็นที่น่าพอใจ ไม่มีใครเสียชีวิตจากโรคลมร้อน
	จากนโยบายด้านการฝึกทหารใหม่ของ พลเอกเจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ที่มุ่งเน้นให้จัดการฝึกปรับสภาพจากพลเรือนสู่ความเป็นทหารที่มีระเบียบวินัยและความแข็งแรงของร่างกายแบบค่อยเป็นค่อยไป พิจารณาการฝึกให้เหมาะสมกับสภาพร่างกายของทหารแต่ละนาย โดยกำหนดเป้าหมายสำคัญในการฝึกทหารใหม่ผลัดนี้ คือไม่ให้มีการบาดเจ็บและเสียชีวิตจากการฝึก 
	ซึ่งกรมยุทธศึกษาทหารบกในฐานะหน่วยกำกับดูแลหลักในการฝึกทหารใหม่ในภาพรวมของกองทัพบก ได้จัดตั้งศูนย์อำนวยการและกำกับดูแลการฝึกทหารใหม่ขึ้น เพื่อขับเคลื่อนนโยบายสู่การปฏิบัติที่เป็นรูปธรรม โดยมีหน่วยที่เกี่ยวข้องในการสนับสนุนฝึกทหารใหม่ ได้แก่ กรมแพทย์ทหารบก, กรมกําลังพลทหารบก, กรมยุทธการทหารบก, กรมกิจการพลเรือนทหารบก, และสํานักพระธรรมนูญทหารบก 
	สำหรับการดำเนินการที่สำคัญของศูนย์อำนวยการและกำกับดูแลการฝึกทหารใหม่ เริ่มจากรวบรวมข้อมูลของทหารใหม่แต่ละนายในด้านต่าง ๆ ได้แก่ การศึกษา, ครอบครัว, ฐานะทางบ้าน, ผลการคัดกรองปัจจัยเสี่ยงต่อการเกิดการเจ็บป่วยจากความร้อน, ผลการประเมินสุขภาวะทางจิต นำมาเป็นข้อมูลในการวางแผน และจัดการฝึกให้เหมาะสม  พร้อมทั้งมีการประชุมติดตามสถานการณ์ประจำวันและการให้คำแนะนำจากผู้เชี่ยวชาญด้านการดูแลสุขภาพร่างกาย และสภาวะจิตใจอย่างใกล้ชิด 
	ล่าสุดกรมยุทธศึกษาทหารบก ได้สรุปผลการดำเนินการของศูนย์ฯ ในการกำกับดูแลการฝึกทหารใหม่ในผลัดที่ ๒/๖๖ ที่ผ่านมา พบว่าไม่มีทหารใหม่เจ็บป่วยจากโรคลมร้อน ,ให้คำปรึกษาด้านสุขภาวะทางจิตความเครียดจำนวน ๑.๒๓๑ ราย ,ให้การช่วยเหลือครอบครัวทหารใหม่ อาทิ การซ่อมแซมบ้านเรือน, ดูแลบุพการีและภรรยาหลังคลอดบุตร จำนวน ๒๐๖ ราย อีกทั้งได้ยังได้ส่งเสริมด้านการศึกษาของทหารใหม่ให้มีการศึกษาสูงขึ้นในแต่ละระดับชั้น ได้แก่ จัดครูฝึก,เพื่อนทหารที่จบปริญญาตรีหรือครูสำนักงานส่งเสริมการเรียนรู้ให้สอนหนังสือให้กับทหารใหม่ที่อ่านไม่ออกและเขียนไม่ได้ โดยจะมีการประเมินผลเป็นรายบุคคล และส่งต่อข้อมูลให้กองร้อยและกองพันต้นสังกัด เพื่อให้นำไปสมัครทดสอบความรู้ของสำนักงานส่งเสริมการเรียนรู้ และสามารถเรียนต่อด้วยวุฒิการศึกษา เพื่อก้าวสู่การเป็นทหารอาชีพ, มีลำดับการศึกษาที่สูงขึ้นเพื่อใช้ประกอบอาชีพภายหลังปลดประจำการ เพื่อสามารถทำคุณประโยชน์ต่อสังคมและประเทศชาติในอนาคตต่อไป
