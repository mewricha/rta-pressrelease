INSERT INTO "press_releases" VALUES('PR-2025-0001','2025-10-02','กองทัพบกแต่งตั้ง "พลโท บุญสิน พาดกลาง" เป็นที่ปรึกษาผู้บัญชาการทหารบก นำประสบการณ์เสริมสร้างความมั่นคงของกองทัพ',1,'ปกติ','กองทัพบกออกคำสั่งแต่งตั้ง พลโท บุญสิน พาดกลาง (นายทหารนอกราชการ) เป็นที่ปรึกษา ผบ.ทบ. เพื่อนำประสบการณ์ด้านความมั่นคงมาสนับสนุนภารกิจกองทัพ','แต่งตั้งที่ปรึกษา ผบ.ทบ.','2025-10-01','681002 ผบ.ทบ. เซ็นตั้ง พลโท บุญสิน เป็นที่ปรึกษา.docx','65','ปกติ',NULL,'520161ae0f23a784','3-Content/PR-2025-0001.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2025-0002','2025-10-04','กองทัพบกชี้แจงข้อเท็จจริง "ปราสาทคนา" ยันไม่มีการรุกล้ำพื้นที่ชายแดน',2,'ปกติ','โฆษก ทบ. ชี้แจงกรณีปราสาทคนา (อ.กาบเชิง จ.สุรินทร์) ยืนยันไม่มีการรุกล้ำ พื้นที่อยู่ในการดูแลของฝ่ายไทย และเตรียมจัดระเบียบพื้นที่ชายแดนให้เหมาะกับสถานการณ์','ชี้แจงข้อเท็จจริงกรณีปราสาทคนา','79','681004 ทบ. แจงข้อเท็จจริงปราสาทคนา.docx','65','ปกติ',NULL,'d01238662479e65d','3-Content/PR-2025-0002.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2025-0003','2025-10-14','สมเด็จเจ้าฟ้าฯ กรมพระศรีสวางควัฒน วรขัตติยราชนารี พระราชทานพระวโรกาสให้ผู้บัญชาการทหารบกและคณะ เข้าเฝ้าถวายรายงานโครงการสนับสนุน "กองทุนหทัยทิพย์" กองทัพบก',3,'ปกติ','ผบ.ทบ. และคณะเข้าเฝ้าฯ ถวายรายงานโครงการกองทัพบกสนับสนุน "กองทุนหทัยทิพย์" เพื่อจัดสร้างและปรับปรุงที่กำบังและหลุมหลบภัยแก่กำลังพลและประชาชนพื้นที่ชายแดนไทย-กัมพูชา','เข้าเฝ้าฯ ถวายรายงานโครงการกองทุนหทัยทิพย์','89','681014 ผบ.ทบ. เข้าเฝ้า 906.docx','65','ปกติ',NULL,'fb7bafddb48583a6','3-Content/PR-2025-0003.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0001','2023-10-04','กองทัพบกตั้งทีมโฆษก เน้นการประชาสัมพันธ์ ให้ข้อเท็จจริงอย่างถูกต้อง รวดเร็ว สร้างความเชื่อมั่นและเสริมภาพลักษณ์ที่ดีต่อกองทัพ',3,'ปกติ','ผบ.ทบ. ลงนามคำสั่งแต่งตั้งทีมโฆษก ทบ. ชุดใหม่ มี กรมกิจการพลเรือน ทบ. รับผิดชอบการประชาสัมพันธ์ภาพรวม ทีมโฆษกรับคำสั่งจาก ผบ.ทบ. โดยตรง','แต่งตั้งทีมโฆษกกองทัพบก',NULL,'661004 ทบ. ตั้งทีมโฆษก เน้นการประชาสัมพันธ์.docx',NULL,'ปกติ',NULL,'c1a800245b4e44f4','3-Content/PR-2023-0001.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0002','2023-10-06','กองทัพบกเร่งตรวจสอบข้อมูลสนามยิงปืน นรด. พร้อมให้ข้อมูลและสนับสนุนการปฏิบัติของเจ้าหน้าที่ตำรวจ',5,'ปกติ','ทบ. ชี้แจงกรณีสนามยิงปืน นรด. เกี่ยวข้องกับคดีกราดยิงสยามพารากอน (3 ต.ค. 66) ยืนยันผู้ต้องหาไม่ใช่สมาชิก ไม่พบในกล้องวงจรปิด และกำลังตรวจสอบเจ้าหน้าที่เพื่อรวบรวมข้อมูลส่งตำรวจ','ชี้แจงกรณีสนามยิงปืน นรด. เกี่ยวข้องกับคดีกราดยิงสยามพารากอน','3 ต.ค. 66','661006 ทบ. ตรวจสอบข้อมูลสนามยิงปืน นรด..docx',NULL,'ปกติ',NULL,'0ed506632b8f2812','3-Content/PR-2023-0002.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0003','2023-10-06','ทบ. จับมือกระทรวงการคลัง ขับเคลื่อนนโยบายรัฐบาล ร่วมหารือบริหารจัดการที่ดินเพื่อให้ประชาชนเข้าใช้ประโยชน์',3,'ปกติ','รอง ผบ.ทบ. ให้การต้อนรับ รมช.คลัง หารือเรื่องที่ราชพัสดุในความครอบครอง ทบ. กำหนดพื้นที่นำร่อง อ.หนองวัวซอ จ.อุดรธานี 10,000 ไร่เศษ ให้แล้วเสร็จ ธ.ค. 66','หารือร่วมกับกระทรวงการคลังเรื่องที่ราชพัสดุ','5 ต.ค. 66','661006 ทบ. หารือร่วมกับกระทรวงการคลัง.docx',NULL,'ต้องตรวจ','จังหวัดอุดรธานีไม่อยู่ใน Config ปัจจุบัน','1f82f7c894e2fc1a','3-Content/PR-2023-0003.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0004','2023-10-07','ผบ.ทบ. ลงพื้นที่ จชต. ตลอด 2 วัน เดินสายพบปะให้กำลังใจเจ้าหน้าที่ ย้ำสิ่งที่ทำอยู่คือความภาคภูมิใจ',3,'ปกติ','ผบ.ทบ. พร้อมคณะตรวจเยี่ยมหน่วยทหารใน จชต. 2 วัน (6-7 ต.ค. 66) พบปะกำลังพลใน 3 จังหวัด (ปัตตานี ยะลา นราธิวาส) เน้นบูรณาการ สิทธิมนุษยชน และการสื่อสารภายในหน่วย','ตรวจเยี่ยมหน่วยทหารในพื้นที่จังหวัดชายแดนภาคใต้','6-7 ตุลาคม 2566','661007 ผบ.ทบ. เยี่ยม จชต.docx',NULL,'ต้องตรวจ','จังหวัดปัตตานี, ยะลา, นราธิวาส ไม่อยู่ใน Config ปัจจุบัน','5f4c0a38a9756c72','3-Content/PR-2023-0004.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0005','2023-10-08','ทบ. เตรียมจัดกิจกรรมเฉลิมพระเกียรติ ทำความดีน้อมรำลึกในหลวงรัชกาลที่ 9 เนื่องใน "วันนวมินทรมหาราช" 13 ต.ค. 2566',8,'ปกติ','ทบ. ร่วมกับส่วนราชการและภาคประชาชนทั่วประเทศเตรียมจัดกิจกรรมน้อมรำลึก ร.9 ตลอดเดือนตุลาคม 66 ได้แก่ รด.จิตอาสา นิทรรศการ บริจาคโลหิต สวดมนต์ และช่วยเหลือประชาชน','เตรียมจัดกิจกรรมเฉลิมพระเกียรติ วันนวมินทรมหาราช','13 ตุลาคม 2566','661008 ทบ. เตรียมจัดกิจกรรม น้อมรำลึก ร. ๙.docx',NULL,'ปกติ',NULL,'7ba7e50314f4f372','3-Content/PR-2023-0005.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0006','2023-10-09','หน่วยทหารกองทัพบกจัดกิจกรรม "วันนวมินทรมหาราช" พร้อมกันทั่วประเทศ รวมพลังทำความดี สืบสานพระราชปณิธานในหลวงรัชกาลที่ 9',8,'ปกติ','ผบ.ทบ. ดำริให้หน่วยทหารทั่วประเทศจัดกิจกรรมน้อมรำลึก ร.9 เนื่องในวันนวมินทรมหาราช 13 ต.ค. 66 (ครบ 7 ปีสวรรคต) รวมถึง รด.จิตอาสา 3 แสนนายจัดกิจกรรมพร้อมกันทั่วประเทศ','จัดกิจกรรมน้อมรำลึกวันนวมินทรมหาราช ทั่วประเทศ','13 ตุลาคม 2566','661009 ทบ. รวมพลัง วันนวมินฯ (แถลงสื่อที่ นรด).docx',NULL,'ปกติ',NULL,'145de45cc790e5de','3-Content/PR-2023-0006.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0007','2023-10-09','ทบ. เดินหน้าตรวจสอบกรณีน้ำมันเชื้อเพลิง คงมาตรการตรวจสอบในองค์กรอย่างเข้มงวด',5,'เร่งด่วน','ผบ.ทบ. สั่งพักราชการชั่วคราว เจ้ากรมสรรพาวุธ ทบ. และกำลังพลที่เกี่ยวข้องอีก 4 นาย จากกรณีพบความผิดปกติในการเบิกจ่ายน้ำมันเชื้อเพลิง หน่วยทหารพื้นที่ จ.สระบุรี','สั่งพักราชการชั่วคราว เจ้ากรมสรรพาวุธ ทบ. จากกรณีน้ำมันเชื้อเพลิงผิดปกติ',NULL,'661009 ทบ. แจ้งผลการสอบกรณีน้ำมันเชื้อเพลิง.docx',NULL,'ปกติ',NULL,'e551d374dec216bd','3-Content/PR-2023-0007.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2023-0008','2023-10-12','ทบ. ต้อนรับ รมว.กห. อย่างสมเกียรติและอบอุ่น พร้อมปฏิบัติตามนโยบาย พัฒนากองทัพให้ทันสมัย สอดรับภัยคุกคามรูปแบบใหม่',3,'ปกติ','ผบ.ทบ. นำ รมว.กห. นายสุทิน คลังแสง ตรวจเยี่ยม บก.ทบ. จัดรถม้าเกียรติยศต้อนรับ เยี่ยมพิพิธภัณฑ์ รับฟังนโยบายพัฒนากองทัพให้ทันสมัย','ต้อนรับ รมว.กห. ตรวจเยี่ยม บก.ทบ. อย่างเป็นทางการ',NULL,'661012 ผบ.ทบ.จัดผบ.หน่วยทั่วประเทศต้อนรับรมว.กห.docx',NULL,'ปกติ',NULL,'cf8a5a84e83258fb','3-Content/PR-2023-0008.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
