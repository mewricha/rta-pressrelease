INSERT INTO "press_releases_fts" VALUES('PR-2023-0035','ผบ.ทบ. ประชุม นขต.ทบ. ครั้งที่ 2/2567 มอบรางวัล และเตรียมงานเฉลิมพระเกียรติ ร.10 ครบ 6 รอบ','ผบ.ทบ. ประชุม นขต.ทบ. 2/2567 มอบรางวัล และเตรียมงานเฉลิมพระเกียรติ ร.10 ครบ 6 รอบ','ทบ. เตรียมจัดกิจกรรมเฉลิมพระเกียรติฯ ร.๑๐ ครบ ๖ รอบ ๗๒ พรรษา พร้อม
คุมเข้มชายแดนสกัดกั้นสิ่งผิดกฎหมายทุกรูปแบบ
วันนี้ (๒๘ พ.ย. ๖๖) เวลา ๐๙.๐๐ น. ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก เป็นประธานประชุมชี้แจงและสั่งการต่อหน่วยขึ้นตรงกองทัพบก ครั้งที่ ๒/๒๕๖๗ โดยวาระก่อนการประชุม มีพิธีมอบใบประกาศชมเชยให้กำลังพลที่ช่วยเหลือประชาชน, พิธีมอบค่าของขวัญให้แก่บุตรกำลังพลเนื่องในวันขึ้นปีใหม่, พิธีมอบทุนการศึกษาให้แก่บุตรข้าราชการและลูกจ้างประจำในสังกัดกองทัพบก, พิธีมอบใบประกาศชมเชยให้กับหน่วยที่ได้รับรางวัลเลิศรัฐ และพิธีมอบเกียรติบัตรให้กับกำลังพลที่มีผลการศึกษาดีเด่นจากการฝึกหลักสูตร Stryker Leader ณ สหรัฐอเมริกา ซึ่งโอกาสนี้ผู้บัญชาการทหารบกได้กล่าวขอบคุณและชื่นชมกำลังพลทุกนาย ที่ถือเป็นตัวแทนขององค์กรในการช่วยเหลือสังคม ทำความดี
เพื่อส่วนรวม และที่ได้ไปศึกษาต่อในต่างประเทศ แสดงศักยภาพของคนไทยในการฝึกทางทหารร่วมกับมิตรประเทศ
การประชุมในวันนี้ ผู้บัญชาการทหารบกได้กล่าวถึงการเตรียมพร้อมการจัดงานเฉลิมพระเกียรติพระบาทสมเด็จพระเจ้าอยู่หัว เนื่องในโอกาสมหามงคลเฉลิมพระชนมพรรษา ๖ รอบ ๗๒ พรรษา ๒๘ ก.ค. ๖๗ 
ซึ่งกองทัพบกขานรับนโยบายรัฐบาล จัดตั้งคณะกรรมการดำเนินงาน โดยให้หน่วยทหารทั่วประเทศร่วมกับส่วนราชการในพื้นที่ จัดกิจกรรมเฉลิมพระเกียรติโดยพร้อมเพรียงกัน เพื่อแสดงถึงความจงรักภักดีและสำนึกใน
พระมหากรุณาธิคุณของในหลวงรัชกาลที่ ๑๐ ที่ทรงมีต่อพสกนิกรไทย รวมถึงการเตรียมจัดกิจกรรมน้อมรำลึกพระมหากรุณาธิคุณ ของพระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร เนื่องในวันคล้ายวันพระราชสมภพ ๕ ธันวาคม ๒๕๖๖ ที่จะถึงนี้ด้วย
ในส่วนของศูนย์ปฏิบัติการกองทัพบก ได้รายงานผลการปฏิบัติของกองกำลังป้องกันชายแดนในภารกิจการสกัดกั้นสิ่งผิดกฎหมายตามแนวชายแดนทุกรูปแบบ โดยเฉพาะเรื่องยาเสพติดที่รัฐบาลได้ให้ความสำคัญเป็นวาระแห่งชาติ มีผลการจับกุมในเดือนตุลาคมที่ผ่านมาสามารถตรวจยึดยาบ้าได้ ๒,๖๒๘,๙๓๒ เม็ด,ไอซ์ ๒.๖๕ กิโลกรัม, เฮโรอีน ๐.๐๗ กิโลกรัม และฝิ่น ๖.๔๓ กิโลกรัม ซึ่งส่วนใหญ่ยังพบการลักลอบลำเลียงข้ามผ่านชายแดนทางทิศเหนือและตะวันออกเฉียงเหนือ ในส่วนการจับกุมผู้ลักลอบเข้าเมืองโดยผิดกฎหมาย ตรวจพบการกระทำผิด จำนวน ๑๙๔ ครั้ง จับกุมผู้กระทำความผิดได้จำนวน ๙๔๓ คน การสกัดกั้นและปราบปรามการลักลอบนำเข้าสินค้าเกษตรและสิ่งผิดกฎหมาย ตรวจพบ
การกระทำผิด จำนวน ๒๕ ครั้ง จับกุมผู้กระทำความผิดได้จำนวน ๓๗ คน ยึดของกลางได้หลายรายการ 
เช่น น้ำมันดีเซลเลี่ยงภาษี, น้ำมันปาล์ม และ ยางพารา  โดยผู้บัญชาการทหารบกได้กำชับกำลังพล
ที่ปฏิบัติงานในพื้นที่ชายแดน ให้บูรณาการร่วมทั้งฝ่ายปกครองและภาคประชาสังคมในพื้นที่ ตลอดจนสร้างสัมพันธ์ที่ดีกับทหารและประชาชนของประเทศเพื่อนบ้าน โดยผลจากการดำรงความสัมพันธ์ตลอดระยะเวลาที่ผ่านมา ทำให้เกิดการร่วมมือในการช่วยเหลือคนไทยในเมืองเล้าก์ก่ายประเทศเมียนมากลับสู่ประเทศไทยโดยปลอดภัย
	สำหรับการดูแลและพัฒนากำลังพล ทุกระดับซึ่งเป็นส่วนสำคัญในการขับเคลื่อนภารกิจกองทัพบก ผู้บัญชาการทหารบกได้มอบหมายให้ผู้บังคับบัญชาทุกหน่วยกำกับดูแลใส่ใจ พิจารณาสิทธิและสวัสดิการ ตลอดจนการฝึกต่างๆ ให้ได้รับอย่างเหมาะสม โดยเฉพาะทหารกองประจำการ และนักศึกษาวิชาทหาร ให้ปรับรูปแบบการฝึกให้สอดคล้องกับปัจจุบัน จัดการเรียนการสอนแบบ Active Learning และให้สังคมสามารถเข้าถึงและรับทราบการจัดกิจกรรมต่างๆ ได้ เพื่อเสริมสร้างบุคลากร กำลังสำรองของกองทัพอย่างมีคุณค่า 
มีความรู้ความสามารถและมีทัศนคติที่ดีในการปฏิบัติภารกิจต่างๆ เพื่อองค์กรและประเทศชาติต่อไป 
………………………………….................
