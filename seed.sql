INSERT INTO "press_release_content" VALUES('PR-2023-0049','ทบ. ประชุมผู้บังคับกองพันทั่วประเทศ เดินหน้าพัฒนากำลังพลทุกระดับผ่านการฝึก กำชับทุกหน่วยเฝ้าระวังเหตุ พร้อมดูแลประชาชนตลอดห้วงปีใหม่
วันนี้ (๒๒ ธ.ค.๖๖) เวลา ๑๐.๐๐ น. ที่กองบัญชาการกองทัพบก พลเอก เจริญชัย หินเธาว์ 
ผู้บัญชาการทหารบก ประธานการประชุมผู้บังคับหน่วยขึ้นตรงกองทัพบก ครั้งที่ ๓/๒๕๖๗ (วาระพิเศษ) 
โดยก่อนเริ่มการประชุม ผู้บัญชาการทหารบกได้มอบประกาศชมเชยให้กำลังพลที่ช่วยเหลือประชาชน และโล่ห์รางวัลให้กับหน่วยทหารที่มีผลการฝึกหมู่ตอนหมวดกองทัพบก ประจำปี ๒๕๖๖ ในระดับดีมาก พร้อมกันนี้ได้กล่าวชื่นชมและขอบคุณกำลังพลที่ได้รับรางวัล ขอให้ตระหนักในจิตวิญญาณทางทหารที่มีความเสียสละและ
อุทิศตนในการดูแลช่วยเหลือเพื่อนมนุษย์ และดำรงอุดมการณ์เพื่อชาติ ศาสน์ กษัตริย์และประชาชน 
การประชุมครั้งนี้เป็นเดือนสุดท้ายของปี ๒๕๖๖ ผู้บัญชาการทหารบกได้กล่าวขอบคุณ
การปฏิบัติงานของทุกหน่วยในรอบปีที่ผ่านมาจนเกิดผลสำเร็จ โดยขอให้คงความต่อเนื่องการปฏิบัติต่างๆ ทั้งการฝึกศึกษา, การพัฒนากำลังพล, การช่วยเหลือประชาชนและสนับสนุนนโยบายรัฐบาลในทุกๆด้าน ทั้งนี้
ผู้บัญชาการทหารบกได้เน้นย้ำทุกหน่วยให้ความสำคัญกับการพัฒนากำลังพลทุกระดับผ่านการฝึก ตั้งแต่การฝึกระดับหมู่ตอนหมวดกองทัพบก ที่ถือเป็นการฝึกพื้นฐานที่สำคัญของหน่วย เพื่อเสริมสร้างกำลังพลให้มีความรู้ความสามารถ มีระเบียบวินัยและทักษะพื้นฐานทางทหาร พร้อมปฏิบัติภารกิจต่างๆ ตลอดจนให้ความสำคัญกับการฝึกนักศึกษาวิชาทหารซึ่งเป็นกำลังสำรองของกองทัพ โดยเน้นย้ำหน่วยบัญชาการรักษาดินแดนปรับหลักสูตรการฝึกให้สามารถนำไปประยุกต์ใช้ได้ในสถานการณ์จริง รวมทั้งสนับสนุนกิจกรรมสาธารณประโยชน์
ในโอกาสต่างๆ เพื่อสร้างเยาวชนให้เป็นผู้มีทัศนคติที่ดี เป็นบุคลากรที่มีคุณค่าและมีจิตสาธารณะเพื่อส่วนรวม 
สำหรับการฝึกทหารใหม่ ซึ่งขณะนี้ผลัด ๒/๒๕๖๖ อยู่ระหว่างการฝึกเฉพาะหน้าที่ 
ผู้บัญชาการทหารบกกล่าวขอบคุณผู้บังคับหน่วยทุกระดับ ทั้งกรมยุทธศึกษาทหารบก กรมแพทย์ทหารบก และหน่วยฝึกทั่วประเทศ ที่มีการกำกับดูแลใส่ใจอย่างใกล้ชิด พร้อมประสานติดต่อกับญาติอย่างสม่ำเสมอ เพื่อสร้างความเข้าใจและลดผลกระทบต่างๆ ที่เกิดขึ้นได้เป็นอย่างดี รวมทั้งได้กำชับให้ดำรงการดูแลและการฝึกตามมาตรการที่กองทัพบกกำหนด ซึ่งจากนี้จะมีการเปิดหน่วยฝึกต้อนรับญาติทหารใหม่ ขอให้ใช้โอกาสนี้ในการต้อนรับครอบครัวทหารใหม่ แสดงให้เห็นบรรยากาศหน่วยทหาร และสร้างความเข้าใจที่ดีต่อหน่วยฝึกทหารใหม่ที่ได้มีการปรับตามสภาพปัจจุบัน 
สุดท้ายนี้ ผู้บัญชาการทหารบกได้เน้นย้ำการปฏิบัติของกำลังพลในช่วงเทศกาลปีใหม่ ๒๕๖๗ ที่ใกล้จะถึงนี้ เนื่องจากเป็นช่วงวันหยุดยาว ประชาชนมีการเดินทางและท่องเที่ยวในหลายพื้นที่ ซึ่งอาจพบการลักลอบกระทำความผิดของกลุ่มผู้ก่อเหตุต่างๆ โดยขอให้ผู้บังคับหน่วยกำชับกำลังพล ปฏิบัติงานอย่างเคร่งครัด บูรณาการกับส่วนที่เกี่ยวข้องทั้งพื้นที่ตอนในและชายแดน ตั้งจุดบริการประชาชน และลาดตระเวนเฝ้าระวังเหตุไม่พึงประสงค์ เพื่อป้องปรามรักษาความสงบเรียบร้อย ดูแลอำนวยความสะดวกให้ประชาชน
ขณะเดียวกันให้รักษาสิทธิของกำลังพลที่ปฏิบัติงานในช่วงวันหยุดตามความเหมาะสม เนื่องจากเป็นผู้ที่มี
ความเสียสละในเวลาส่วนตนและเวลาของครอบครัว เพื่อสร้างขวัญกำลังใจ และขอบคุณที่ปฏิบัติภารกิจ
