INSERT INTO "press_releases_fts" VALUES('PR-2023-0040','ผบ.ทบ. ประสาน 17 จังหวัดภาคเหนือ เตรียมรับมือไฟป่าและหมอกควัน PM2.5','ผบ.ทบ. ประสานหน่วยทหาร 17 จังหวัดภาคเหนือ เตรียมรับมือไฟป่าและหมอกควัน PM2.5 ฤดูแล้งปี 2567','	ทบ. พร้อมระดมทรัพยากร ลดฝุ่นละออง ไฟป่าและหมอกควัน ร่วมสร้างมลภาวะทางอากาศที่ดีให้ประชาชน
      	จากสถานการณ์ฝุ่นละอองขนาดเล็ก PM 2.5 ในขณะนี้ที่มีปริมาณเพิ่มสูงขึ้น และเริ่มส่งผลกระทบต่อสุขภาพประชาชน โดยเฉพาะในพื้นที่กรุงเทพมหานคร ปริมณฑล และ ๑๗ จังหวัดภาคเหนือ เนื่องจากสภาพอากาศที่เข้าสู่ฤดูหนาวและกำลังพัฒนาสู่ปรากฎการณ์เอลนีโญ จนส่งผลให้เกิดความแห้งแล้ง และปริมาณฝุ่นละอองเกินค่ามาตรฐานในหลายพื้นที่ พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก/คณะกรรมการจัดการปัญหามลพิษทางอากาศเพื่อความยั่งยืนของรัฐบาล ได้มีความห่วงใยในสถานการณ์ดังกล่าว พร้อมขานรับนโยบายรัฐบาลในมาตรการแก้ไขปัญหาฝุ่นพิษ PM 2.5 ปี ๒๕๖๗ เพื่อป้องกันและแก้ไขปัญหาไฟป่า หมอกควันและฝุ่นละออง โดยได้มอบหมายให้หน่วยทหารประสานร่วมกับกรมป้องกันและบรรเทาสาธารณภัย, กรมควบคุมมลพิษ และกระทรวงสาธารณสุข ตลอดจนภาคเอกชนและประชาชน ติดตามปริมาณค่าฝุ่นละอองขนาดเล็ก PM 2.5 ในแต่ละวัน, ป้องกันและลดเหตุของปัญหานอกจากเรื่องของสภาพอากาศ เช่น ไฟป่า, การเผา, หมอกควันข้ามแดน, การจราจร, การขนส่งและโรงงานอุตสาหกรรม ตลอดจนเตรียมการรับมือ ลดปริมาณฝุ่นควันที่จะเกิดขึ้น
	ซึ่งตลอดระยะเวลาที่ผ่านมา กองทัพบกได้มีการดำเนินการช่วยเหลือประชาชน ลดผลกระทบที่เกิดขึ้นจากไฟป่า หมอกควันและฝุ่นละอองในพื้นที่ต่างๆ อย่างต่อเนื่อง ตั้งแต่การประชาสัมพันธ์สร้างการรับรู้ในการดูแลป้องกันตนเอง ลดการเผาและควบคุมงานด้านการก่อสร้าง, การแจกจ่ายหน้ากากอนามัย, การฉีดพ่นล้างทำความสะอาดพื้นที่สาธารณะ, การนำอากาศยานทางทหารพร้อมถุงบรรจุน้ำในภารกิจดับไฟป่า ตลอดจนการตรวจสอบและปรนนิบัติบำรุงยานพาหนะของหน่วย เพื่อลดมลภาวะที่เกิดจากเครื่องยนต์ 
	ล่าสุดผู้บัญชาการทหารบกได้สั่งการให้หน่วยทหารกองทัพบก ที่มีภารกิจควบคู่ไปกับการดำเนินงานของกองอำนวยการรักษาความมั่นคงภายในแต่ละจังหวัด ผ่านรองผู้อำนวยการรักษาความมั่นคงภายในจังหวัด (ฝ่ายทหาร) โดยเฉพาะ ๑๗ จังหวัดภาคเหนือ ใช้ศักยภาพในบทบาทดังกล่าว บูรณาการร่วมกับทุกภาคส่วนในการแก้ไขปัญหา ซึ่งปัจจุบันถือเป็นการเตรียมการและรับมือในระยะเริ่มต้น โดยกองทัพบกพร้อมสนับสนุนทรัพยากรของหน่วย ทั้งกำลังพล สิ่งอุปกรณ์และยานพาหนะอย่างเต็มขีดความสามารถ อาทิ การจัดกำลังพลสนับสนุนการปฎิบัติงานต่างๆ ให้กับศูนย์อำนวยการป้องกันและแก้ไขปัญหาไฟป่าหมอกควันภาค ๓ , การจัดชุดปฏิบัติการขับเคลื่อนการมีส่วนร่วมในการป้องกันและแก้ไขปัญหา, การเตรียมอากาศยานกองทัพบกสำหรับปฏิบัติภารกิจในทันทีที่เกิดเหตุ ตลอดจนการประชุมติดตามสถานการณ์และถอดบทเรียนจากการปฎิบัติในแต่ละครั้งเพื่อเตรียมแผนการดำเนินงานต่อไป ทั้งนี้เพื่อเฝ้าระวัง ป้องกัน ควบคุมและลดการเกิดไฟป่า หมอกควัน และฝุ่นละออง รวมทั้งเพื่อให้ประชาชนได้มีสุขภาวะที่ดี อันจะนำไปสู่การดำเนินชีวิตภายใต้สภาพอากาศที่ปลอดภัย ปราศจากมลพิษอย่างยั่งยืน
............................................................................
