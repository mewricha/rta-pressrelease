INSERT INTO "press_releases_fts_content" VALUES(48,'PR-2023-0045','ผบ.ทบ. ตรวจเยี่ยมโครงการหลวงเลอตอ จ.ตาก และศูนย์ดับไฟป่า ภาค 3 เชียงใหม่','ผบ.ทบ. ลงพื้นที่เยี่ยมโครงการหลวงเลอตอ จ.ตาก และตรวจศูนย์ดับไฟป่า กองทัพภาคที่ 3 เชียงใหม่','ผบ.ทบ. ตรวจเยี่ยมชายแดนในพื้นที่ ภาคเหนือ พร้อมสนับสนุนทุกภาคส่วน แก้ไขปัญหาไฟป่า หมอกควัน
	วันนี้ (๑๕ ธ.ค. ๖๖) พลเอกเจริญชัย หินเธาว์ ผู้บัญชาการทหารบก และคณะ ได้เดินทางไปตรวจเยี่ยมการปฏิบัติงานของหน่วยในพื้นที่ชายแดนกองทัพภาคที่ ๓ ณ ศูนย์พัฒนาโครงการหลวง              เลอตอ อ.แม่ระมาด จ.ตาก และศูนย์ปฏิบัติการดับไฟป่าภาค ๓ อ.แม่ริม จ.เชียงใหม่ โดยมี พลโท ประสาน แสงศิริรักษ์  แม่ทัพภาคที่ ๓ และ พลตรี ณรงค์ฤทธิ ปาณิกบุตร ผู้บัญชาการกองกำลังนเรศวร ให้การต้อนรับ 
	โดยผู้บัญชาการทหารบก ได้เยี่ยมชมและติดตามการปฏิบัติงานของหน่วยทหารในพื้นที่  ศูนย์พัฒนาโครงการหลวงเลอตอ ซึ่งมีลักษณะพื้นที่เป็นภูเขาสูงสลับซับซ้อน ก่อตั้งขึ้นในปลายรัชสมัยของในหลวงรัชกาลที่ ๙  และถือเป็นโครงการหลวงลำดับแรกในพระบาทสมเด็จพระเจ้าอยู่หัว รัชกาลที่ ๑๐               ที่ทรงมีพระราชปณิธานในการสืบสานแนวพระราชดำริของในหลวงรัชกาลที่ ๙ เพื่อพัฒนาคุณภาพชีวิตความเป็นอยู่ของชาวไทยภูเขา ลดการปลูกฝิ่น และฟื้นฟูผืนป่าต้นน้ำ ปัจจุบันโครงการนี้ได้สร้างรายได้และพัฒนาคุณภาพชีวิตให้กับชาวบ้านในพื้นที่อย่างต่อเนื่อง  โดยมีหน่วยเฉพาะกิจกรมทหารพรานที่ ๓๕ กองกำลังนเรศวร เป็นหนึ่งในหลายหน่วยงานที่ให้การสนับสนุนโครงการนี้
	จากนั้น ผู้บัญชาการทหารบกและคณะ ได้เดินทางไปตรวจเยี่ยมการปฏิบัติงานของศูนย์ปฏิบัติการดับไฟป่าภาค ๓ จ.เชียงใหม่ รับฟังการบรรยายสรุปการป้องกันและแก้ไขปัญหาไฟป่าหมอกควัน ในพื้นที่ ๑๗ จังหวัดในภาคเหนือ ซึ่งสถานการณ์ที่ผ่านมามีจำนวนวันที่ฝุ่นละอองขนาดเล็กเกินเกณฑ์มาตรฐานจำนวน ๑๓๔ วัน ค่าฝุ่นละอองขนาดเล็ก PM ๒.๕ สูงสุดที่ ๕๔๔ ไมโครกรัมต่อลูกบาศก์เมตร พบจุดความร้อน เพิ่มขึ้นจากปี ๒๕๖๕ คิดเป็นร้อยละ ๗๘.๐๗ และพื้นที่เผาไหม้ เพิ่มขึ้นจาก ปี ๒๕๖๕ คิดเป็นร้อยละ ๖๗.๔๒ และสถานการณ์ไฟป่าและหมอกควันในประเทศเพื่อนบ้าน พบจุดความร้อนเพิ่มขึ้นจากปี ๒๕๖๕ คิดเป็นร้อยละ ๕๐.๗๖ ทั้งนี้ศูนย์ปฏิบัติการดับไฟป่าภาค ๓ ยังได้ประเมินสถานการณ์ในปีนี้ มีแนวโน้มที่จะมีความรุนแรงมากขึ้น ซึ่งศูนย์ปฏิบัติการดับไฟป่าภาค ๓ ได้เฝ้าระวังสถานการณ์อย่างต่อเนื่อง พร้อมร่วมกับทุกส่วนราชการที่เกี่ยวข้องในการจัดทำแผนดับไฟป่าครอบคลุมทั้ง ๑๗ จังหวัด และเตรียมอากาศยาน ทบ. ให้ความพร้อมในการปฏิบัติการดับไฟป่า รวมถึงได้บูรณาการ
การใช้อากาศยาน ร่วมกับหน่วยงานต่างๆ อาทิ กองทัพอากาศ กระทรวงทรัพยากรณ์ธรรมชาติและสิ่งแวดล้อม กรมป้องกันและบรรเทาสาธารณภัย และกรมฝนหลวงและการบินเกษตร เพื่อให้สามารถควบคุมสถานการณ์ไฟป่าได้อย่างทั่วถึง 
	ทั้งนี้ผู้บัญชาการทหารบกได้กล่าวขอบคุณกำลังพล และส่วนราชการทุกหน่วยในการเฝ้าระวังและเตรียมความพร้อม กำชับให้ทุกส่วนเตรียมความพร้อมของกำลังพล รวมทั้งยุทโธปกรณ์อย่างเต็มขีดความสามารถ เพื่อให้การแก้ปัญหาไฟป่า หมอกควัน เป็นไปอย่างมีประสิทธิภาพตามนโยบายของรัฐบาล
