INSERT INTO "press_release_content" VALUES('PR-2024-0016','ทบ. ชื่นชมกำลังพลรุดช่วยประชาชนป่วยฉุกเฉิน บนรถเมล์สาย ๑๖๘ นำส่ง 
รพ.ราชวิถี โดยปลอดภัย 
      		ตามที่มีการเผยแพร่ภาพข่าวบนสื่อสังคมออนไลน์ Facebook fanpage : JS100 Radio กล่าวถึงเหตุการณ์ “การช่วยเหลือผู้ป่วยภูมิแพ้ตัวเองและเกิดอาการชักบนรถเมล์สาย ๑๖๘ ระหว่างเดินทางไป รพ.ราชวิถี วานนี้ (๒๔ ม.ค.๖๗) โดยมีคนขับและกระเป๋ารถเมล์ พร้อมพลเมืองดีและทหาร  ๒ นายช่วยเหลืออุ้มผู้ป่วยนำส่งยังตึกฉุกเฉิน โรงพยาบาลราชวิถีได้อย่างปลอดภัย #คนดีของเรา” จนเป็นเหตุให้ในเวลาต่อมามีการประกาศตามหาทหารพลเมืองดีที่ปรากฏในคลิป จนพบตัวบุคคลดังกล่าว ประกอบด้วย ร.ต.ปรีชา สมบัติวงศ์, ส.ท.ภาณุพงษ์ นึกกระโทก และพลทหารอาสา วิทยา ชัยสมบูรณ์ สังกัดกรมดุริยางค์ทหารบก โดย ส.ท.ภาณุพงศ์ (ผู้อุ้มผู้ป่วย) ได้ให้สัมภาษณ์ผ่านสถานีวิทยุ จส.๑๐๐ ว่า “ขณะเกิดเหตุเป็นช่วงที่ตนอยู่ระหว่างเดินทางไปยังกรมดุริยางค์ทหารบก และได้ยินเสียงมีคนตะโกนขอความช่วยเหลือ จึงรีบเข้าไปในทันที พยายามไปให้ถึงโรงพยาบาลราชวิถีให้เร็วที่สุด”
     		กองทัพบกขอขอบคุณสถานีวิทยุ จส.๑๐๐ และประชาชนทุกคน ที่มีการรายงานเหตุการณ์และภาพข่าวต่างๆ ที่เกิดขึ้นในรอบวัน ให้ได้รับทราบ ระมัดระวัง และเห็นถึงการแสดงออกด้วยความห่วงใยและมีน้ำใจของเพื่อนมนุษย์ ที่พร้อมดูแลให้การช่วยเหลือซึ่งกันและกันเมื่อเผชิญปัญหาต่างๆ ดังเช่นภาพข่าวที่ปรากฏขึ้น ซึ่งนอกจากกำลังพลของกองทัพบก แล้วยังมีเจ้าหน้าที่ประจำรถเมล์และประชาชนที่เดินทางบนรถเมล์และสัญจรผ่านไปมาในการร่วมให้การช่วยเหลือ จากเหตุการณ์ดังกล่าว กองทัพบกขอชื่นชมกำลังพลและพลเมืองดีทุกท่านที่ได้รุดไปช่วยในทันทีที่ทราบเหตุ เพื่อนำส่งผู้ป่วยให้เข้าถึงการรักษาจากทีมแพทย์อย่างรวดเร็ว อันจะช่วยลดสาเหตุจากภาวะแทรกซ้อนหรือการบาดเจ็บอื่นๆ ที่อาจเกิดขึ้นได้ สอดคล้องกับนโยบายของ พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ที่ให้ความสำคัญกับภารกิจการช่วยเหลือประชาชนควบคู่ไปกับภารกิจทางทหาร โดยมอบนโยบายให้กำลังพลทุกนายได้ฝึกอบรมทักษะการช่วยชีวิตขั้นพื้นฐานอย่างสม่ำเสมอ หรือการดำเนินการด้านอื่นๆ ที่จะสามารถบรรเทาความเดือดร้อนให้ประชาชนในเบื้องต้นได้ ซึ่งกรณีนี้นับเป็นตัวอย่างให้กำลังพลได้ตระหนักว่าการทำความดีเพื่อสังคมนั้น สามารถทำได้ทุกที่ทุกเวลา 
……………………………………………….  
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๒๕ มกราคม ๒๕๖๗',2006,'2026-06-30 01:27:32');
INSERT INTO "press_release_content" VALUES('PR-2024-0017','โรงเรียนนายร้อยพระจุลจอมเกล้า เปิดสอบเข้าเป็นนักเรียนเตรียมทหาร 
ในส่วนของกองทัพบก ตั้งแต่วันนี้ถึง ๑ มี.ค. ๖๗
      		กองทัพบก โดยโรงเรียนนายร้อยพระจุลจอมเกล้า เปิดรับสมัครบุคคลเพื่อสอบคัดเลือกเข้าเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบก ประจำปีการศึกษา ๒๕๖๗ ตั้งแต่วันที่ ๒๒ มกราคม - ๑ มีนาคม ๒๕๖๗ โดยเปิดโอกาสให้ชายไทย ช่วงอายุ ๑๖ - ๑๘ ปี ที่สำเร็จการศึกษาชั้นมัธยมศึกษาปีที่ ๔ และมีความสนใจ 
รักในอาชีพทหาร สามารถสมัครสอบเข้ามาเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบก ผ่านทางเว็บไซต์ https://crma-admission.rta.mi.th/admission/event 
    		สำหรับนักเรียนเตรียมทหารในส่วนของกองทัพบก เมื่อผ่านการสอบคัดเลือกแล้วจะได้เข้ารับการศึกษาในระดับชั้นมัธยมศึกษาตอนปลายควบคู่ไปกับการฝึกทางทหารที่โรงเรียนเตรียมทหาร สถาบันวิชาการป้องกันประเทศ เป็นระยะเวลา ๒ ปี และศึกษาต่อยังโรงเรียนนายร้อยพระจุลจอมเกล้าในระดับปริญญาตรี เป็นระยะเวลา ๕ ชั้นปี และบรรจุเป็นนายทหารสัญญาบัตรของกองทัพบก รับพระราชทานยศว่าที่ร้อยตรี ปฏิบัติงานในหน่วยทหาร
ทั่วประเทศ โดยระหว่าง เข้ารับการศึกษา นักเรียนเตรียมทหารจะได้รับสิทธิและสวัสดิการต่างๆ ในฐานะนักเรียนทหาร อาทิ การรักษาพยาบาลในโรงพยาบาลสังกัดกองทัพบก, การเข้ารับฝึกทางทหาร ตามหลักสูตร รวมทั้งโอกาสในการศึกษาต่อ ณ โรงเรียนนายร้อยต่างประเทศ เพื่อเสริมสร้างนายทหารหลักของกองทัพบกให้เป็นผู้นำทางทหารที่เข้มแข็งทั้งร่างกายและจิตใจ มีระเบียบวินัย พร้อมปฏิบัติภารกิจเพื่อชาติ ศาสน์ กษัตริย์และประชาชน 
   		ทั้งนี้ ผู้สนใจสามารถสอบถามรายละเอียดเพิ่มเติมได้ที่กองสถิติและทะเบียนประวัติ โรงเรียนนายร้อยพระจุลจอมเกล้า โทรศัพท์ ๐๖๓-๗๕๖-๓๐๔๔, ๐๓๗-๓๙๓-๐๑๐ ต่อ ๖๒๑๓๔ ในวันและเวลาราชการ หรือ Line Official : https://lin.ee/58E2SRJ โดยกองทัพบกพร้อมเปิดโอกาสและต้อนรับนักเรียนชายทุกคนที่มีความสนใจ เพื่อเข้ามาเป็นครอบครัวเดียวกัน และขอเป็นกำลังใจให้ทุกคน สามารถเดินตามความฝัน 
