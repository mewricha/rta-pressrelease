INSERT INTO "press_releases_fts_content" VALUES(77,'PR-2024-0017','โรงเรียนนายร้อยพระจุลจอมเกล้า เปิดรับสมัครสอบ นักเรียนเตรียมทหารส่วนกองทัพบก ปีการศึกษา 2567 ถึง 1 มี.ค.67','จปร. เปิดรับสมัคร นตท. ส่วน ทบ. ชายไทยอายุ 16-18 ปี จบ ม.4 สมัคร 22 ม.ค.-1 มี.ค.67 ผ่านเว็บไซต์ crma-admission.rta.mi.th','โรงเรียนนายร้อยพระจุลจอมเกล้า เปิดสอบเข้าเป็นนักเรียนเตรียมทหาร 
ในส่วนของกองทัพบก ตั้งแต่วันนี้ถึง ๑ มี.ค. ๖๗
      		กองทัพบก โดยโรงเรียนนายร้อยพระจุลจอมเกล้า เปิดรับสมัครบุคคลเพื่อสอบคัดเลือกเข้าเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบก ประจำปีการศึกษา ๒๕๖๗ ตั้งแต่วันที่ ๒๒ มกราคม - ๑ มีนาคม ๒๕๖๗ โดยเปิดโอกาสให้ชายไทย ช่วงอายุ ๑๖ - ๑๘ ปี ที่สำเร็จการศึกษาชั้นมัธยมศึกษาปีที่ ๔ และมีความสนใจ 
รักในอาชีพทหาร สามารถสมัครสอบเข้ามาเป็นนักเรียนเตรียมทหารในส่วนของกองทัพบก ผ่านทางเว็บไซต์ https://crma-admission.rta.mi.th/admission/event 
    		สำหรับนักเรียนเตรียมทหารในส่วนของกองทัพบก เมื่อผ่านการสอบคัดเลือกแล้วจะได้เข้ารับการศึกษาในระดับชั้นมัธยมศึกษาตอนปลายควบคู่ไปกับการฝึกทางทหารที่โรงเรียนเตรียมทหาร สถาบันวิชาการป้องกันประเทศ เป็นระยะเวลา ๒ ปี และศึกษาต่อยังโรงเรียนนายร้อยพระจุลจอมเกล้าในระดับปริญญาตรี เป็นระยะเวลา ๕ ชั้นปี และบรรจุเป็นนายทหารสัญญาบัตรของกองทัพบก รับพระราชทานยศว่าที่ร้อยตรี ปฏิบัติงานในหน่วยทหาร
ทั่วประเทศ โดยระหว่าง เข้ารับการศึกษา นักเรียนเตรียมทหารจะได้รับสิทธิและสวัสดิการต่างๆ ในฐานะนักเรียนทหาร อาทิ การรักษาพยาบาลในโรงพยาบาลสังกัดกองทัพบก, การเข้ารับฝึกทางทหาร ตามหลักสูตร รวมทั้งโอกาสในการศึกษาต่อ ณ โรงเรียนนายร้อยต่างประเทศ เพื่อเสริมสร้างนายทหารหลักของกองทัพบกให้เป็นผู้นำทางทหารที่เข้มแข็งทั้งร่างกายและจิตใจ มีระเบียบวินัย พร้อมปฏิบัติภารกิจเพื่อชาติ ศาสน์ กษัตริย์และประชาชน 
   		ทั้งนี้ ผู้สนใจสามารถสอบถามรายละเอียดเพิ่มเติมได้ที่กองสถิติและทะเบียนประวัติ โรงเรียนนายร้อยพระจุลจอมเกล้า โทรศัพท์ ๐๖๓-๗๕๖-๓๐๔๔, ๐๓๗-๓๙๓-๐๑๐ ต่อ ๖๒๑๓๔ ในวันและเวลาราชการ หรือ Line Official : https://lin.ee/58E2SRJ โดยกองทัพบกพร้อมเปิดโอกาสและต้อนรับนักเรียนชายทุกคนที่มีความสนใจ เพื่อเข้ามาเป็นครอบครัวเดียวกัน และขอเป็นกำลังใจให้ทุกคน สามารถเดินตามความฝัน 
สู่เส้นทางทหารอาชีพได้สำเร็จ
………………………………….........
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๒๕ มกราคม ๒๕๖๗');
INSERT INTO "press_releases_fts_content" VALUES(78,'PR-2024-0018','ผบ.ทบ. ร่วมงานสถาปนา รร.เตรียมทหาร ครบรอบ 66 ปี และรับรางวัลเกียรติยศจักรดาวสาขาบริหารการปกครองฯ','ผบ.ทบ. ร่วมงานสถาปนา รร.เตรียมทหาร ครบรอบ 66 ปี รับรางวัลเกียรติยศจักรดาว สาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ','ผบ.ทบ. ร่วมงานสถาปนาโรงเรียนเตรียมทหาร พร้อมรับรางวัลเกียรติยศจักรดาว เชิดชูศิษย์เก่าดีเด่น สร้างสรรค์ประโยชน์สู่สังคมและประเทศชาติ
วันนี้ (๒๖ ม.ค.๖๗) เวลา ๐๘.๓๐ น. พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก เดินทางไปร่วมพิธีเนื่องในวันคล้ายวันสถาปนาโรงเรียนเตรียมทหาร สถาบันวิชาการป้องกันประเทศ ครบรอบปีที่ ๖๖ และงานเกียรติยศจักรดาว ประจำปี ๒๕๖๗ ที่ จ.นครนายก โดยมี พลเอก บุญสร้าง เนียมประดิษฐ์ ประธานกรรมาธิการการทหารและความมั่นคงของรัฐ วุฒิสภา เป็นประธานในพิธี โดยผู้บัญชาการทหารบกได้วางพานพุ่มสักการะพระบรมราชานุสาวรีย์ รัชกาลที่ ๕ และวางพวงมาลาอนุสรณ์สถาน โรงเรียนเตรียมทหาร สถาบันวิชาการป้องกันประเทศ จากนั้นได้เดินทางไปยังหอประชุมนวนครินทร์ เพื่อร่วมพิธีแสดงมุทิตาจิตแด่อดีตผู้บังคับบัญชาและครูอาจารย์, พิธีมอบรางวัลจักรดาวสดุดี และพิธีมอบรางวัลเกียรติยศจักรดาวแก่ศิษย์เก่าดีเด่นประจำปี ๒๕๖๗ ซึ่งผู้บัญชาการทหารบกได้รับรางวัลในสาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ ก่อนร่วมรับประทานอาหารกลางวัน ณ โรงอาหารนักเรียนเตรียมทหาร ระลึกเหตุการณ์อดีตในบรรยากาศของพี่น้องศิษย์เก่ากลับคืนถิ่น 
สำหรับรางวัลเกียรติยศจักรดาว เป็นรางวัลที่มอบให้กับศิษย์เก่าโรงเรียนเตรียมทหารที่ทำคุณประโยชน์ให้แก่องค์กรและส่วนรวม ในสาขาต่างๆ ประกอบด้วย สาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ, การทหาร, วิทยาศาสตร์เทคโนโลยีและสิ่งแวดล้อม, พัฒนาสังคม, การเมืองและการบริหารรัฐกิจ, การวิจัย และสาขาอื่นๆ ซึ่งในปี ๒๕๖๗ มีผู้ได้รับรางวัลรวม ๑๒ ท่าน ในส่วนของกองทัพบกมี 
๕ ท่าน ได้แก่ พลเอก ยศนันท์ หร่ายเจริญ (เตรียมทหารรุ่นที่ ๑๖) รับรางวัลสาขาพัฒนาสังคม, พลเอก สุรใจ จิตต์แจ้ง (เตรียมทหารรุ่นที่ ๑๙) รับรางวัลสาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ, 
พลเอก สุรพล เจียรณัย (เตรียมทหารรุ่นที่๒๐) รับรางวัลสาขาการทหาร, พลเอก เกรียงไกร ศรีรักษ์ (เตรียมทหาร
รุ่นที่ ๒๒) รับรางวัลสาขาการทหาร และ พลเอก เจริญชัย หินเธาว์ (เตรียมทหารรุ่นที่ ๒๓) รับรางวัลสาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ 
นอกจากนี้ยังมีกำลังพลสังกัดกองทัพบก ๑ นาย ที่ได้รับรางวัลจักรดาวสดุดีประจำปี ๒๕๖๗ ได้แก่ นักเรียนนายร้อย ภูวนัย กำลังดี (เตรียมทหารรุ่นที่ ๖๑) ซึ่งเสียชีวิตในขณะรับราชการ และเป็นผู้ที่มีความประพฤติดี มีมนุษยสัมพันธ์ รวมทั้งใส่ใจในภารกิจที่ได้รับมอบหมาย สร้างความภาคภูมิใจต่อครอบครัวและกองทัพบก โดยมีคุณกุลนาถ กำลังดี มารดา เป็นผู้แทนรับมอบรางวัล เพื่อเป็นการยกย่องเชิดชูเกียรติแก่ศิษย์เก่าเตรียมทหารที่เสียชีวิตจากการปฏิบัติหน้าที่
โอกาสนี้กองทัพบกขอแสดงความยินดี และเชิดชูเกียรติศิษย์เก่าโรงเรียนเตรียมทหารทุกท่าน
ที่ได้รับรางวัล ขอขอบคุณที่ทุ่มเท ปฏิบัติภารกิจเพื่อกองทัพ ซึ่งถือเป็นแบบอย่างให้กำลังพลกองทัพบก
ได้ยึดถือเป็นแนวทางในการทำงาน อันจะสร้างสรรค์ประโยชน์ต่อสังคมและประเทศชาติต่อไป 
