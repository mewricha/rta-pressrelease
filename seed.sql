INSERT INTO "press_releases_fts_content" VALUES(61,'PR-2024-0001','ทบ. ระดมซ่อมบ้านเรือนผู้ประสบอุทกภัยภาคใต้อย่างต่อเนื่อง รับนโยบายนายกรัฐมนตรี','หน่วยทหาร ทภ.4 เร่งซ่อมบ้านเรือนผู้ประสบน้ำท่วมภาคใต้ ยะลา ปัตตานี นราธิวาส ตามนโยบายนายกฯ เศรษฐา','ทบ.ระดมช่วยน้ำท่วมภาคใต้อย่างต่อเนื่อง เร่งซ่อมบ้านหลังน้ำลด รับนโยบายนายกรัฐมนตรี
		จากสถานการณ์อุทกภัยที่เกิดขึ้นในพื้นที่ภาคใต้ โดยเฉพาะ ๓ จังหวัดชายแดนภาคใต้ จนทำให้ประชาชนได้รับความเดือดร้อน เส้นทางสัญจรถูกตัดขาด และบ้านเรือนพังเสียหาย ตั้งแต่ ธ.ค.๖๖ ที่ผ่านมา พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก/ผู้อำนวยการศูนย์บรรเทาสาธารณภัยกองทัพบก ได้มีความห่วงใยประชาชนและมอบหมายให้ศูนย์บรรเทาสาธารณภัยกองทัพภาคที่ ๔ พร้อม กอ.รมน.ภาค ๔ ส่วนหน้า นำศักยภาพหน่วยทหารเข้าช่วยเหลือประชาชนอย่างต่อเนื่อง 
	ล่าสุด ผู้บัญชาการทหารบก รับนโยบายเร่งด่วนจากนายกรัฐมนตรี นายเศรษฐา ทวีสิน ที่สั่งการให้ทหารทุกเหล่าทัพ เข้าซ่อมแซมบ้านเรือนให้กับประชาชนผู้ประสบอุทกภัยในพื้นที่ที่สถานการณ์เริ่มคลี่คลาย ซึ่งขณะนี้หน่วยทหารในพื้นที่กองทัพภาคที่ ๔  โดยศูนย์บรรเทาสาธารณภัย กองพลทหารราบที่ ๑๕ ที่รับผิดชอบพื้นที่จังหวัดต่างๆ ได้แก่ กรมทหารราบที่ ๑๕๓ จ.ยะลา, กรมทหารราบที่ ๑๕๒ จ.ปัตตานี และ กรมทหารราบที่ ๑๕๑ จ.นราธิวาส รวมทั้งหน่วยเฉพาะกิจทหารพรานในพื้นที่ อยู่ระหว่างร่วมกับส่วนราชการในการเข้าสำรวจความเสียหายและฟื้นฟูหลังน้ำลด ด้วยการทำความสะอาด, ขนย้ายสิ่งของกลับเข้าที่พัก, มอบถุงยังชีพ ตลอดจนซ่อมแซมบ้านเรือนที่ได้รับความเสียหาย เพื่อให้ประชาชนในพื้นที่ได้กลับมาใช้ชีวิตอย่างปกติได้โดยเร็วที่สุด โดยบูรณาการร่วมกับส่วนราชการในพื้นที่ อาทิ หน่วยทหารพัฒนา,                     หน่วยเฉพาะกิจตำรวจตระเวนชายแดน, สำนักงานป้องกันและบรรเทาสาธารณภัยจังหวัด และส่วนท้องถิ่น ทั้งนี้กองทัพบกพร้อมนำกำลังทหารช่างและยุทโธปกรณ์ของหน่วย เข้าทำการสนับสนุน เร่งซ่อมสร้างคลายความเดือดร้อนให้ประชาชนในทันที
	สำหรับประชาชนที่บ้านเรือนได้รับความเสียหายจากอุทกภัย สามารถติดต่อหน่วยทหารใกล้เคียง หรือโทรศัพท์ผ่านศูนย์บรรเทาสาธารณภัย กองทัพภาคที่ ๔ โทรศัพท์ ๐๗๕-๓๘๓๔๐๕, พื้นที่                 ๔ อำเภอของ จ.สงขลา ติดต่อได้ที่ศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๒ โทรศัพท์ ๐๗๔-๖๘๖๖๘๕ และในพื้นที่ ๓ จังหวัดชายแดนภาคใต้ ติดต่อศูนย์บรรเทาสาธารณภัยมณฑลทหารบกที่ ๔๖ โทรศัพท์ ๐๗๓-๓๔๐๑๔๑-๕ ต่อ ๔๓๐๑๑ ได้ตลอด ๒๔ ชั่วโมง
........................................................................
