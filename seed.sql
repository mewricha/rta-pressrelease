INSERT INTO "press_releases" VALUES('PR-2024-0013','2024-01-19','ทบ. ให้ความร่วมมือตำรวจ คดีเด็กปั้มถูกยิง จ.นครพนม ผู้ต้องสงสัยเป็นนายทหารประทวน',5,'ปกติ','ทภ.2 ให้ความร่วมมือตำรวจ คดีเด็กปั้ม 2 รายถูกยิง อ.เมือง นครพนม 29 ธ.ค.66 ผู้ต้องสงสัยเป็นนายทหารประทวน ตั้ง กก.สอบสวนวินัยแล้ว','ให้ความร่วมมือตำรวจ คดียิงเด็กปั้ม นครพนม','19 ม.ค.67 (ข่าว), 29 ธ.ค.66 (เกิดเหตุ)','670119 (เตรียมข่าว) ทภ.2 ให้ความร่วมมือตำรวจ ในกรณีทหารยิงเด็กปั้ม.docx',NULL,'ปกติ','ไฟล์ชื่อ ''เตรียมข่าว''','bc0f8febac4f33c4','3-Content/PR-2024-0013.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0014','2024-01-21','กองทัพบก เชิญชวนสมัครทหารออนไลน์ ปี 2567 ปิดรับ 28 ม.ค.67 คัดเลือก 27-28 ม.ค.67 ใน 89 แห่ง',30,'ปกติ','ทบ. เชิญชวนชายไทยอายุ 18-20 ปี หรือ 22-29 ปี สมัครทหารออนไลน์ ปิด 28 ม.ค.67 ผู้สมัครแล้ว 18,857 คน','เชิญชวนสมัครทหารออนไลน์ ปี 2567','ปิดรับ 28 ม.ค.67','670121 ประชาสัมพันธ์ทหารออนไลน์.docx',NULL,'ปกติ',NULL,'2d4c3ed9f4472993','3-Content/PR-2024-0014.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0015','2024-01-24','ทบ. ชี้แจงเกณฑ์ส่วนสูง 146 ซม. สมัครทหารกองประจำการ เป็นไปตามกฎกระทรวง พ.ศ.2516',5,'ปกติ','ทบ. ชี้แจงเกณฑ์ส่วนสูง 146 ซม. และรอบอก 76 ซม. ตามกฎกระทรวงฉบับที่ 37 (2516) สมัครได้ถึง 28 ม.ค.67','ชี้แจงเกณฑ์ส่วนสูงในการรับสมัครทหาร','24 ม.ค.67','670124 (ร่างข่าว) ชี้แจงกรณีรับสมัครทหารกองประ.docx',NULL,'ปกติ','ไฟล์ชื่อ ''ร่างข่าว'' — เนื้อหาครบ เป็นข่าวชี้แจง','d5858c91ec3e076b','3-Content/PR-2024-0015.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0016','2024-01-25','ทบ. ชื่นชมกำลังพล 3 นาย สังกัดกรมดุริยางค์ ทบ. ช่วยผู้ป่วยบนรถเมล์สาย 168 ส่ง รพ.ราชวิถีปลอดภัย',1,'ปกติ','ทบ. ชื่นชม ร.ต.ปรีชา, ส.ท.ภาณุพงษ์ และพลทหารวิทยา กรมดุริยางค์ ทบ. ช่วยผู้ป่วยชักบนรถเมล์สาย 168 ส่ง รพ.ราชวิถีปลอดภัย','ชื่นชมกำลังพลช่วยผู้ป่วยฉุกเฉินบนรถเมล์','24 ม.ค.67 (วันเกิดเหตุ)','670125  ชมกำลังพลทำดี.docx',NULL,'ปกติ',NULL,'e9b35990bd9d7e53','3-Content/PR-2024-0016.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0017','2024-01-25','โรงเรียนนายร้อยพระจุลจอมเกล้า เปิดรับสมัครสอบ นักเรียนเตรียมทหารส่วนกองทัพบก ปีการศึกษา 2567 ถึง 1 มี.ค.67',30,'ปกติ','จปร. เปิดรับสมัคร นตท. ส่วน ทบ. ชายไทยอายุ 16-18 ปี จบ ม.4 สมัคร 22 ม.ค.-1 มี.ค.67 ผ่านเว็บไซต์ crma-admission.rta.mi.th','เปิดรับสมัครสอบ นตท. ปีการศึกษา 2567','22 ม.ค.-1 มี.ค.67','670125 สมัครสอบ นตท^.docx',NULL,'ปกติ',NULL,'8b8b740c48be7476','3-Content/PR-2024-0017.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0018','2024-01-26','ผบ.ทบ. ร่วมงานสถาปนา รร.เตรียมทหาร ครบรอบ 66 ปี และรับรางวัลเกียรติยศจักรดาวสาขาบริหารการปกครองฯ',3,'ปกติ','ผบ.ทบ. ร่วมงานสถาปนา รร.เตรียมทหาร ครบรอบ 66 ปี รับรางวัลเกียรติยศจักรดาว สาขาบริหารการปกครองและเสริมสร้างความมั่นคงแห่งชาติ','ร่วมงานสถาปนา รร.เตรียมทหาร ครบรอบ 66 ปี รับรางวัลเกียรติยศจักรดาว','26 ม.ค.67','670126  ผบ.ทบ. เกียรติยศจักรดาว.docx',NULL,'ปกติ',NULL,'a263c54e4374b229','3-Content/PR-2024-0018.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0019','2024-01-29','ผบ.ทบ. มอบรางวัลกำลังพลช่วยประชาชน ประชุม นขต.ทบ. 4/2567 และเชิญร่วมงาน ''มหัศจรรย์วันมวยไทย''',3,'ปกติ','ผบ.ทบ. มอบใบประกาศชมเชย 25 นาย และเงินค่านมบุตรทหารใหม่ 125 นาย ก่อนประชุม นขต.ทบ. 4/2567 รับรายงานยาเสพติด ไฟป่า ยางพาราเถื่อน','ประชุม นขต.ทบ. ครั้งที่ 4/2567','29 ม.ค.67','670129  ประชุม นขต.docx',NULL,'ปกติ',NULL,'1df7f13db100b0cc','3-Content/PR-2024-0019.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0020','2024-01-30','สรุปผลรับสมัครทหารออนไลน์ ปี 2567 ผ่านการคัดเลือก 14,185 คน เพิ่มขึ้น 57% จากปีก่อน',30,'ปกติ','ทบ. สรุปผลทหารออนไลน์ปี 2567 เปิดรับ 27,721 สมัคร 20,065 ผ่านคัดเลือก 14,185 คน เพิ่ม 57% จากปี 2566','สรุปผลรับสมัครทหารออนไลน์ ปี 2567','30 ม.ค.67','670130  สรุปยอดการรับสมัครทหารออนไลน์ในส่วนของกองทัพบก ปี ๒๕๖๗.docx',NULL,'ปกติ',NULL,'69b5fe5bbea0b8e3','3-Content/PR-2024-0020.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
INSERT INTO "press_releases" VALUES('PR-2024-0021','2024-01-31','ผบ.ทบ. ตรวจเยี่ยมการฝึกภาคสนาม นศท. 1,200 นาย เขาชนไก่ กาญจนบุรี และ กกล.สุรสีห์',3,'ปกติ','ผบ.ทบ. ลงพื้นที่ตรวจเยี่ยมฝึกภาคสนาม นศท. 1,200 นาย ที่เขาชนไก่ จ.กาญจนบุรี และตรวจ กกล.สุรสีห์ ชายแดนตะวันตก','ตรวจเยี่ยมฝึกภาคสนาม นศท. เขาชนไก่','31 ม.ค.67','670131 ผบ.ทบ. เยี่ยม นศท. ฝึกภาคสนามเขาชนไก่.docx',NULL,'ปกติ',NULL,'ccbac6e872899528','3-Content/PR-2024-0021.txt','2026-06-30 01:27:32','2026-06-30 01:27:32');
