INSERT INTO "press_releases_fts_content" VALUES(58,'PR-2023-0055','ผบ.ทบ. ส่งสารอวยพรปีใหม่ 2567 แก่กำลังพลและครอบครัวทหาร','ผบ.ทบ. ส่งสารอวยพรปีใหม่ 2567 ชื่นชมกำลังพลที่ทุ่มเทปฏิบัติภารกิจตลอดปี','ผบ.ทบ.ส่งความปรารถนาดี ผ่านสารอวยพรปีใหม่ระบุกองทัพบก ยึดมั่นอุดมการณ์ ปฏิบัติหน้าที่เพื่อส่วนรวมและประเทศชาติ พร้อมพัฒนาให้ก้าวทันต่อความเปลี่ยนแปลง
	เนื่องในโอกาสขึ้นปีใหม่ ๒๕๖๗ พลเอก เจริญชัย  หินเธาว์ ผู้บัญชาการทหารบก ส่งความปรารถนาดี ความระลึกถึง และความห่วงใยไปยังกำลังพลกองทัพบก ผ่านสารอวยพรปีใหม่ โดยมีใจความตอนหนึ่งว่า ตลอดระยะเวลา ๑ ปีที่ผ่านมา กองทัพบกดำเนินภารกิจภายใต้สภาวะแวดล้อมด้านความมั่นคงที่เปลี่ยนแปลงอย่างต่อเนื่อง โดยมีกำลังพลทุกท่านเป็นกำลังสำคัญที่ได้ร่วมใจกันปฏิบัติหน้าที่ สนับสนุนรัฐบาลในการพัฒนาประเทศและแก้ไขปัญหาสำคัญที่ส่งผลกระทบต่อความมั่นคงของรัฐ การบูรณาการความร่วมมือในการช่วยเหลือบรรเทาสาธารณภัยและเป็นที่พึ่งของประชาชนในทุกโอกาส ตลอดจนสนับสนุนการดำเนินโครงการในพระราชดำริและโครงการจิตอาสาพระราชทาน ที่ส่งเสริมการทำความดีและมีจิตสาธารณะเพื่อประโยชน์ส่วนรวมและประเทศชาติ ผมขอชื่นชมและขอบคุณทุกท่านเป็นอย่างยิ่งพร้อมกันนี้ยังได้ย้ำถึงอุดมการณ์และวิสัยทัศน์ของกองทัพบกที่มุ่งปฏิบัติภารกิจเพื่อส่วนรวมและประเทศชาติ โดยเสริมสร้างศักยภาพในทุกด้านให้สอดคล้องกับยุคสมัยที่เปลี่ยนแปลงไป ควบคู่กับการพัฒนากำลังพลในทุกระดับให้มีความรู้ความสามารถ มีอุดมการณ์ความรักชาติ จงรักภักดีต่อสถาบันพระมหากษัตริย์ และมีจิตวิญญาณของความเป็นทหารอาชีพ 
	ขอเป็นกำลังใจให้ทุกท่านปฏิบัติหน้าที่อย่างเต็มความสามารถ สามัคคีเป็นน้ำหนึ่งใจเดียวกันเพื่อให้เกิดผลสัมฤทธิ์อย่างเป็นรูปธรรม โดยคำนึงถึงความปลอดภัยในการปฏิบัติหน้าที่เป็นสำคัญ ศึกษาและพัฒนาความรู้เพิ่มเติมอย่างต่อเนื่องในทุกมิติ เพื่อก้าวทันต่อความเปลี่ยนแปลง พร้อมกับดำรงตนอยู่ในระเบียบวินัย มีความรับผิดชอบ ซื่อสัตย์สุจริต และเป็นแบบอย่างที่ดีให้กับสังคม สำหรับผู้บังคับบัญชาทุกระดับ ต้องปกครองดูแลผู้ใต้บังคับบัญชาด้วยความเป็นธรรม ใกล้ชิด และทั่วถึงเพื่อเป็นขวัญกำลังใจต่อการปฏิบัติหน้าที่เพื่อประโยชน์ของชาติ ศาสน์ กษัตริย์ และประชาชน ตลอดจนเป็นพลังที่เข้มแข็งให้กองทัพบกเจริญมั่นคงต่อไป 
