INSERT INTO "press_release_content" VALUES('PR-2023-0048','ทบ. เปิดทุกช่องทางในการแจ้งเบาะแส และรับเรื่องร้องเรียน พร้อมช่วยเหลือกำลังพลและประชาชนอย่างเป็นธรรม 
	พันเอก ริชฌา สุขสุวานนท์ รองโฆษกกองทัพบก ได้เปิดเผยว่า ปัจจุบันผู้บังคับบัญชา
ทุกระดับชั้นของกองทัพบก ได้มีความห่วงใยและให้ความสำคัญในการรับฟังปัญหาข้อคิดเห็นของกำลังพล โดยเฉพาะในกรณีที่ได้รับการร้องทุกข์ และร้องเรียนผ่านช่องทางต่างๆ ที่กองทัพบกได้ดำเนินการ
มาอย่างต่อเนื่อง ได้แก่ การติดต่อด้วยตนเอง หรือส่งเอกสารทางไปรษณีย์มาที่ สำนักงานเลขานุการกองทัพบก กองบัญชาการกองทัพบก โทรศัพท์ ๐๒-๒๙๗-๗๘๓๖ ,๐๒-๒๙๗-๘๓๐๗, หรือผ่านทาง Application : Smart Soldier บนโทรศัพท์สมาร์ทโฟน และ ร้องเรียนทางเว็บไซต์ ศูนย์ประสานราชการใสสะอาดกองทัพบก 
	โดยช่องทางดังกล่าวสามารถใช้บริการได้ทั้งข้าราชการ พนักงานราชการ ลูกจ้างประจำ รวมถึงทหารกองประจำการ และประชาชนทั่วไป โดยหลังจากกองทัพบกได้รับแจ้งข้อมูลแล้ว 
จะตรวจสอบข้อเท็จจริงและรายงานให้ผู้ร้องเรียนหรือร้องทุกข์ได้รับทราบเบื้องต้นภายใน ๑๕ วัน ทั้งนี้ หากพบว่ามีการกระทำผิดจริง กองทัพบกพร้อมดำเนินการลงทัณฑ์ตาม พ.ร.บ. ว่าด้วยวินัยทหาร 
