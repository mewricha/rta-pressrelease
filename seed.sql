INSERT INTO "press_releases_fts_content" VALUES(33,'PR-2023-0030','กำลังพล ทบ. 105 นาย จบภารกิจฝึก JPMRC 24-01 ที่ฮาวาย สหรัฐอเมริกา กลับประเทศแล้ว','กำลังพล ทบ. 105 นาย จบภารกิจฝึก JPMRC 24-01 ที่ฮาวาย เดินทางกลับ 15 พ.ย.66','ฝึกผสมไทย/สหรัฐฯ JPMRC 24-01 ณ รัฐฮาวาย สำเร็จลุล่วง กำลังพลทั้ง ๑๐๕ นาย 
กลับถึงไทย พร้อมนำความรู้และประสบการณ์พัฒนากองทัพ
	กองทัพบกให้ความสำคัญและดำรงนโยบายด้านการฝึกร่วม/ผสมกับกองทัพมิตรประเทศ
อย่างต่อเนื่อง ล่าสุดกำลังพลกองทัพบก จำนวน ๑๐๕ นาย ที่เดินทางไปเข้าร่วมการฝึกผสม
รหัส JPMRC 24-01 (Joint Pacific Multinational Readiness Center Rotation 24-01) ) ร่วมกับกำลังพลจากกองพลทหารราบที่ ๒๕ กองกำลังทางบกสหรัฐฯ ภาคพื้นแปซิฟิก ณ ค่าย Schofield 
รัฐฮาวาย สหรัฐอเมริกา เมื่อ ๒๗ ตุลาคม ๒๕๖๖ ได้เข้ารับการฝึกจนเสร็จสิ้นและเดินทาง
กลับถึงราชอาณาจักรไทยแล้ว เมื่อ ๑๕ พฤศจิกายน ๒๕๖๖
	ทั้งนี้กองทัพบกไทยได้จัดกำลังพลจากกองร้อยทหารราบเข้าร่วมฝึกและประเมินผล 
JPMRC ตั้งแต่ พ.ศ.๒๕๖๒ สำหรับในปีนี้กองทัพบกมอบให้ กองทัพภาคที่ ๒ โดยกองพันทหารราบที่ ๓ กรมทหารราบที่ ๖ เป็นหน่วยหลักในการจัดกำลังพลเข้าร่วมการฝึก พร้อมด้วยกำลังพลจากกองทัพ
ภาคที่ ๑, กองทัพภาคที่ ๓, กองทัพภาคที่ ๔ โรงเรียนนายร้อยพระจุลจอมเกล้า,โรงเรียนนายสิบทหารบก ซึ่งการฝึกประกอบด้วยการฝึกการปฏิบัติการร่วม (Interoperability) และการปฏิบัติผสมนานาชาติ (Multinational Integration) โดยปฏิบัติเป็นส่วนหนึ่งของกองพลน้อยชุดรบ (Infantry Brigade Combat Team : IBCT)  ซึ่งการฝึกในครั้งนี้กองทัพบกไทยทำการฝึกภาคสนาม (FTX) ร่วมกับกองทัพบกสหรัฐฯ และกองทัพบกสหราชอาณาจักร ได้แลกเปลี่ยนเรียนรู้หลักนิยมและรูปแบบ
การปฏิบัติทางยุทธวิธีของแต่ละประเทศ รวมถึงเรียนรู้ระบบการจัดการฝึกในรูปแบบเสมือนจริง
และการใช้เครื่องช่วยฝึกที่ทันสมัย อีกทั้งยังได้เปิดโอกาสให้นายทหารหญิงของกองทัพบกไทยที่สำเร็จหลักสูตรส่งทางอากาศจำนวน ๒ นาย ได้เข้าร่วมการฝึกในหน่วยดำเนินกลยุทธ์ในต่างประเทศ
เป็นครั้งแรก ตามมาตรฐานเดียวกับทหารชายทุกประการ
	การฝึกครั้งนี้นอกจากกำลังพลของกองทัพบกจะได้ความรู้และทักษะในการปฏิบัติการทางทหารต่างๆ แล้ว ยังเป็นการสานสัมพันธ์อันดีกับกองทัพมิตรประเทศ ซึ่งเป็นหนึ่งในนโนบายสำคัญของ 
พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก ที่ได้ดำเนินการมาอย่างต่อเนื่อง โดยใน ๑๖ - ๒๕ พฤศจิกายน ๒๕๖๖ นี้กองทัพบกไทยได้รับเกียรติเป็นเจ้าภาพจัดการทดสอบยิงปืนทางยุทธวิธีกองทัพบก
	กลุ่มประเทศอาเซียนครั้งที่ ๓๑ (31st ASEAN Armies Rifle Meet (31st AARM) อีกทั้งใน ๒๒ - ๒๕ พฤศจิกายน ๒๕๖๖ กองทัพบกไทยได้รับเกียรติเป็นเจ้าภาพจัดการประชุมผู้บัญชาการทหารบก
กลุ่มประเทศอาเซียน ครั้งที่ ๒๔ (24th ASEAN Chiefs of Army Multilateral Meeting : ACAMM) และการประชุมแลกเปลี่ยนประสบการณ์นายทหารประทวนอาวุโส ทบ.กลุ่มประเทศอาเซียน ครั้งที่ ๑๑  (11th ASEAN Army Sergeant Majors Annual Meeting ASMAM) อันจะเป็นความร่วมมือของมิตรประเทศในกลุ่มอาเซียน ที่ร่วมกันพัฒนาภูมิภาคในหลากหลายมิติต่อไป
..........................................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๑๙ พฤศจิกายน ๒๕๖๖');
INSERT INTO "press_releases_fts_content" VALUES(34,'PR-2023-0031','ผบ.ทบ. ประชุม นขต.ทบ. รับรายงานยาเสพติด น้ำท่วม และเตรียมเจ้าภาพ AARM/ACAMM/ASMAM ที่ประจวบ','ผบ.ทบ. ประชุม นขต.ทบ. รับรายงานสถานการณ์ยาเสพติด น้ำท่วม และเตรียมงาน AARM/ACAMM/ASMAM ที่ประจวบฯ','ทบ. พัฒนาความร่วมมือทางทหารในอาเซียน พร้อมจัดงาน AARM, ACAMM และ ASMAM  ๑๖ - ๒๕ พ.ย. นี้ 
วันนี้ (๒๐ พ.ย.๖๖) เวลา ๐๘.๓๐ น. พลเอก เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก 
เป็นประธานการประชุมสรุปสถานการณ์ประจำวันร่วมกับหน่วยขึ้นตรงกองทัพบก โดยที่ประชุมได้รายงานผลการปฏิบัติที่สำคัญในรอบสัปดาห์ที่ผ่านมา ได้แก่ การจับกุมยาเสพติด ได้ยาบ้า ๑,๐๑๑,๖๘๒ เม็ด 
ไอซ์ ๑,๐๔๔ กรัม เฮโรอีน ๓๑.๕ กรัม และเคตามีน ๐.๕๑ กรัม, การยึดของกลางน้ำมันดีเซลเลี่ยงภาษี ๓,๙๕๐ ลิตร น้ำมันปาล์มเลี่ยงภาษี ๒,๙๐๐ กิโลกรัม และยางพาราแผ่นเลี่ยงภาษี ๓,๐๐๐ กิโลกรัม รวมทั้งการจับกุมผู้ลักลอบเข้าเมืองโดยผิดกฎหมาย ๓๕๗ คน พร้อมผู้นำพา ๑๖ คน โดยแนวโน้มพบยอดการจับกุมเพิ่มสูงขึ้นจากห้วงสัปดาห์ก่อน และการร่วมกับหน่วยงานรัฐช่วยเหลือประชาชนจากอุทกภัยใน ๖ จังหวัดภาคใต้ ได้แก่ จ.นครศรีธรรมราช, สงขลา, ระนอง, ชุมพร, สุราษฎร์ธานี และ จ.พัทลุง รวมทั้งการดูแลผู้ประสบภัยหนาวในพื้นที่ภาคเหนือและภาคตะวันออกเฉียงเหนือ พร้อมรายงานผลการปฏิบัติงานในพื้นที่จังหวัดชายแดนภาคใต้โดยกองอำนวยการรักษาความมั่นคงภายในภาค ๔ ส่วนหน้า
สำหรับการประชุมในวันนี้ ผู้บัญชาการทหารบกได้ขอบคุณทุกหน่วยที่ปฏิบัติภารกิจมาอย่างต่อเนื่อง สร้างประโยชน์ให้กับประชาชนและสังคมอย่างเป็นรูปธรรม ขอให้ทุกหน่วยโดยเฉพาะกองกำลังป้องกันชายแดนดำเนินการอย่างเข้มงวด ภายใต้กรอบกฎหมายที่กำหนด โอกาสนี้ผู้บัญชาการทหารบก
ได้กล่าวถึงการจัดการทดสอบยิงปืนทางยุทธวิธีกองทัพบก กลุ่มประเทศอาเซียน (ASEAN Armies Rifle Meet ; AARM) ครั้งที่ ๓๑, การประชุมผู้บัญชาการทหารบก กลุ่มประเทศอาเซียน (ASEAN Chief of Armies Multi Lateral Meeting ; ACAMM) ครั้งที่ ๒๔ และการประชุมจ่าอาวุโสกองทัพบกกลุ่มประเทศอาเซียน (ASEAN Army Sergeant Majors Annual Meeting ; ASMAM) ครั้งที่ ๑๑ ที่กองทัพบกไทย
ได้กลับมาเป็นเจ้าภาพในรอบ ๘ ปี และจัดขึ้นในห้วง ๑๖ - ๒๕ พ.ย.๖๖ ที่ จ.ประจวบคีรีขันธ์ โดยผู้บัญชาการทหารบก เน้นย้ำให้ทุกหน่วยร่วมเป็นเจ้าภาพที่ดี ให้การต้อนรับและสร้างความประทับใจให้กับ
มิตรประเทศในการเดินทางมาเยือนในครั้งนี้ และใช้โอกาสนี้ในการพัฒนาความร่วมมือทางทหารในภูมิภาคอาเซียนที่มีมาอย่างต่อเนื่อง ซึ่งผลจากความสัมพันธ์ทางทหารที่ดีต่อกันในห้วงระยะเวลาที่ผ่านมา สามารถสนับสนุนให้เกิดการทำงานร่วมกันเพื่อดูแลประชาชนของทุกประเทศในภูมิภาคอาเซียน ดังเช่นที่กองทัพบกไทยได้ประสานร่วมกับคณะกรรมการชายแดนส่วนท้องถิ่นไทย - เมียนมา (TBC) ในการนำ ๔๑ คนไทยจากเล้าก์ก่ายเดินทางกลับประเทศผ่านช่องทางด่านท่าขี้เหล็ก จ.เชียงราย เมื่อ ๑๘ พ.ย.๖๖ ที่ผ่านมา
	ขณะเดียวกันผู้บัญชาการทหารบกได้มีความห่วงใยประชาชน ในเรื่องภัยหนาว และอุทกภัยในพื้นที่ภาคใต้ ขอให้ทุกหน่วยได้ติดตามสถานการณ์และร่วมกับส่วนต่างๆ ลงพื้นที่ช่วยเหลือในทันที โดย
ไม่ต้องรอคำสั่งการ เพื่อให้ประชาชนได้รับการช่วยเหลือ บรรเทาความเดือดร้อนโดยเร็วที่สุด 
………………………………….................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๒๐ พฤศจิกายน ๒๕๖๖');
INSERT INTO "press_releases_fts_content" VALUES(35,'PR-2023-0032','กองทัพบก เตรียมรับคนไทย 24 คน จากเล่าก์กาย เมียนมา ผ่านด่าน จ.เชียงราย','ทบ. เตรียมรับคนไทย 24 คน ที่ถูกหลอกไปทำงานในเมียนมา (เล่าก์กาย) ผ่านด่านชายแดน จ.เชียงราย','ทบ.ช่วยคนไทยในเมียนมากลับประเทศเพิ่มอีก ๒๔ คน ผ่านกลไกความร่วมมือทางทหาร
	จากสถานการณ์ความขัดแย้งในประเทศเมียนมาที่ส่งผลกระทบต่อความปลอดภัยของ
คนไทยที่เดินทางไปทำงานในพื้นที่ในเมืองเล้าก์ก่ายและเมืองหนานเติ้งนั้น กระทรวงกลาโหม, กระทรวงการต่างประเทศ, เอกอัครราชทูตไทย ณ กรุงย่างกุ้ง, กองทัพบก มูลนิธิเอ็มมานูเอล (IMF Thailand) 
ได้ดำเนินการประสานงานเพื่อให้ความช่วยเหลือคนไทยผ่านกลไกของคณะกรรมการชายแดนส่วนท้องถิ่น (TBC) ไทย-เมียนมา และได้ช่วยเหลือจัดยานพาหนะพร้อมเจ้าหน้าที่จากกองทัพภาคที่ ๓ รับคนไทยชุดแรก จำนวน ๔๑ คน กลับถึงประเทศไทยเมื่อ ๑๘ พฤศจิกายน ที่ผ่านมาอย่างปลอดภัย
	ต่อมากองทัพบก โดยกองพลทหารม้าที่ ๑ กองกำลังผาเมือง ซึ่งเป็นหน่วยรับผิดชอบพื้นที่ชายแดนด้านอำเภอแม่สาย จังหวัดเชียงราย ได้ดำเนินการประสานงานผ่านคณะกรรมการชายแดน
ส่วนท้องถิ่นไทย-เมียนมา (TBC) อย่างต่อเนื่อง โดยได้เข้าพบปะพัฒนาสัมพันธ์กับผู้บังคับกองบังคับ
การยุทธศาสตร์ท่าขี้เหล็กเพื่อขอบคุณกรณีที่ฝ่ายเมียนมาให้ความช่วยเหลือคนไทยชุดแรกจำนวน ๔๑ คน พร้อมทั้งได้หารือเพื่อเตรียมช่วยเหลือคนไทยที่ยังติดค้างอยู่ในเมียนมาเพิ่มเติมอีก ๒๔ คน โดยเมื่อ 
๒๒ พฤศจิกายน ๒๕๖๖ TBC ฝ่ายเมียนมาแจ้งข้อมูลว่าได้อำนวยความสะดวกกลุ่มคนไทยทั้ง ๒๔ คน 
ในการเดินทางจากเมืองปางซางไปยังเมืองเชียงตุง เพื่อรับคำสั่งอนุมัติให้ส่งตัวกลับประเทศไทย แล้วจึงเดินทางต่อไปยังจังหวัดท่าขี้เหล็กเพื่อเข้าสู่ประเทศไทยต่อไป
	ล่าสุด วันนี้ (๒๔ พฤศจิกายน ๒๕๖๖)  เวลา ๑๑.๓๐ น. กองทัพบก โดยกองทัพภาคที่ ๓ / ศูนย์ปฏิบัติการกองทัพภาคที่ ๓ ร่วมกับสถานีตำรวจภูธรแม่สาย ตรวจคนเข้าเมืองจังหวัดเชียงราย นายอำเภอแม่สาย และส่วนราชการที่เกี่ยวข้อง ดำเนินการรับตัวคนไทย จำนวน ๒๔ คน เดินทางกลับประเทศไทยแล้ว บริเวณจุดผ่านแดนถาวรสะพานมิตรภาพข้ามแม่น้ำสายแห่งที่ ๒ อำเภอแม่สาย จังหวัดเชียงราย โดยกองทัพบกได้จัดเจ้าหน้าที่พร้อมยานพาหนะรับกลุ่มคนไทยเพื่อเดินทางต่อไปรับการตรวจสุขภาพ และส่งต่อให้กับสำนักงานพัฒนาสังคมและความมั่นคงของมนุษย์ จ.เชียงราย เพื่อดำเนินการ
ในส่วนที่เกี่ยวข้องต่อไป ทั้งนี้กระทรวงกลาโหมโดยกองทัพบก, กระทรวงการต่างประเทศ และทุกภาคส่วนจะยังคงติดตามและประเมินสถานการณ์เพื่อบูรณาการช่วยเหลือคนไทยในทุกมิติ 
..........................................................................
ศูนย์ประชาสัมพันธ์กองทัพบก โดยทีมโฆษกกองทัพบก, ๒๔ พฤศจิกายน ๒๕๖๖');
INSERT INTO "press_releases_fts_content" VALUES(36,'PR-2023-0033','ผบ.ทบ. ลงพื้นที่ จ.ประจวบคีรีขันธ์ ตรวจจุดตรวจห้วยยาง และด่านสิงขร หลังเป็นเจ้าภาพ AARM','ผบ.ทบ. ลงพื้นที่ประจวบฯ ตรวจด่านห้วยยาง-สิงขร ภายหลังเสร็จสิ้นภารกิจเป็นเจ้าภาพ AARM','ผบ.ทบ. เยี่ยมหน่วยทหาร จ.ประจวบคีรีขันธ์ ลงพื้นที่ให้กำลังใจทั้งด่านตรวจ และชายแดน หลังเสร็จภารกิจปิด AARM 2023
	ช่วงบ่ายวานนี้ (๒๔ พ.ย. ๖๖) หลังจากที่ พล.อ. เจริญชัย หินเธาว์ ผู้บัญชาการทหารบก 
เป็นประธานในพิธีปิดการทดสอบยิงปืนทางยุทธวิธีกองทัพบกกลุ่มประเทศอาเซียน ครั้งที่ ๓๑ (AARM 2023) ณ ศูนย์การทหารราบ จ.ประจวบคีรีขันธ์ ได้เดินทางลงพื้นที่ตรวจเยี่ยมให้กำลังใจหน่วยทหารใน                          จ.ประจวบคีรีขันธ์ และติดตามสถานการณ์ด้านความมั่นคง โดยเฉพาะเรื่อง การสกัดกั้นยาเสพติด, ผู้หลบหนีเข้าเมือง ตลอดจนการลักลอบขนย้ายสิ่งกฎหมายในพื้นที่ชายแดน 
	โดยผู้บัญชาการทหารบกได้ตรวจเยี่ยมจุดตรวจร่วมห้วยยาง อ.ทับสะแก ซึ่งเป็นจุดตรวจสำคัญบนทางหลวงหมายเลข ๔ (เพชรเกษม)  ที่จัดตั้งตั้งแต่ ๑๖ พฤศจิกายน ๒๕๖๔ เพื่อป้องกันและสกัดกั้นสิ่งผิดกฎหมาย โดยมีมาตรการเฝ้าระวังอย่างเป็นระบบร่วมกันทั้งฝ่ายทหาร(กรมทหารราบที่ ๒๙)  เจ้าหน้าที่ตำรวจ และจังหวัดประจวบคีรีขันธ์ และตั้งแต่มีการตั้งจุดตรวจนี้มีผลการปฏิบัติมาอย่างต่อเนื่อง ได้แก่ การจับกุมผู้ต้องหาที่กระทำผิด พรบ.ยาเสพติด ๓๙ ราย ยาบ้ารวม ๔,๙๘๒ เม็ด, ไอช์ ๑๗.๓ กิโลกรัม และ กัญชา ๒๕ กรัม,การกระทำผิด พรบ. คนเข้าเมือง โดยจับกุมผู้ลักลอบเข้าเมืองโดยผิดกฎหมาย ๕๘ คน,การกระทำผิด พรบ.โรคระบาดสัตว์ ๘ ครั้ง จับกุมผู้ต้องหา ๑๐ ราย ได้แก่ ซากสุกร ๑๒,๕๐๐ กก.,ซากไก่ ๑๐,๐๐๐ กก. แพะ ๓๐๐ ตัว และวัว ๓๑๓ ตัว ,การกระทำผิด พรบ. อาวุธปืน เครื่องกระสุน ๕ ครั้ง จับกุมผู้ต้องหา ๕ ราย อาวุธปืน ๕ กระบอก และเครื่องกระสุน ๔๖ นัด 
	จากนั้นผู้บัญชาการทหารบกเดินทางไปตรวจเยี่ยมให้กำลังใจกำลังพลหน่วยเฉพาะกิจจงอางศึก กรมทหารราบที่ ๑๙ ที่มีหน้าที่คัดกรองบุคคล และควบคุมจัดระเบียบการขนถ่ายสินค้า ณ            จุดตรวจสิงขร ซึ่งเป็นจุดผ่อนปรนพิเศษ ตามประกาศกระทรวงมหาดไทย อนุญาตให้สามารถดำเนินการนำเข้า และ ส่งออกสินค้า โดยสินค้านำเข้า ที่มีมูลค่าสูงจากฝั่งเมียนมา คือจำพวกอาหารทะเล และ              ในส่วนสินค้าส่งออกของฝั่งไทยที่มีมูลค่าสูง เป็นสินค้าจำพวกลูกกุ้งมีชีวิต,อาหารสัตว์ และ บรรจุภัณฑ์ ซึ่งรวมมูลค่าการค้าในปี ๒๕๖๖ มากกว่า ๗ ร้อยล้านบาท 
	ทั้งนี้ผู้บัญชาการทหารบกยังได้เดินทางไปยังโรงเรียนด่านสิงขร มอบจักรยานและถุงยังชีพ
เพื่อการศึกษาให้กับเด็กนักเรียนในพื้นที่ห่างไกล และเดินทางต่อไปยังกองร้อยตำรวจตระเวนชายแดนที่ ๑๔๖ เพื่อพบปะให้กำลังใจกำลังพลที่ปฏิบัติหน้าที่ในฐานปฏิบัติการ สำหรับการตรวจเยี่ยมในครั้งนี้                      ผู้บัญชาการทหารบกได้นำความห่วงใยของนายกรัฐมนตรี และ รมว.กลาโหม มาให้กำลังใจกับผู้ปฏิบัติหน้าที่ทุกคน ให้ช่วยดูแลประชาชนและป้องปรามการกระทำผิดกฎหมายทุกประเภทในพื้นที่ชายแดน โดยเฉพาะการสกัดกั้นยาเสพติด,การหลบหนีเข้าเมืองผิดกฎหมาย และการช่วยกันดูแลพื้นที่ชายแดนตลอดจนประชาชนโดยรอบให้มีความสงบสุข
